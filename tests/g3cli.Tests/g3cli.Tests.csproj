<Project Sdk="Microsoft.NET.Sdk">

  <!-- integration tests of the CLI and the MCP server (tools/g3cli), in process and as a child process -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\g3cli\g3cli.csproj" />
  </ItemGroup>

  <!-- the MCP request parser as a fuzz target, replayed on the seeds and their systematic mutations (tools/ReaderFuzzPilot) -->
  <ItemGroup>
    <Compile Include="..\..\tools\ReaderFuzzPilot\FuzzTarget.cs" Link="ReaderFuzz\FuzzTarget.cs" />
    <Compile Include="..\..\tools\ReaderFuzzPilot\ReaderTargetsMcp.cs" Link="ReaderFuzz\ReaderTargetsMcp.cs" />
    <Compile Include="..\..\tools\ReaderFuzzPilot\ReplayMutations.cs" Link="ReaderFuzz\ReplayMutations.cs" />
  </ItemGroup>

</Project>
