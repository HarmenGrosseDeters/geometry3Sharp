<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- net48 runs the tests against the netstandard2.0 build of the library (Windows, or -p:TestNet48=true) -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' Or '$(TestNet48)' == 'true'">net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- ExactPoint3FixedWidthTests reads the limbs of FixedPoint3 through pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <!-- property-based Boolean tests (docs/design/BOOLEAN_PROPERTY_TESTS.md): CsCheck (Apache-2.0) on net10.0 only -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CsCheck" Version="4.9.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="**\*.CsCheck.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <None Include="test_files\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the examples of docs/OPERATIONS.md are compiled into the tests and run by DocExamplesTests -->
  <ItemGroup Condition="'$(UseNuGetG3)' != 'true'">
    <Compile Include="..\..\docs\examples\*.cs" Link="DocExamples\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGetG3)' != 'true'">
    <ProjectReference Include="..\..\geometry3Sharp_netstandard.csproj" />
    <ProjectReference Include="..\..\benchmarks\QuadtreeBenchmark\QuadtreeBenchmark.csproj" />
  </ItemGroup>
  <!-- the acceptance gates of the 2D mesher: the oracle, what it judges, and the stored golden rows -->
  <ItemGroup Condition="'$(UseNuGetG3)' != 'true'">
    <ProjectReference Include="..\..\benchmarks\Meshing2Benchmark\Oracle\Meshing2Oracle.csproj" />
    <Compile Include="..\..\benchmarks\Meshing2Benchmark\Candidates\*.cs" Link="Meshing2\Candidates\%(Filename)%(Extension)" />
    <Compile Include="..\..\benchmarks\Meshing2Benchmark\MeshCommand.cs" Link="Meshing2\Candidates\MeshCommand.cs" />
    <Compile Include="..\..\tools\g3cli\TrianglePolyFormat.cs" Link="Meshing2\Candidates\TrianglePolyFormat.cs" />
    <None Include="..\..\benchmarks\Meshing2Benchmark\golden\*.json" Link="Meshing2\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\design\MESHING2D_GOLDEN_FORMAT.md" Link="Meshing2\MESHING2D_GOLDEN_FORMAT.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\design\MESHING2D_CATALOGUE.md" Link="Meshing2\MESHING2D_CATALOGUE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetG3)' == 'true'">
    <!-- new in this fork: not testable against the old package -->
    <Compile Remove="Meshing2\**" />
  </ItemGroup>
  <!-- the analyzers of the exact code (ExactCodeAnalyzerTests; Roslyn, net10.0 only) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' And '$(UseNuGetG3)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <ProjectReference Include="..\..\tools\analyzers\G3ExactCodeAnalyzers\G3ExactCodeAnalyzers.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0' Or '$(UseNuGetG3)' == 'true'">
    <Compile Remove="ExactCodeAnalyzerTests.cs" />
  </ItemGroup>
  <!-- the predicate compiler (tools/PredicateCompiler): GeneratedPredicatesTests checks its bounds, the kernels against
       them and the design doc's table (.NET only: the compiler uses BigInteger.GetBitLength) -->
  <ItemGroup Condition="'$(UseNuGetG3)' != 'true' And '$(TargetFramework)' == 'net10.0'">
    <Compile Include="..\..\tools\PredicateCompiler\Compiler.cs" Link="PredicateCompiler\Compiler.cs" />
    <None Include="..\..\tools\PredicateCompiler\predicates.spec" Link="PredicateCompiler\predicates.spec" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\design\FIXED_WIDTH_EXACT_POINTS.md" Link="PredicateCompiler\FIXED_WIDTH_EXACT_POINTS.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\PredicateCompiler\indirect.spec" Link="PredicateCompiler\indirect.spec" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\design\INDIRECT_PREDICATES.md" Link="PredicateCompiler\INDIRECT_PREDICATES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\math\Generated\IndirectPredicates.cs" Link="PredicateCompiler\IndirectPredicates.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0' Or '$(UseNuGetG3)' == 'true'">
    <Compile Remove="GeneratedPredicatesTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' And '$(UseNuGetG3)' != 'true'">
    <Compile Include="..\..\benchmarks\TerrainBenchmark\ClosestFields.cs" Link="TerrainMetrics\ClosestFields.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0' Or '$(UseNuGetG3)' == 'true'">
    <Compile Remove="TerrainDistanceMetricTests.cs" />
  </ItemGroup>
  <!-- dotnet test -p:UseNuGetG3=true runs the tests against the old NuGet package (1.0.324) -->
  <ItemGroup Condition="'$(UseNuGetG3)' == 'true'">
    <Compile Remove="Spatial\StrtreeComparisonTests.cs" />
    <Compile Remove="Spatial\NtsQuadtreeComparisonTests.cs" />
    <PackageReference Include="geometry3Sharp" Version="1.0.324" />
  </ItemGroup>

</Project>
