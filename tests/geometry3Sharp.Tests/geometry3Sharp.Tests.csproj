<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- net48 runs the tests against the netstandard2.0 build of the library (Windows, or -p:TestNet48=true) -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' Or '$(TestNet48)' == 'true'">net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <None Include="test_files\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the examples of docs/OPERATIONS.md are compiled into the tests and run by DocExamplesTests -->
  <ItemGroup Condition="'$(UseNuGetG3)' != 'true'">
    <Compile Include="..\..\docs\examples\*.cs" Link="DocExamples\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGetG3)' != 'true'">
    <ProjectReference Include="..\..\geometry3Sharp_netstandard.csproj" />
  </ItemGroup>
  <!-- the acceptance gates of the 2D mesher: the oracle and what it judges -->
  <ItemGroup Condition="'$(UseNuGetG3)' != 'true'">
    <ProjectReference Include="..\..\benchmarks\Meshing2Benchmark\Oracle\Meshing2Oracle.csproj" />
    <Compile Include="..\..\benchmarks\Meshing2Benchmark\Candidates\*.cs" Link="Meshing2\Candidates\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetG3)' == 'true'">
    <!-- new in this fork: not testable against the old package -->
    <Compile Remove="Meshing2\**" />
  </ItemGroup>
  <!-- dotnet test -p:UseNuGetG3=true runs the tests against the old NuGet package (1.0.324) -->
  <ItemGroup Condition="'$(UseNuGetG3)' == 'true'">
    <PackageReference Include="geometry3Sharp" Version="1.0.324" />
  </ItemGroup>

</Project>
