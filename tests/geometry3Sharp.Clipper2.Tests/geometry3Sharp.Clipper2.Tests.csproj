<Project Sdk="Microsoft.NET.Sdk">

  <!-- tests of the optional package addons/geometry3Sharp.Clipper2 -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' Or '$(TestNet48)' == 'true'">net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\addons\geometry3Sharp.Clipper2\geometry3Sharp.Clipper2.csproj" />
    <!-- the transforms of the invariance tests (Similarity.All()) -->
    <Compile Include="..\geometry3Sharp.Tests\Harness\Invariance.cs" Link="Harness\Invariance.cs" />
    <!-- the example of docs/OPERATIONS.md, run by Clipper2ExampleTests -->
    <Compile Include="..\..\docs\examples\Clipper2\*.cs" Link="DocExamples\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
