{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/intersection/TriangleSeparatingAxes.cs"
    ],
    "test-case-filter": "FullyQualifiedName~TriangleSeparatingAxesTests|FullyQualifiedName~RoundingSeparatingAxesTests",
    "ignore-methods": [
      "*PredicateStats.*"
    ],
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 10000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 100,
      "low": 97,
      "break": 95
    },
    "concurrency": 2
  }
}
