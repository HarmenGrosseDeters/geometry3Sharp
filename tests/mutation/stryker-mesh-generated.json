{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/math/Generated/IndirectPredicates.cs"
    ],
    "test-case-filter": "FullyQualifiedName~GeneratedPredicatesIndirectTests",
    "ignore-methods": [
      "*PredicateStats.*"
    ],
    "coverage-analysis": "all",
    "configuration": "Release",
    "additional-timeout": 30000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 97,
      "low": 94,
      "break": 92
    },
    "concurrency": 2
  }
}
