{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/mesh_ops/ExactMeshArrangement.cs{901..1778}"
    ],
    "test-case-filter": "FullyQualifiedName~ExactFilterBoundTests|FullyQualifiedName~ExactArrangementScalingTests|FullyQualifiedName~ExactMeshBooleanTests|FullyQualifiedName~ExactBooleanEdgeOrderTests|FullyQualifiedName~ExactBooleanBuildingBlockTests",
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 30000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 90,
      "low": 60,
      "break": 0
    }
  }
}
