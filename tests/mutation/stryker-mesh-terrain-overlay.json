{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/mesh_ops/TerrainSlopeOverlay.cs"
    ],
    "test-case-filter": "FullyQualifiedName~TerrainSlopeCatchLineTests&FullyQualifiedName!~RandomTerrains",
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 10000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "concurrency": 4,
    "thresholds": {
      "high": 95,
      "low": 92,
      "break": 90
    }
  }
}
