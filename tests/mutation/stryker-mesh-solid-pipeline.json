{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/mesh_ops/SolidBooleanPipeline.cs"
    ],
    "test-case-filter": "FullyQualifiedName~SolidBooleanPipelineTests.|FullyQualifiedName~SolidBooleanPairContactsTests|FullyQualifiedName~SolidBooleanPipelinePropertyTests|FullyQualifiedName~SolidBooleanPipelineInputGridTests|FullyQualifiedName~SolidBooleanPipelineThinSolidTests|FullyQualifiedName~SolidBooleanPipelineThinInputTests|FullyQualifiedName~ExactBooleanOrientationNestingTests.Pipeline_|FullyQualifiedName~SolidBooleanPipelineFinalCheckTests|FullyQualifiedName~SolidBooleanPipelineCavityOwnerTests",
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 10000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 85,
      "low": 77,
      "break": 75
    },
    "concurrency": 2
  }
}
