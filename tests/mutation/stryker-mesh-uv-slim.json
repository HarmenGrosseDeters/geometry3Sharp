{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/parameterization/SLIMParameterization.cs",
      "**/parameterization/ARAPParameterization.cs"
    ],
    "test-case-filter": "FullyQualifiedName~UVAtlasTests.|FullyQualifiedName~ParameterizationTests.|FullyQualifiedName~ParameterizationIssueCasesTests.|FullyQualifiedName~ParameterizationFlippedMapTests.|FullyQualifiedName~FoldoverFreeTests.|FullyQualifiedName~FoldoverFreeToleranceTests.|FullyQualifiedName~SpectralConformalParameterizationTests.",
    "ignore-methods": [
      "*PredicateStats.*"
    ],
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 30000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 90,
      "low": 82,
      "break": 80
    },
    "concurrency": 2
  }
}
