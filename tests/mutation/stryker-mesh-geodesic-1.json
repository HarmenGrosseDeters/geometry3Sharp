{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/mesh_ops/ExactMeshGeodesicDistance.cs{0..20759}"
    ],
    "test-case-filter": "FullyQualifiedName~ExactMeshGeodesicDistanceTests",
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 30000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "concurrency": 4,
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 96
    }
  }
}
