{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/mesh_ops/ExactMeshBoolean.cs{0..41170}"
    ],
    "test-case-filter": "FullyQualifiedName~ExactMeshBooleanTests|FullyQualifiedName~ExactMeshBooleanNaryTests|FullyQualifiedName~ExactBooleanOrientationTests|FullyQualifiedName~ExactBooleanReuseTests|FullyQualifiedName~ExactBooleanEdgeOrderTests|FullyQualifiedName~MeshRoundingRepairTests.ExactVertices",
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 10000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 90,
      "low": 79,
      "break": 77
    },
    "concurrency": 2
  }
}
