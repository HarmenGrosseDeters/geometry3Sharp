{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/intersection/IntrExactBox3.cs"
    ],
    "test-case-filter": "FullyQualifiedName~IntrBox3ExactTests|FullyQualifiedName~IntrBox3PublicApiTests|FullyQualifiedName~IntrBox3FilterEdgeTests",
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 30000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 90,
      "low": 57,
      "break": 55
    },
    "concurrency": 2
  }
}
