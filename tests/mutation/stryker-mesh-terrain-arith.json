{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/math/ExactIntervals.cs",
      "**/math/ExactSlopePredicates.cs",
      "**/mesh_ops/TerrainSlope.cs"
    ],
    "test-case-filter": "FullyQualifiedName~ExactIntervalsTests|FullyQualifiedName~TerrainSlopeOracleTests",
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 30000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "concurrency": 4,
    "thresholds": {
      "high": 95,
      "low": 87,
      "break": 85
    }
  }
}
