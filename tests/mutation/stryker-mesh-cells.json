{
  "stryker-config": {
    "project": "geometry3Sharp_netstandard.csproj",
    "test-projects": [
      "../geometry3Sharp.Tests/geometry3Sharp.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "mutate": [
      "**/mesh_ops/ExactMeshCells.cs"
    ],
    "test-case-filter": "FullyQualifiedName~ExactBooleanSheetTests|FullyQualifiedName~ExactMeshCellsTests|FullyQualifiedName~ExactBooleanRadialOrderTests",
    "ignore-methods": [
      "*PredicateStats.*"
    ],
    "coverage-analysis": "perTest",
    "configuration": "Release",
    "additional-timeout": 10000,
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 85,
      "low": 65,
      "break": 60
    },
    "concurrency": 2
  }
}
