<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[geometry3Sharp]*,[geometry3Sharp.Clipper2]*,[g3cli]*</Include>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <UseSourceLink>false</UseSourceLink>
          <!-- the gate needs one hit per line: SingleHit stops the per-hit counting (an Interlocked increment on every executed line), which made shard 1 of the first coverage.yml run exceed 150 min in hot exact-arithmetic loops -->
          <SingleHit>true</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
