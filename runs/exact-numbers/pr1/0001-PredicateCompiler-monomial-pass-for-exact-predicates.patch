+// Generated by tools/PredicateCompiler from tools/PredicateCompiler/doubles.spec. Do not edit; regenerate with:
+//   dotnet run --project tools/PredicateCompiler -- --dcode tools/PredicateCompiler/doubles.spec math/Generated/DoublePredicates.cs
+// (GeneratedDoublePredicatesTests fails when this file differs from the generator's output.)
+// Distributed under the Boost Software License, Version 1.0. http://www.boost.org/LICENSE_1_0.txt
+using System;
+using System.Runtime.CompilerServices;
+
+namespace g3
+{
+    /// <summary>
+    /// Exact sign predicates on double coordinates of any exponent, generated from their formulas by
+    /// tools/PredicateCompiler (the monomial pass; docs/design/EXACT_FALLBACK_MONOMIALS.md). Every finite double is
+    /// m 2^e with an integer |m| below 2^53. The predicate is a sum of signed monomials, each a product of d
+    /// mantissas (below 2^(53 d): d limbs) times 2^(the sum of its exponents). The positive and the negative monomials
+    /// are added, shifted to their exponent, into two magnitude accumulators on the stack, and the sign is the
+    /// comparison of the two. Integer arithmetic only: no rounding, no overflow or underflow, no allocation, and no
+    /// restriction on the coordinates other than finite (NaN and infinity throw, as in ExactPredicates).
+    /// The limbs of the accumulators are derived per predicate (the comment of each kernel).
+    /// </summary>
+    internal static unsafe class DoublePredicates
+    {
+        // input i of a kernel: its mantissa m[i] (below 2^53), its biased exponent e[i] (v = m 2^(e - 1075); 1 for zero and
+        // subnormal values), its sign in bit i of neg; emin and emax over the nonzero inputs
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        static void load(double v, int i, ulong* m, int* e, ref ulong neg, ref int emin, ref int emax)
+        {
+            long bits = BitConverter.DoubleToInt64Bits(v);
+            int ex = (int)((bits >> 52) & 0x7FF);
+            ulong f = (ulong)bits & 0xFFFFFFFFFFFFFUL;
+            if (ex == 0x7FF)
+                throw new ArgumentException("ExactPredicates: coordinates must be finite");
+            if (ex == 0)
+                ex = 1;
+            else
+                f |= 1UL << 52;
+            m[i] = f;
+            e[i] = ex;
+            if (bits < 0)
+                neg |= 1UL << i;
+            if (f != 0) {
+                if (ex < emin) emin = ex;
+                if (ex > emax) emax = ex;
+            }
+        }
+
+        // the sign of p - q (magnitudes of `limbs` limbs)
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        static int compare(ulong* p, ulong* q, int limbs)
+        {
+            for (int i = limbs - 1; i >= 0; --i)
+                if (p[i] != q[i])
+                    return (p[i] > q[i]) ? 1 : -1;
+            return 0;
+        }
+
+        // one monomial of degree 2: the product of the mantissas (below 2^106: 2 limbs), shifted left by
+        // (the sum of the exponents) - b bits, added to p if its sign is positive and to q if negative (`minus` is the
+        // sign of the monomial in the formula; the mantissas' signs are in neg). A zero factor adds nothing.
+        // (internal for the tests, which check it against BigInteger on accumulators with long carries)
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        internal static void add2(ulong* p, ulong* q, ulong* m, int* e, ulong neg, int b, int i0, int i1, bool minus)
+        {
+            ulong f0 = m[i0], f1 = m[i1];
+            if (f0 == 0 || f1 == 0)
+                return;
+            ulong lo, hi, carry;
+            ulong r0 = f0, r1;
+            hi = FixedArith.MulHigh(r0, f1, out r0);
+            carry = hi;
+            r1 = carry;
+            bool negative = ((((neg >> i0) ^ (neg >> i1)) & 1) != 0) != minus;
+            int off = e[i0] + e[i1] - b;
+            ulong* a = (negative ? q : p) + (off >> 6);
+            int s = off & 63;
+            ulong t0, t1, t2;
+            if (s == 0) {
+                t0 = r0; t1 = r1; t2 = 0;
+            } else {
+                t0 = r0 << s;
+                t1 = (r1 << s) | (r0 >> (64 - s));
+                t2 = r1 >> (64 - s);
+            }
+            ulong x = a[0] + t0;
+            carry = (x < t0) ? 1UL : 0UL;
+            a[0] = x;
+            x = a[1] + t1;
+            hi = (x < t1) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[1] = x;
+            carry = hi;
+            x = a[2] + t2;
+            hi = (x < t2) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[2] = x;
+            carry = hi;
+            // (the accumulator's bound: the carry ends inside it)
+            for (int k = 3; carry != 0; ++k) {
+                a[k] += 1;
+                carry = (a[k] == 0) ? 1UL : 0UL;
+            }
+        }
+
+        // one monomial of degree 3: the product of the mantissas (below 2^159: 3 limbs), shifted left by
+        // (the sum of the exponents) - b bits, added to p if its sign is positive and to q if negative (`minus` is the
+        // sign of the monomial in the formula; the mantissas' signs are in neg). A zero factor adds nothing.
+        // (internal for the tests, which check it against BigInteger on accumulators with long carries)
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        internal static void add3(ulong* p, ulong* q, ulong* m, int* e, ulong neg, int b, int i0, int i1, int i2, bool minus)
+        {
+            ulong f0 = m[i0], f1 = m[i1], f2 = m[i2];
+            if (f0 == 0 || f1 == 0 || f2 == 0)
+                return;
+            ulong lo, hi, carry;
+            ulong r0 = f0, r1, r2;
+            hi = FixedArith.MulHigh(r0, f1, out r0);
+            carry = hi;
+            r1 = carry;
+            hi = FixedArith.MulHigh(r0, f2, out r0);
+            carry = hi;
+            hi = FixedArith.MulHigh(r1, f2, out lo);
+            lo += carry;
+            hi += (lo < carry) ? 1UL : 0UL;
+            r1 = lo;
+            carry = hi;
+            r2 = carry;
+            bool negative = ((((neg >> i0) ^ (neg >> i1) ^ (neg >> i2)) & 1) != 0) != minus;
+            int off = e[i0] + e[i1] + e[i2] - b;
+            ulong* a = (negative ? q : p) + (off >> 6);
+            int s = off & 63;
+            ulong t0, t1, t2, t3;
+            if (s == 0) {
+                t0 = r0; t1 = r1; t2 = r2; t3 = 0;
+            } else {
+                t0 = r0 << s;
+                t1 = (r1 << s) | (r0 >> (64 - s));
+                t2 = (r2 << s) | (r1 >> (64 - s));
+                t3 = r2 >> (64 - s);
+            }
+            ulong x = a[0] + t0;
+            carry = (x < t0) ? 1UL : 0UL;
+            a[0] = x;
+            x = a[1] + t1;
+            hi = (x < t1) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[1] = x;
+            carry = hi;
+            x = a[2] + t2;
+            hi = (x < t2) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[2] = x;
+            carry = hi;
+            x = a[3] + t3;
+            hi = (x < t3) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[3] = x;
+            carry = hi;
+            // (the accumulator's bound: the carry ends inside it)
+            for (int k = 4; carry != 0; ++k) {
+                a[k] += 1;
+                carry = (a[k] == 0) ? 1UL : 0UL;
+            }
+        }
+
+        // one monomial of degree 4: the product of the mantissas (below 2^212: 4 limbs), shifted left by
+        // (the sum of the exponents) - b bits, added to p if its sign is positive and to q if negative (`minus` is the
+        // sign of the monomial in the formula; the mantissas' signs are in neg). A zero factor adds nothing.
+        // (internal for the tests, which check it against BigInteger on accumulators with long carries)
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        internal static void add4(ulong* p, ulong* q, ulong* m, int* e, ulong neg, int b, int i0, int i1, int i2, int i3, bool minus)
+        {
+            ulong f0 = m[i0], f1 = m[i1], f2 = m[i2], f3 = m[i3];
+            if (f0 == 0 || f1 == 0 || f2 == 0 || f3 == 0)
+                return;
+            ulong lo, hi, carry;
+            ulong r0 = f0, r1, r2, r3;
+            hi = FixedArith.MulHigh(r0, f1, out r0);
+            carry = hi;
+            r1 = carry;
+            hi = FixedArith.MulHigh(r0, f2, out r0);
+            carry = hi;
+            hi = FixedArith.MulHigh(r1, f2, out lo);
+            lo += carry;
+            hi += (lo < carry) ? 1UL : 0UL;
+            r1 = lo;
+            carry = hi;
+            r2 = carry;
+            hi = FixedArith.MulHigh(r0, f3, out r0);
+            carry = hi;
+            hi = FixedArith.MulHigh(r1, f3, out lo);
+            lo += carry;
+            hi += (lo < carry) ? 1UL : 0UL;
+            r1 = lo;
+            carry = hi;
+            hi = FixedArith.MulHigh(r2, f3, out lo);
+            lo += carry;
+            hi += (lo < carry) ? 1UL : 0UL;
+            r2 = lo;
+            carry = hi;
+            r3 = carry;
+            bool negative = ((((neg >> i0) ^ (neg >> i1) ^ (neg >> i2) ^ (neg >> i3)) & 1) != 0) != minus;
+            int off = e[i0] + e[i1] + e[i2] + e[i3] - b;
+            ulong* a = (negative ? q : p) + (off >> 6);
+            int s = off & 63;
+            ulong t0, t1, t2, t3, t4;
+            if (s == 0) {
+                t0 = r0; t1 = r1; t2 = r2; t3 = r3; t4 = 0;
+            } else {
+                t0 = r0 << s;
+                t1 = (r1 << s) | (r0 >> (64 - s));
+                t2 = (r2 << s) | (r1 >> (64 - s));
+                t3 = (r3 << s) | (r2 >> (64 - s));
+                t4 = r3 >> (64 - s);
+            }
+            ulong x = a[0] + t0;
+            carry = (x < t0) ? 1UL : 0UL;
+            a[0] = x;
+            x = a[1] + t1;
+            hi = (x < t1) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[1] = x;
+            carry = hi;
+            x = a[2] + t2;
+            hi = (x < t2) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[2] = x;
+            carry = hi;
+            x = a[3] + t3;
+            hi = (x < t3) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[3] = x;
+            carry = hi;
+            x = a[4] + t4;
+            hi = (x < t4) ? 1UL : 0UL;
+            x += carry;
+            hi += (x < carry) ? 1UL : 0UL;
+            a[4] = x;
+            carry = hi;
+            // (the accumulator's bound: the carry ends inside it)
+            for (int k = 5; carry != 0; ++k) {
+                a[k] += 1;
+                carry = (a[k] == 0) ? 1UL : 0UL;
+            }
+        }
+
+        /// <summary>
+        /// Orient2d: the sign of 6 monomials of degree 2 in the coordinates.
+        /// A monomial is below 2^106 before its shift; with s = emax - emin the accumulators take
+        /// floor(2 s / 64) + 3 limbs each (3 guard bits): 3 for inputs of one exponent, 66 at the largest span of
+        /// two doubles (2045).
+        /// </summary>
+#if NET
+        [SkipLocalsInit]
+#endif
+        [MethodImpl(JitHints.Optimize)]
+        public static int Orient2d(double ax, double ay, double bx, double by, double cx, double cy)
+        {
+            ulong* m = stackalloc ulong[6];
+            int* e = stackalloc int[6];
+            ulong neg = 0;
+            int emin = int.MaxValue, emax = int.MinValue;
+            load(ax, 0, m, e, ref neg, ref emin, ref emax);
+            load(ay, 1, m, e, ref neg, ref emin, ref emax);
+            load(bx, 2, m, e, ref neg, ref emin, ref emax);
+            load(by, 3, m, e, ref neg, ref emin, ref emax);
+            load(cx, 4, m, e, ref neg, ref emin, ref emax);
+            load(cy, 5, m, e, ref neg, ref emin, ref emax);
+            // (every coordinate zero)
+            if (emin == int.MaxValue)
+                return 0;
+            int limbs = ((2 * (emax - emin)) >> 6) + 3;
+            ulong* p = stackalloc ulong[2 * limbs];
+            ulong* q = p + limbs;
+            for (int i = 0; i < 2 * limbs; ++i)
+                p[i] = 0;
+            int b = 2 * emin;
+            add2(p, q, m, e, neg, b, 0, 3, false);     // + a.x b.y
+            add2(p, q, m, e, neg, b, 0, 5, true);     // - a.x c.y
+            add2(p, q, m, e, neg, b, 1, 2, true);     // - a.y b.x
+            add2(p, q, m, e, neg, b, 1, 4, false);     // + a.y c.x
+            add2(p, q, m, e, neg, b, 2, 5, false);     // + b.x c.y
+            add2(p, q, m, e, neg, b, 3, 4, true);     // - b.y c.x
+            return compare(p, q, limbs);
+        }
+
+        /// <summary>
+        /// Orient3d: the sign of 24 monomials of degree 3 in the coordinates.
+        /// A monomial is below 2^159 before its shift; with s = emax - emin the accumulators take
+        /// floor(3 s / 64) + 4 limbs each (5 guard bits): 4 for inputs of one exponent, 99 at the largest span of
+        /// two doubles (2045).
+        /// </summary>
+#if NET
+        [SkipLocalsInit]
+#endif
+        [MethodImpl(JitHints.Optimize)]
+        public static int Orient3d(double ax, double ay, double az, double bx, double by, double bz, double cx, double cy, double cz, double dx, double dy, double dz)
+        {
+            ulong* m = stackalloc ulong[12];
+            int* e = stackalloc int[12];
+            ulong neg = 0;
+            int emin = int.MaxValue, emax = int.MinValue;
+            load(ax, 0, m, e, ref neg, ref emin, ref emax);
+            load(ay, 1, m, e, ref neg, ref emin, ref emax);
+            load(az, 2, m, e, ref neg, ref emin, ref emax);
+            load(bx, 3, m, e, ref neg, ref emin, ref emax);
+            load(by, 4, m, e, ref neg, ref emin, ref emax);
+            load(bz, 5, m, e, ref neg, ref emin, ref emax);
+            load(cx, 6, m, e, ref neg, ref emin, ref emax);
+            load(cy, 7, m, e, ref neg, ref emin, ref emax);
+            load(cz, 8, m, e, ref neg, ref emin, ref emax);
+            load(dx, 9, m, e, ref neg, ref emin, ref emax);
+            load(dy, 10, m, e, ref neg, ref emin, ref emax);
+            load(dz, 11, m, e, ref neg, ref emin, ref emax);
+            // (every coordinate zero)
+            if (emin == int.MaxValue)
+                return 0;
+            int limbs = ((3 * (emax - emin)) >> 6) + 4;
+            ulong* p = stackalloc ulong[2 * limbs];
+            ulong* q = p + limbs;
+            for (int i = 0; i < 2 * limbs; ++i)
+                p[i] = 0;
+            int b = 3 * emin;
+            add3(p, q, m, e, neg, b, 0, 4, 8, true);     // - a.x b.y c.z
+            add3(p, q, m, e, neg, b, 0, 4, 11, false);     // + a.x b.y d.z
+            add3(p, q, m, e, neg, b, 0, 5, 7, false);     // + a.x b.z c.y
+            add3(p, q, m, e, neg, b, 0, 5, 10, true);     // - a.x b.z d.y
+            add3(p, q, m, e, neg, b, 0, 7, 11, true);     // - a.x c.y d.z
+            add3(p, q, m, e, neg, b, 0, 8, 10, false);     // + a.x c.z d.y
+            add3(p, q, m, e, neg, b, 1, 3, 8, false);     // + a.y b.x c.z
+            add3(p, q, m, e, neg, b, 1, 3, 11, true);     // - a.y b.x d.z
+            add3(p, q, m, e, neg, b, 1, 5, 6, true);     // - a.y b.z c.x
+            add3(p, q, m, e, neg, b, 1, 5, 9, false);     // + a.y b.z d.x
+            add3(p, q, m, e, neg, b, 1, 6, 11, false);     // + a.y c.x d.z
+            add3(p, q, m, e, neg, b, 1, 8, 9, true);     // - a.y c.z d.x
+            add3(p, q, m, e, neg, b, 2, 3, 7, true);     // - a.z b.x c.y
+            add3(p, q, m, e, neg, b, 2, 3, 10, false);     // + a.z b.x d.y
+            add3(p, q, m, e, neg, b, 2, 4, 6, false);     // + a.z b.y c.x
+            add3(p, q, m, e, neg, b, 2, 4, 9, true);     // - a.z b.y d.x
+            add3(p, q, m, e, neg, b, 2, 6, 10, true);     // - a.z c.x d.y
+            add3(p, q, m, e, neg, b, 2, 7, 9, false);     // + a.z c.y d.x
+            add3(p, q, m, e, neg, b, 3, 7, 11, false);     // + b.x c.y d.z
+            add3(p, q, m, e, neg, b, 3, 8, 10, true);     // - b.x c.z d.y
+            add3(p, q, m, e, neg, b, 4, 6, 11, true);     // - b.y c.x d.z
+            add3(p, q, m, e, neg, b, 4, 8, 9, false);     // + b.y c.z d.x
+            add3(p, q, m, e, neg, b, 5, 6, 10, false);     // + b.z c.x d.y
+            add3(p, q, m, e, neg, b, 5, 7, 9, true);     // - b.z c.y d.x
+            return compare(p, q, limbs);
+        }
+
+        /// <summary>
+        /// InCircle: the sign of 48 monomials of degree 4 in the coordinates.
+        /// A monomial is below 2^212 before its shift; with s = emax - emin the accumulators take
+        /// floor(4 s / 64) + 5 limbs each (6 guard bits): 5 for inputs of one exponent, 132 at the largest span of
+        /// two doubles (2045).
+        /// </summary>
+#if NET
+        [SkipLocalsInit]
+#endif
+        [MethodImpl(JitHints.Optimize)]
+        public static int InCircle(double ax, double ay, double bx, double by, double cx, double cy, double dx, double dy)
+        {
+            ulong* m = stackalloc ulong[8];
+            int* e = stackalloc int[8];
+            ulong neg = 0;
+            int emin = int.MaxValue, emax = int.MinValue;
+            load(ax, 0, m, e, ref neg, ref emin, ref emax);
+            load(ay, 1, m, e, ref neg, ref emin, ref emax);
+            load(bx, 2, m, e, ref neg, ref emin, ref emax);
+            load(by, 3, m, e, ref neg, ref emin, ref emax);
+            load(cx, 4, m, e, ref neg, ref emin, ref emax);
+            load(cy, 5, m, e, ref neg, ref emin, ref emax);
+            load(dx, 6, m, e, ref neg, ref emin, ref emax);
+            load(dy, 7, m, e, ref neg, ref emin, ref emax);
+            // (every coordinate zero)
+            if (emin == int.MaxValue)
+                return 0;
+            int limbs = ((4 * (emax - emin)) >> 6) + 5;
+            ulong* p = stackalloc ulong[2 * limbs];
+            ulong* q = p + limbs;
+            for (int i = 0; i < 2 * limbs; ++i)
+                p[i] = 0;
+            int b = 4 * emin;
+            add4(p, q, m, e, neg, b, 0, 0, 2, 5, false);     // + a.x a.x b.x c.y
+            add4(p, q, m, e, neg, b, 0, 0, 2, 7, true);     // - a.x a.x b.x d.y
+            add4(p, q, m, e, neg, b, 0, 0, 3, 4, true);     // - a.x a.x b.y c.x
+            add4(p, q, m, e, neg, b, 0, 0, 3, 6, false);     // + a.x a.x b.y d.x
+            add4(p, q, m, e, neg, b, 0, 0, 4, 7, false);     // + a.x a.x c.x d.y
+            add4(p, q, m, e, neg, b, 0, 0, 5, 6, true);     // - a.x a.x c.y d.x
+            add4(p, q, m, e, neg, b, 0, 2, 2, 5, true);     // - a.x b.x b.x c.y
+            add4(p, q, m, e, neg, b, 0, 2, 2, 7, false);     // + a.x b.x b.x d.y
+            add4(p, q, m, e, neg, b, 0, 3, 3, 5, true);     // - a.x b.y b.y c.y
+            add4(p, q, m, e, neg, b, 0, 3, 3, 7, false);     // + a.x b.y b.y d.y
+            add4(p, q, m, e, neg, b, 0, 3, 4, 4, false);     // + a.x b.y c.x c.x
+            add4(p, q, m, e, neg, b, 0, 3, 5, 5, false);     // + a.x b.y c.y c.y
+            add4(p, q, m, e, neg, b, 0, 3, 6, 6, true);     // - a.x b.y d.x d.x
+            add4(p, q, m, e, neg, b, 0, 3, 7, 7, true);     // - a.x b.y d.y d.y
+            add4(p, q, m, e, neg, b, 0, 4, 4, 7, true);     // - a.x c.x c.x d.y
+            add4(p, q, m, e, neg, b, 0, 5, 5, 7, true);     // - a.x c.y c.y d.y
+            add4(p, q, m, e, neg, b, 0, 5, 6, 6, false);     // + a.x c.y d.x d.x
+            add4(p, q, m, e, neg, b, 0, 5, 7, 7, false);     // + a.x c.y d.y d.y
+            add4(p, q, m, e, neg, b, 1, 1, 2, 5, false);     // + a.y a.y b.x c.y
+            add4(p, q, m, e, neg, b, 1, 1, 2, 7, true);     // - a.y a.y b.x d.y
+            add4(p, q, m, e, neg, b, 1, 1, 3, 4, true);     // - a.y a.y b.y c.x
+            add4(p, q, m, e, neg, b, 1, 1, 3, 6, false);     // + a.y a.y b.y d.x
+            add4(p, q, m, e, neg, b, 1, 1, 4, 7, false);     // + a.y a.y c.x d.y
+            add4(p, q, m, e, neg, b, 1, 1, 5, 6, true);     // - a.y a.y c.y d.x
+            add4(p, q, m, e, neg, b, 1, 2, 2, 4, false);     // + a.y b.x b.x c.x
+            add4(p, q, m, e, neg, b, 1, 2, 2, 6, true);     // - a.y b.x b.x d.x
+            add4(p, q, m, e, neg, b, 1, 2, 4, 4, true);     // - a.y b.x c.x c.x
+            add4(p, q, m, e, neg, b, 1, 2, 5, 5, true);     // - a.y b.x c.y c.y
+            add4(p, q, m, e, neg, b, 1, 2, 6, 6, false);     // + a.y b.x d.x d.x
+            add4(p, q, m, e, neg, b, 1, 2, 7, 7, false);     // + a.y b.x d.y d.y
+            add4(p, q, m, e, neg, b, 1, 3, 3, 4, false);     // + a.y b.y b.y c.x
+            add4(p, q, m, e, neg, b, 1, 3, 3, 6, true);     // - a.y b.y b.y d.x
+            add4(p, q, m, e, neg, b, 1, 4, 4, 6, false);     // + a.y c.x c.x d.x
+            add4(p, q, m, e, neg, b, 1, 4, 6, 6, true);     // - a.y c.x d.x d.x
+            add4(p, q, m, e, neg, b, 1, 4, 7, 7, true);     // - a.y c.x d.y d.y
+            add4(p, q, m, e, neg, b, 1, 5, 5, 6, false);     // + a.y c.y c.y d.x
+            add4(p, q, m, e, neg, b, 2, 2, 4, 7, true);     // - b.x b.x c.x d.y
+            add4(p, q, m, e, neg, b, 2, 2, 5, 6, false);     // + b.x b.x c.y d.x
+            add4(p, q, m, e, neg, b, 2, 4, 4, 7, false);     // + b.x c.x c.x d.y
+            add4(p, q, m, e, neg, b, 2, 5, 5, 7, false);     // + b.x c.y c.y d.y
+            add4(p, q, m, e, neg, b, 2, 5, 6, 6, true);     // - b.x c.y d.x d.x
+            add4(p, q, m, e, neg, b, 2, 5, 7, 7, true);     // - b.x c.y d.y d.y
+            add4(p, q, m, e, neg, b, 3, 3, 4, 7, true);     // - b.y b.y c.x d.y
+            add4(p, q, m, e, neg, b, 3, 3, 5, 6, false);     // + b.y b.y c.y d.x
+            add4(p, q, m, e, neg, b, 3, 4, 4, 6, true);     // - b.y c.x c.x d.x
+            add4(p, q, m, e, neg, b, 3, 4, 6, 6, false);     // + b.y c.x d.x d.x
+            add4(p, q, m, e, neg, b, 3, 4, 7, 7, false);     // + b.y c.x d.y d.y
+            add4(p, q, m, e, neg, b, 3, 5, 5, 6, true);     // - b.y c.y c.y d.x
+            return compare(p, q, limbs);
+        }
+    }
