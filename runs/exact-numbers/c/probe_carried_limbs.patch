         internal static long DeterminantScratch(int a, int b, int c, int d) { return 8L * a + 28L * b + 64L * ((long)c + d) + 96; }
 
 #if NET
+        // ---- PROBE (candidate C, section 7 of the design note; local only): limbs carried beside the BigIntegers ----
+        internal static readonly bool CarriedOn = (Environment.GetEnvironmentVariable("EXACT_PROTO") ?? "").Contains("carried");
+        internal static readonly bool LimbCentroid = (Environment.GetEnvironmentVariable("EXACT_PROTO") ?? "").Contains("centroid");
+
+        /// <summary> four integers as sign-magnitude limbs in one array, converted once (public API of BigInteger only) </summary>
+        internal sealed class Carried
+        {
+            public readonly ulong[] L;
+            public readonly int O1, O2, O3;          // where the second, third and fourth integer start
+            public readonly int N0, N1, N2, N3;      // their significant limbs
+            public readonly int Neg;                 // bit k: integer k is negative
+            public Carried(ulong[] l, int o1, int o2, int o3, int n0, int n1, int n2, int n3, int neg) { L = l; O1 = o1; O2 = o2; O3 = o3; N0 = n0; N1 = n1; N2 = n2; N3 = n3; Neg = neg; }
+            public int Total { get { return N0 + N1 + N2 + N3; } }
+
+            public static Carried Of(BigInteger a, BigInteger b, BigInteger c, BigInteger d)
+            {
+                int ca = limbs_of(a), cb = limbs_of(b), cc = limbs_of(c), cd = limbs_of(d);
+                var l = new ulong[ca + cb + cc + cd];
+                fixed (ulong* p = l) {
+                    FixedInt fa = load(a, p, ca), fb = load(b, p + ca, cb), fc = load(c, p + ca + cb, cc), fd = load(d, p + ca + cb + cc, cd);
+                    return new Carried(l, ca, ca + cb, ca + cb + cc, fa.Len, fb.Len, fc.Len, fd.Len,
+                        (fa.Neg ? 1 : 0) | (fb.Neg ? 2 : 0) | (fc.Neg ? 4 : 0) | (fd.Neg ? 8 : 0));
+                }
+            }
+
+            // from four results that live in an arena (the limb centroid): one copy, no conversion
+            public static Carried Of(FixedInt a, FixedInt b, FixedInt c, FixedInt d)
+            {
+                var l = new ulong[Math.Max(1, a.Len + b.Len + c.Len + d.Len)];
+                fixed (ulong* p = l) {
+                    ulong* q = p;
+                    for (int k = 0; k < a.Len; ++k) *q++ = a.P[k];
+                    for (int k = 0; k < b.Len; ++k) *q++ = b.P[k];
+                    for (int k = 0; k < c.Len; ++k) *q++ = c.P[k];
+                    for (int k = 0; k < d.Len; ++k) *q++ = d.P[k];
+                }
+                return new Carried(l, a.Len, a.Len + b.Len, a.Len + b.Len + c.Len, a.Len, b.Len, c.Len, d.Len,
+                    (a.Neg ? 1 : 0) | (b.Neg ? 2 : 0) | (c.Neg ? 4 : 0) | (d.Neg ? 8 : 0));
+            }
+        }
+
+        /// <summary> the sign of A X + B Y + C Z - D W from carried limbs; false beyond the stack limit </summary>
+        [MethodImpl(JitHints.Optimize)]
+        [SkipLocalsInit]
+        internal static bool PlaneSide(Carried pl, Carried pt, out int sign)
+        {
+            int total = pl.Total + pt.Total;
+            if (total > MaxOperandLimbs) { sign = 0; return false; }
+            int scratch = SideScratch(total);
+            ulong* sc = stackalloc ulong[scratch];
+            var ar = new FixedArena(sc, scratch);
+            fixed (ulong* p = pl.L, q = pt.L) {
+                FixedInt fa = new FixedInt(p, pl.N0, (pl.Neg & 1) != 0), fb = new FixedInt(p + pl.O1, pl.N1, (pl.Neg & 2) != 0);
+                FixedInt fc = new FixedInt(p + pl.O2, pl.N2, (pl.Neg & 4) != 0), fd = new FixedInt(p + pl.O3, pl.N3, (pl.Neg & 8) != 0);
+                FixedInt fx = new FixedInt(q, pt.N0, (pt.Neg & 1) != 0), fy = new FixedInt(q + pt.O1, pt.N1, (pt.Neg & 2) != 0);
+                FixedInt fz = new FixedInt(q + pt.O2, pt.N2, (pt.Neg & 4) != 0), fw = new FixedInt(q + pt.O3, pt.N3, (pt.Neg & 8) != 0);
+                FixedInt s = FixedArith.Add(FixedArith.Mul(fa, fx, ref ar), FixedArith.Mul(fb, fy, ref ar), ref ar);
+                s = FixedArith.Add(s, FixedArith.Mul(fc, fz, ref ar), ref ar);
+                sign = FixedArith.Sub(s, FixedArith.Mul(fd, fw, ref ar), ref ar).Sign;
+            }
+            return true;
+        }
+
+        /// <summary> the sign of A x + B y + C z - D for an integer point (W = 1), the plane from carried limbs </summary>
+        [MethodImpl(JitHints.Optimize)]
+        [SkipLocalsInit]
+        internal static bool PlaneSide(Carried pl, BigInteger x, BigInteger y, BigInteger z, out int sign)
+        {
+            int nx = limbs_of(x), ny = limbs_of(y), nz = limbs_of(z);
+            int total = pl.Total + nx + ny + nz;
+            if (total > MaxOperandLimbs) { sign = 0; return false; }
+            ulong* buf = stackalloc ulong[nx + ny + nz];
+            int scratch = SideScratch(total);
+            ulong* sc = stackalloc ulong[scratch];
+            var ar = new FixedArena(sc, scratch);
+            FixedInt fx = load(x, buf, nx), fy = load(y, buf + nx, ny), fz = load(z, buf + nx + ny, nz);
+            fixed (ulong* p = pl.L) {
+                FixedInt fa = new FixedInt(p, pl.N0, (pl.Neg & 1) != 0), fb = new FixedInt(p + pl.O1, pl.N1, (pl.Neg & 2) != 0);
+                FixedInt fc = new FixedInt(p + pl.O2, pl.N2, (pl.Neg & 4) != 0), fd = new FixedInt(p + pl.O3, pl.N3, (pl.Neg & 8) != 0);
+                FixedInt s = FixedArith.Add(FixedArith.Mul(fa, fx, ref ar), FixedArith.Mul(fb, fy, ref ar), ref ar);
+                s = FixedArith.Add(s, FixedArith.Mul(fc, fz, ref ar), ref ar);
+                sign = FixedArith.Sub(s, fd, ref ar).Sign;
+            }
+            return true;
+        }
+
+        /// <summary> the sign of the dot of the first three integers of a and b (two planes' normals) </summary>
+        [MethodImpl(JitHints.Optimize)]
+        [SkipLocalsInit]
+        internal static bool Dot(Carried a, Carried b, out int sign)
+        {
+            int total = a.N0 + a.N1 + a.N2 + b.N0 + b.N1 + b.N2;
+            if (total > MaxOperandLimbs) { sign = 0; return false; }
+            int scratch = SideScratch(total);
+            ulong* sc = stackalloc ulong[scratch];
+            var ar = new FixedArena(sc, scratch);
+            fixed (ulong* p = a.L, q = b.L) {
+                FixedInt fa = new FixedInt(p, a.N0, (a.Neg & 1) != 0), fb = new FixedInt(p + a.O1, a.N1, (a.Neg & 2) != 0), fc = new FixedInt(p + a.O2, a.N2, (a.Neg & 4) != 0);
+                FixedInt fx = new FixedInt(q, b.N0, (b.Neg & 1) != 0), fy = new FixedInt(q + b.O1, b.N1, (b.Neg & 2) != 0), fz = new FixedInt(q + b.O2, b.N2, (b.Neg & 4) != 0);
+                FixedInt s = FixedArith.Add(FixedArith.Mul(fa, fx, ref ar), FixedArith.Mul(fb, fy, ref ar), ref ar);
+                sign = FixedArith.Add(s, FixedArith.Mul(fc, fz, ref ar), ref ar).Sign;
+            }
+            return true;
+        }
+
+        static BigInteger big(FixedInt v)
+        {
+            if (v.Len == 0) return BigInteger.Zero;
+            var r = new BigInteger(new ReadOnlySpan<byte>(v.P, 8 * v.Len), true, false);
+            return v.Neg ? -r : r;
+        }
+
+        /// <summary> PROBE: the unreduced centroid of three homogeneous points on stack limbs, and its carried limbs; false: too wide </summary>
+        [SkipLocalsInit]
+        internal static bool Centroid(ExactPoint3 a, ExactPoint3 b, ExactPoint3 c, out ExactPoint3 result, out Carried limbs)
+        {
+            result = default(ExactPoint3); limbs = null;
+            int* cp = stackalloc int[12];
+            cp[0] = limbs_of(a.X); cp[1] = limbs_of(a.Y); cp[2] = limbs_of(a.Z); cp[3] = limbs_of(a.W);
+            cp[4] = limbs_of(b.X); cp[5] = limbs_of(b.Y); cp[6] = limbs_of(b.Z); cp[7] = limbs_of(b.W);
+            cp[8] = limbs_of(c.X); cp[9] = limbs_of(c.Y); cp[10] = limbs_of(c.Z); cp[11] = limbs_of(c.W);
+            int total = 0, widest = 0;
+            for (int k = 0; k < 12; ++k) { total += cp[k]; if (cp[k] > widest) widest = cp[k]; }
+            // three products of two W (2 w each), nine products of 3 w, six sums of at most 3 w + 2, and 3 a.W wbc
+            int scratch = 60 * widest + 64;
+            if (total + scratch > MaxDeterminantLimbs) return false;
+            ulong* buf = stackalloc ulong[total + 1];
+            ulong* sc = stackalloc ulong[scratch];
+            var ar = new FixedArena(sc, scratch);
+            FixedInt* m = stackalloc FixedInt[12];
+            ulong* p = buf;
+            m[0] = load(a.X, p, cp[0]); p += cp[0]; m[1] = load(a.Y, p, cp[1]); p += cp[1]; m[2] = load(a.Z, p, cp[2]); p += cp[2]; m[3] = load(a.W, p, cp[3]); p += cp[3];
+            m[4] = load(b.X, p, cp[4]); p += cp[4]; m[5] = load(b.Y, p, cp[5]); p += cp[5]; m[6] = load(b.Z, p, cp[6]); p += cp[6]; m[7] = load(b.W, p, cp[7]); p += cp[7];
+            m[8] = load(c.X, p, cp[8]); p += cp[8]; m[9] = load(c.Y, p, cp[9]); p += cp[9]; m[10] = load(c.Z, p, cp[10]); p += cp[10]; m[11] = load(c.W, p, cp[11]);
+            FixedInt wbc = FixedArith.Mul(m[7], m[11], ref ar), wac = FixedArith.Mul(m[3], m[11], ref ar), wab = FixedArith.Mul(m[3], m[7], ref ar);
+            ulong three = 3;
+            FixedInt f3 = new FixedInt(&three, 1, false);
+            FixedInt x = FixedArith.Add(FixedArith.Add(FixedArith.Mul(m[0], wbc, ref ar), FixedArith.Mul(m[4], wac, ref ar), ref ar), FixedArith.Mul(m[8], wab, ref ar), ref ar);
+            FixedInt y = FixedArith.Add(FixedArith.Add(FixedArith.Mul(m[1], wbc, ref ar), FixedArith.Mul(m[5], wac, ref ar), ref ar), FixedArith.Mul(m[9], wab, ref ar), ref ar);
+            FixedInt z = FixedArith.Add(FixedArith.Add(FixedArith.Mul(m[2], wbc, ref ar), FixedArith.Mul(m[6], wac, ref ar), ref ar), FixedArith.Mul(m[10], wab, ref ar), ref ar);
+            FixedInt w = FixedArith.Mul(FixedArith.Mul(f3, m[3], ref ar), wbc, ref ar);
+            result = ExactPoint3.CreateUnreduced(big(x), big(y), big(z), big(w));
+            if (CarriedOn) limbs = Carried.Of(x, y, z, w);
+            return true;
+        }
