diff --git a/math/CProbe.cs b/math/CProbe.cs
new file mode 100644
index 00000000..724c6c55
--- /dev/null
+++ b/math/CProbe.cs
@@ -0,0 +1,29 @@
+// local measurement only (candidate C, upper bound): never part of a PR
+using System;
+using System.Diagnostics;
+using System.IO;
+
+namespace g3
+{
+    public static class CProbe
+    {
+        public static long CentroidTicks, CentroidCalls, CentroidBytes, LoadTicks, KernelTicks, KernelCalls, ExactTicks, ExactCalls, ExactBytes;
+
+        static CProbe()
+        {
+            AppDomain.CurrentDomain.ProcessExit += (s, e) => {
+                string f = Environment.GetEnvironmentVariable("CPROBE_OUT");
+                if (f == null) return;
+                // the cost of one timestamp
+                long t0 = Stopwatch.GetTimestamp(); long x = 0;
+                for (int i = 0; i < 5000000; ++i) x += Stopwatch.GetTimestamp();
+                double ns = (Stopwatch.GetTimestamp() - t0) * 1e9 / Stopwatch.Frequency / 5000000;
+                double ms = 1000.0 / Stopwatch.Frequency;
+                File.AppendAllText(f, "{\"centroid_ms\":" + (CentroidTicks * ms).ToString("F1") + ",\"centroid_calls\":" + CentroidCalls + ",\"centroid_mb\":" + (CentroidBytes / 1048576.0).ToString("F1")
+                    + ",\"load_ms\":" + (LoadTicks * ms).ToString("F1") + ",\"kernel_ms\":" + (KernelTicks * ms).ToString("F1") + ",\"kernel_calls\":" + KernelCalls
+                    + ",\"exact_ms\":" + (ExactTicks * ms).ToString("F1") + ",\"exact_calls\":" + ExactCalls + ",\"exact_mb\":" + (ExactBytes / 1048576.0).ToString("F1")
+                    + ",\"timestamp_ns\":" + ns.ToString("F1") + "}\n");
+            };
+        }
+    }
+}
