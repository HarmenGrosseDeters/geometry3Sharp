+// Distributed under the Boost Software License, Version 1.0. http://www.boost.org/LICENSE_1_0.txt
+using System;
+using System.Numerics;
+using System.Runtime.CompilerServices;
+
+namespace g3
+{
+    /// <summary>
+    /// Signs of small integer expressions on BigInteger operands, evaluated on stack limbs with FixedArith instead of
+    /// BigInteger temporaries: the plane side A X + B Y + C Z - D W, the dot of two integer vectors and the 4 x 4
+    /// determinant of four homogeneous points (the exact stages of ExactMeshBoolean's classification). The operands
+    /// are copied into sign-magnitude limbs per call (no allocation), the arithmetic is the library's FixedArith, so
+    /// the value is the same integer and the sign the same as the BigInteger expression's. Operands wider than
+    /// MaxLimbs limbs, and netstandard2.0 (no BigInteger.TryWriteBytes), use the BigInteger expression.
+    /// docs/design/EXACT_LIMB_SIGNS.md
+    /// </summary>
+    internal static unsafe class ExactLimbSigns
+    {
+        /// <summary> the widest operand evaluated on the stack, in 64-bit limbs (2560 bits); wider ones use BigInteger </summary>
+        internal const int MaxLimbs = 40;
+
+#if NET
+        // the limbs v needs: its two's complement bytes (one bit more than its magnitude), rounded up
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        static int limbs_of(BigInteger v) { return (v.GetByteCount(false) + 7) >> 3; }
+
+        // the magnitude of v in dst (n limbs, n >= limbs_of(v)) and its sign
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        static FixedInt load(BigInteger v, ulong* dst, int n)
+        {
+            int sign = v.Sign;
+            if (sign == 0)
+                return new FixedInt(null, 0, false);
+            var bytes = new Span<byte>(dst, 8 * n);
+            // (two's complement, sign-extended to n limbs)
+            bytes.Fill(sign < 0 ? (byte)0xFF : (byte)0);
+            int written;
+            if (v.TryWriteBytes(bytes, out written, false, false) == false)
+                throw new InvalidOperationException("ExactLimbSigns: an operand wider than its buffer");
+            if (sign < 0) {
+                // the magnitude: invert and add one
+                ulong carry = 1;
+                for (int k = 0; k < n; ++k) {
+                    ulong t = ~dst[k] + carry;
+                    carry = (carry != 0 && t == 0) ? 1UL : 0UL;
+                    dst[k] = t;
+                }
+            }
+            int len = n;
+            while (len > 0 && dst[len - 1] == 0) len--;
+            return new FixedInt(dst, len, sign < 0);
+        }
+#endif
+
+        /// <summary> the sign of a x + b y + c z - d w </summary>
+        [MethodImpl(JitHints.Optimize)]
+#if NET
+        [SkipLocalsInit]
+#endif
+        internal static int PlaneSide(BigInteger a, BigInteger b, BigInteger c, BigInteger d, BigInteger x, BigInteger y, BigInteger z, BigInteger w)
+        {
+#if NET
+            int na = limbs_of(a), nb = limbs_of(b), nc = limbs_of(c), nd = limbs_of(d), nx = limbs_of(x), ny = limbs_of(y), nz = limbs_of(z), nw = limbs_of(w);
+            int total = na + nb + nc + nd + nx + ny + nz + nw;
+            if (total <= 8 * MaxLimbs) {
+                ulong* buf = stackalloc ulong[total];
+                // the four products take total limbs, the three sums at most a product and 3 limbs each
+                int scratch = 4 * total + 16;
+                ulong* sc = stackalloc ulong[scratch];
+                var ar = new FixedArena(sc, scratch);
+                ulong* p = buf;
+                FixedInt fa = load(a, p, na); p += na;
+                FixedInt fb = load(b, p, nb); p += nb;
+                FixedInt fc = load(c, p, nc); p += nc;
+                FixedInt fd = load(d, p, nd); p += nd;
+                FixedInt fx = load(x, p, nx); p += nx;
+                FixedInt fy = load(y, p, ny); p += ny;
+                FixedInt fz = load(z, p, nz); p += nz;
+                FixedInt fw = load(w, p, nw);
+                FixedInt s = FixedArith.Add(FixedArith.Mul(fa, fx, ref ar), FixedArith.Mul(fb, fy, ref ar), ref ar);
+                s = FixedArith.Add(s, FixedArith.Mul(fc, fz, ref ar), ref ar);
+                return FixedArith.Sub(s, FixedArith.Mul(fd, fw, ref ar), ref ar).Sign;
+            }
+#endif
+            return (a * x + b * y + c * z - d * w).Sign;
+        }
+
+        /// <summary> the sign of a x + b y + c z </summary>
+        [MethodImpl(JitHints.Optimize)]
+#if NET
+        [SkipLocalsInit]
+#endif
+        internal static int Dot(BigInteger a, BigInteger b, BigInteger c, BigInteger x, BigInteger y, BigInteger z)
+        {
+#if NET
+            int na = limbs_of(a), nb = limbs_of(b), nc = limbs_of(c), nx = limbs_of(x), ny = limbs_of(y), nz = limbs_of(z);
+            int total = na + nb + nc + nx + ny + nz;
+            if (total <= 6 * MaxLimbs) {
+                ulong* buf = stackalloc ulong[total];
+                int scratch = 4 * total + 16;
+                ulong* sc = stackalloc ulong[scratch];
+                var ar = new FixedArena(sc, scratch);
+                ulong* p = buf;
+                FixedInt fa = load(a, p, na); p += na;
+                FixedInt fb = load(b, p, nb); p += nb;
+                FixedInt fc = load(c, p, nc); p += nc;
+                FixedInt fx = load(x, p, nx); p += nx;
+                FixedInt fy = load(y, p, ny); p += ny;
+                FixedInt fz = load(z, p, nz);
+                FixedInt s = FixedArith.Add(FixedArith.Mul(fa, fx, ref ar), FixedArith.Mul(fb, fy, ref ar), ref ar);
+                return FixedArith.Add(s, FixedArith.Mul(fc, fz, ref ar), ref ar).Sign;
+            }
+#endif
+            return (a * x + b * y + c * z).Sign;
+        }
+
+#if NET
+        // a (e i - f h) - b (d i - f g) + c (d h - e g), as ExactPoint3.Det3
+        static FixedInt det3(FixedInt a, FixedInt b, FixedInt c, FixedInt d, FixedInt e, FixedInt f, FixedInt g, FixedInt h, FixedInt i, ref FixedArena ar)
+        {
+            FixedInt t1 = FixedArith.Mul(a, FixedArith.Sub(FixedArith.Mul(e, i, ref ar), FixedArith.Mul(f, h, ref ar), ref ar), ref ar);
+            FixedInt t2 = FixedArith.Mul(b, FixedArith.Sub(FixedArith.Mul(d, i, ref ar), FixedArith.Mul(f, g, ref ar), ref ar), ref ar);
+            FixedInt t3 = FixedArith.Mul(c, FixedArith.Sub(FixedArith.Mul(d, h, ref ar), FixedArith.Mul(e, g, ref ar), ref ar), ref ar);
+            return FixedArith.Add(FixedArith.Sub(t1, t2, ref ar), t3, ref ar);
+        }
+#endif
+
+        /// <summary>
+        /// the sign of the 4 x 4 determinant of the rows (X, Y, Z, W) of a, b, c, d, expanded along the first row as
+        /// ExactMeshArrangement.Det4
+        /// </summary>
+        [MethodImpl(JitHints.Optimize)]
+#if NET
+        [SkipLocalsInit]
+#endif
+        internal static int Det4(ExactPoint3 a, ExactPoint3 b, ExactPoint3 c, ExactPoint3 d)
+        {
+#if NET
+            int* n = stackalloc int[16];
+            n[0] = limbs_of(a.X); n[1] = limbs_of(a.Y); n[2] = limbs_of(a.Z); n[3] = limbs_of(a.W);
+            n[4] = limbs_of(b.X); n[5] = limbs_of(b.Y); n[6] = limbs_of(b.Z); n[7] = limbs_of(b.W);
+            n[8] = limbs_of(c.X); n[9] = limbs_of(c.Y); n[10] = limbs_of(c.Z); n[11] = limbs_of(c.W);
+            n[12] = limbs_of(d.X); n[13] = limbs_of(d.Y); n[14] = limbs_of(d.Z); n[15] = limbs_of(d.W);
+            int total = 0, widest = 0;
+            for (int k = 0; k < 16; ++k) { total += n[k]; widest = Math.Max(widest, n[k]); }
+            if (widest <= MaxLimbs) {
+                ulong* buf = stackalloc ulong[total];
+                // with entries of at most w limbs: a 3 x 3 minor takes 33 w + 11 limbs of scratch (six products of 2 w, three
+                // differences of 2 w + 1, three products of 3 w + 1, two sums of at most 3 w + 3), the four of them
+                // 132 w + 44; the four products with the first row 4 w + 3 each and the four sums at most 4 w + 5 each
+                int scratch = 164 * widest + 96;
+                ulong* sc = stackalloc ulong[scratch];
+                var ar = new FixedArena(sc, scratch);
+                FixedInt* m = stackalloc FixedInt[16];
+                ulong* p = buf;
+                m[0] = load(a.X, p, n[0]); p += n[0]; m[1] = load(a.Y, p, n[1]); p += n[1]; m[2] = load(a.Z, p, n[2]); p += n[2]; m[3] = load(a.W, p, n[3]); p += n[3];
+                m[4] = load(b.X, p, n[4]); p += n[4]; m[5] = load(b.Y, p, n[5]); p += n[5]; m[6] = load(b.Z, p, n[6]); p += n[6]; m[7] = load(b.W, p, n[7]); p += n[7];
+                m[8] = load(c.X, p, n[8]); p += n[8]; m[9] = load(c.Y, p, n[9]); p += n[9]; m[10] = load(c.Z, p, n[10]); p += n[10]; m[11] = load(c.W, p, n[11]); p += n[11];
+                m[12] = load(d.X, p, n[12]); p += n[12]; m[13] = load(d.Y, p, n[13]); p += n[13]; m[14] = load(d.Z, p, n[14]); p += n[14]; m[15] = load(d.W, p, n[15]);
+                FixedInt det = new FixedInt(null, 0, false);
+                for (int col = 0; col < 4; ++col) {
+                    int c0 = (col == 0) ? 1 : 0, c1 = (col <= 1) ? 2 : 1, c2 = (col <= 2) ? 3 : 2;
+                    FixedInt minor = det3(m[4 + c0], m[4 + c1], m[4 + c2], m[8 + c0], m[8 + c1], m[8 + c2], m[12 + c0], m[12 + c1], m[12 + c2], ref ar);
+                    FixedInt term = FixedArith.Mul(m[col], minor, ref ar);
+                    det = (col % 2 == 0) ? FixedArith.Add(det, term, ref ar) : FixedArith.Sub(det, term, ref ar);
+                }
+                return det.Sign;
+            }
+#endif
+            return Det4Big(a, b, c, d);
+        }
+
+        /// <summary> the BigInteger form of Det4 (wide operands, netstandard2.0, and the tests' reference) </summary>
+        internal static int Det4Big(ExactPoint3 a, ExactPoint3 b, ExactPoint3 c, ExactPoint3 d)
+        {
+            BigInteger[,] m = new BigInteger[4, 4];
+            m[0, 0] = a.X; m[0, 1] = a.Y; m[0, 2] = a.Z; m[0, 3] = a.W;
+            m[1, 0] = b.X; m[1, 1] = b.Y; m[1, 2] = b.Z; m[1, 3] = b.W;
+            m[2, 0] = c.X; m[2, 1] = c.Y; m[2, 2] = c.Z; m[2, 3] = c.W;
+            m[3, 0] = d.X; m[3, 1] = d.Y; m[3, 2] = d.Z; m[3, 3] = d.W;
+            return ExactMeshArrangement.Det4(m).Sign;
+        }
+    }
+}
diff --git a/tests/geometry3Sharp.Tests/ExactLimbSignsTests.cs b/tests/geometry3Sharp.Tests/ExactLimbSignsTests.cs
new file mode 100644
index 0000000..a401654
--- /dev/null
+++ b/tests/geometry3Sharp.Tests/ExactLimbSignsTests.cs
@@ -0,0 +1,190 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using g3;
+using Xunit;
+
+namespace geometry3Sharp.Tests
+{
+    /// <summary>
+    /// ExactLimbSigns: the signs of the plane side, the dot and the 4 x 4 determinant on stack limbs equal the BigInteger
+    /// expressions, for operands of every width up to and beyond the stack limit, at the limb boundaries, with exact
+    /// zeros, and without allocation.
+    /// </summary>
+    public class ExactLimbSignsTests
+    {
+        // a value of exactly `bits` bits (0: zero) with a random sign; every eighth one at a limb boundary pattern
+        static BigInteger Rand(Random r, int bits)
+        {
+            if (bits <= 0) return BigInteger.Zero;
+            BigInteger v;
+            int kind = r.Next(8);
+            if (kind == 0) v = BigInteger.One << (bits - 1);                         // a power of two
+            else if (kind == 1) v = (BigInteger.One << bits) - 1;                    // all ones
+            else {
+                byte[] b = new byte[bits / 8 + 2];
+                r.NextBytes(b);
+                b[b.Length - 1] = 0;
+                v = new BigInteger(b) & ((BigInteger.One << bits) - 1);
+                v |= BigInteger.One << (bits - 1);
+            }
+            return r.Next(2) == 0 ? v : -v;
+        }
+
+        // widths: small, around the limb boundaries, the classification's sizes, up to the stack limit and beyond it
+        static int Width(Random r)
+        {
+            switch (r.Next(8)) {
+                case 0: return r.Next(0, 4);
+                case 1: return 64 * r.Next(1, 14) + r.Next(-2, 3);
+                case 2: return r.Next(1, 130);
+                case 3: return r.Next(130, 900);
+                case 4: return r.Next(900, 64 * ExactLimbSigns.MaxLimbs - 8);
+                case 5: return 64 * ExactLimbSigns.MaxLimbs + r.Next(-70, 70);
+                case 6: return r.Next(64 * ExactLimbSigns.MaxLimbs, 64 * ExactLimbSigns.MaxLimbs + 600);
+                default: return r.Next(1, 400);
+            }
+        }
+
+        [Fact]
+        public void PlaneSide_MatchesBigInteger()
+        {
+            var r = new Random(11);
+            int zeros = 0, wide = 0;
+            for (int i = 0; i < 30000; ++i) {
+                BigInteger a = Rand(r, Width(r)), b = Rand(r, Width(r)), c = Rand(r, Width(r)), x = Rand(r, Width(r)), y = Rand(r, Width(r)), z = Rand(r, Width(r));
+                BigInteger w = Rand(r, Width(r)), d = Rand(r, Width(r));
+                int kind = i % 4;
+                if (kind == 1) { w = BigInteger.One; d = a * x + b * y + c * z; }                       // on the plane
+                else if (kind == 2) { w = BigInteger.One; d = a * x + b * y + c * z + (r.Next(2) == 0 ? 1 : -1); }    // one unit off it
+                int expected = (a * x + b * y + c * z - d * w).Sign;
+                Assert.True(expected == ExactLimbSigns.PlaneSide(a, b, c, d, x, y, z, w), $"case {i}");
+                if (expected == 0) zeros++;
+                if (a.GetBitLength() > 64 * ExactLimbSigns.MaxLimbs) wide++;
+            }
+            Assert.True(zeros > 5000 && wide > 1000, $"{zeros} zeros, {wide} wide");
+        }
+
+        [Fact]
+        public void Dot_MatchesBigInteger()
+        {
+            var r = new Random(12);
+            int zeros = 0;
+            for (int i = 0; i < 30000; ++i) {
+                BigInteger a = Rand(r, Width(r)), b = Rand(r, Width(r)), c = Rand(r, Width(r)), x = Rand(r, Width(r)), y = Rand(r, Width(r)), z = Rand(r, Width(r));
+                if (i % 3 == 1) { x = b; y = -a; z = BigInteger.Zero; }                 // orthogonal
+                else if (i % 3 == 2) { x = b * c; y = -2 * a * c; z = a * b + (r.Next(2) == 0 ? 0 : 1); }   // orthogonal or one unit off
+                int expected = (a * x + b * y + c * z).Sign;
+                Assert.True(expected == ExactLimbSigns.Dot(a, b, c, x, y, z), $"case {i}");
+                if (expected == 0) zeros++;
+            }
+            Assert.True(zeros > 5000, $"{zeros} zeros");
+        }
+
+        static ExactPoint3 Point(Random r)
+        {
+            BigInteger w = BigInteger.Abs(Rand(r, Math.Max(1, Width(r))));
+            return ExactPoint3.CreateUnreduced(Rand(r, Width(r)), Rand(r, Width(r)), Rand(r, Width(r)), w);
+        }
+
+        [Fact]
+        public void Det4_MatchesBigInteger()
+        {
+            var r = new Random(13);
+            int zeros = 0, nonzero = 0;
+            for (int i = 0; i < 6000; ++i) {
+                ExactPoint3 a = Point(r), b = Point(r), c = Point(r), d = Point(r);
+                if (i % 3 == 1) {
+                    // d in the plane of a, b, c: integer points (W = 1), d = a + s (b - a) + t (c - a)
+                    a = ExactPoint3.CreateUnreduced(Rand(r, Width(r)), Rand(r, Width(r)), Rand(r, Width(r)), BigInteger.One);
+                    b = ExactPoint3.CreateUnreduced(Rand(r, Width(r)), Rand(r, Width(r)), Rand(r, Width(r)), BigInteger.One);
+                    c = ExactPoint3.CreateUnreduced(Rand(r, Width(r)), Rand(r, Width(r)), Rand(r, Width(r)), BigInteger.One);
+                    BigInteger s = Rand(r, r.Next(0, 70)), t = Rand(r, r.Next(0, 70));
+                    BigInteger off = (i % 2 == 0) ? BigInteger.Zero : BigInteger.One;
+                    d = ExactPoint3.CreateUnreduced(a.X + s * (b.X - a.X) + t * (c.X - a.X), a.Y + s * (b.Y - a.Y) + t * (c.Y - a.Y), a.Z + s * (b.Z - a.Z) + t * (c.Z - a.Z) + off, BigInteger.One);
+                }
+                int expected = ExactLimbSigns.Det4Big(a, b, c, d);
+                Assert.True(expected == ExactLimbSigns.Det4(a, b, c, d), $"case {i}");
+                // two rows exchanged: the opposite sign
+                Assert.True(-expected == ExactLimbSigns.Det4(b, a, c, d), $"case {i}, rows exchanged");
+                if (expected == 0) zeros++; else nonzero++;
+            }
+            Assert.True(zeros > 500 && nonzero > 3000, $"{zeros} zeros, {nonzero} others");
+        }
+
+        // The scratch space of each kernel holds its largest case: every operand at the stack limit with all bits set
+        // (FixedArith throws when its arena is exhausted), and mixed widths.
+        [Fact]
+        public void LargestOperands_FitTheScratchSpace()
+        {
+            BigInteger big = (BigInteger.One << (64 * ExactLimbSigns.MaxLimbs - 1)) - 1;      // MaxLimbs limbs with its sign bit
+            Assert.Equal((big * big + big * big + big * big - big * -big).Sign, ExactLimbSigns.PlaneSide(big, big, big, big, big, big, big, -big));
+            Assert.Equal(1, ExactLimbSigns.Dot(big, big, big, big, big, big));
+            var p = ExactPoint3.CreateUnreduced(big, -big, big, big);
+            var q = ExactPoint3.CreateUnreduced(-big, big, big - 1, big);
+            var s = ExactPoint3.CreateUnreduced(big, big - 2, -big, big - 3);
+            var t = ExactPoint3.CreateUnreduced(big - 5, -big, -big, big);
+            Assert.Equal(ExactLimbSigns.Det4Big(p, q, s, t), ExactLimbSigns.Det4(p, q, s, t));
+            var r = new Random(14);
+            for (int i = 0; i < 300; ++i) {
+                Func<BigInteger> v = () => r.Next(3) == 0 ? (r.Next(2) == 0 ? big : -big) : Rand(r, r.Next(0, 3) * 64 + r.Next(1, 64));
+                var a = ExactPoint3.CreateUnreduced(v(), v(), v(), BigInteger.Abs(v()) + 1);
+                var b = ExactPoint3.CreateUnreduced(v(), v(), v(), BigInteger.Abs(v()) + 1);
+                var c = ExactPoint3.CreateUnreduced(v(), v(), v(), BigInteger.Abs(v()) + 1);
+                var d = ExactPoint3.CreateUnreduced(v(), v(), v(), BigInteger.Abs(v()) + 1);
+                Assert.Equal(ExactLimbSigns.Det4Big(a, b, c, d), ExactLimbSigns.Det4(a, b, c, d));
+                Assert.Equal((a.X * b.X + a.Y * b.Y + a.Z * b.Z - a.W * b.W).Sign, ExactLimbSigns.PlaneSide(a.X, a.Y, a.Z, a.W, b.X, b.Y, b.Z, b.W));
+            }
+        }
+
+        // A common factor 2^k of the plane or of the point moves every operand across the limbs and keeps the sign;
+        // a negative factor reverses it.
+        [Fact]
+        public void PowersOfTwo_KeepTheSign()
+        {
+            var r = new Random(15);
+            for (int i = 0; i < 3000; ++i) {
+                BigInteger a = Rand(r, r.Next(1, 300)), b = Rand(r, r.Next(1, 300)), c = Rand(r, r.Next(1, 300)), d = Rand(r, r.Next(1, 500));
+                BigInteger x = Rand(r, r.Next(1, 700)), y = Rand(r, r.Next(1, 700)), z = Rand(r, r.Next(1, 700)), w = BigInteger.Abs(Rand(r, r.Next(1, 700)));
+                int sign = ExactLimbSigns.PlaneSide(a, b, c, d, x, y, z, w);
+                int k = r.Next(1, 200), j = r.Next(1, 200);
+                Assert.Equal(sign, ExactLimbSigns.PlaneSide(a << k, b << k, c << k, d << k, x << j, y << j, z << j, w << j));
+                Assert.Equal(-sign, ExactLimbSigns.PlaneSide(-(a << k), -(b << k), -(c << k), -(d << k), x, y, z, w));
+                var p0 = ExactPoint3.CreateUnreduced(x, y, z, w); var p1 = ExactPoint3.CreateUnreduced(a, b, c, w + 1); var p2 = ExactPoint3.CreateUnreduced(d, a, x, w + 2); var p3 = ExactPoint3.CreateUnreduced(y, d, b, w + 3);
+                int det = ExactLimbSigns.Det4(p0, p1, p2, p3);
+                Assert.Equal(det, ExactLimbSigns.Det4(ExactPoint3.CreateUnreduced(x << k, y << k, z << k, w << k), p1, p2, p3));
+            }
+        }
+
+#if NET
+        // On the stack: no allocation for operands inside the limit (the BigInteger expressions allocate every temporary).
+        [Fact]
+        public void InsideTheLimit_NoAllocation()
+        {
+            var r = new Random(16);
+            var cases = new List<BigInteger[]>();
+            for (int i = 0; i < 200; ++i) {
+                var v = new BigInteger[16];
+                for (int k = 0; k < 16; ++k) v[k] = Rand(r, r.Next(1, 900));
+                v[3] = BigInteger.Abs(v[3]) + 1; v[7] = BigInteger.Abs(v[7]) + 1; v[11] = BigInteger.Abs(v[11]) + 1; v[15] = BigInteger.Abs(v[15]) + 1;
+                cases.Add(v);
+            }
+            var pts = new List<ExactPoint3[]>();
+            foreach (var v in cases)
+                pts.Add(new[] { ExactPoint3.CreateUnreduced(v[0], v[1], v[2], v[3]), ExactPoint3.CreateUnreduced(v[4], v[5], v[6], v[7]), ExactPoint3.CreateUnreduced(v[8], v[9], v[10], v[11]), ExactPoint3.CreateUnreduced(v[12], v[13], v[14], v[15]) });
+            long sum = 0, allocated = 0;
+            for (int pass = 0; pass < 3; ++pass) {
+                long before = GC.GetAllocatedBytesForCurrentThread();
+                for (int i = 0; i < cases.Count; ++i) {
+                    var v = cases[i];
+                    sum += ExactLimbSigns.PlaneSide(v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+                    sum += ExactLimbSigns.Dot(v[0], v[1], v[2], v[4], v[5], v[6]);
+                    sum += ExactLimbSigns.Det4(pts[i][0], pts[i][1], pts[i][2], pts[i][3]);
+                }
+                allocated = GC.GetAllocatedBytesForCurrentThread() - before;
+            }
+            Assert.True(allocated == 0, $"{allocated} bytes allocated in {3 * cases.Count} calls (sum {sum})");
+        }
+#endif
+    }
+}
