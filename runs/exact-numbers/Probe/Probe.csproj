<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- a friend assembly name of the library (InternalsVisibleTo), so the probe reads PredicateStats -->
    <AssemblyName>BooleanComparison</AssemblyName>
    <RootNamespace>ExactNumbers</RootNamespace>
    <G3Root Condition="'$(G3Root)' == ''">/home/user/geometry3Sharp</G3Root>
    <DefineConstants Condition="'$(PathStats)' == 'true'">$(DefineConstants);PATHSTATS</DefineConstants>
    <DefineConstants Condition="'$(ProtoD)' == 'true'">$(DefineConstants);PROTOD</DefineConstants>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(G3Root)/geometry3Sharp_netstandard.csproj" />
  </ItemGroup>
</Project>
