+
+        /// <summary>
+        /// the sign of the determinant with the rows (v[i], v[j], v.W) of a, b, c: on stack limbs
+        /// (docs/design/EXACT_LIMB_SIGNS.md), beyond their stack limit the BigInteger determinant
+        /// </summary>
+        [MethodImpl(JitHints.Optimize)]
+        internal static int orient_exact(ExactPoint3 a, ExactPoint3 b, ExactPoint3 c, int i, int j)
+        {
+            int sign;
+            if (ExactLimbSigns.Orient2(a, b, c, i, j, out sign) == false)
+                sign = ExactPoint3.Det3(a[i], a[j], a.W, b[i], b[j], b.W, c[i], c[j], c.W).Sign;
+            return sign;
+        }
+
+        /// <summary>
+        /// the sign of the in-circle determinant of p, q, r against d in the axes i, j (the rows of incircle_row): on
+        /// stack limbs, beyond their stack limit with BigInteger rows
+        /// </summary>
+        [MethodImpl(JitHints.Optimize)]
+        internal static int incircle_exact(ExactPoint3 p, ExactPoint3 q, ExactPoint3 r, ExactPoint3 d, int i, int j)
+        {
+            int sign;
+            if (ExactLimbSigns.InCircle(p, q, r, d, i, j, out sign) == false)
+                sign = incircle_big(p, q, r, d, i, j);
+            return sign;
         }
 
