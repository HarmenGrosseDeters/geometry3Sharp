+                Assert.Equal(w[2] == 1, CheckOrientPath(stack, used, v[0], v[1], v[2], 0, 1, $"orient, row {w[0]} of {w[1]} limbs"));
+                Assert.Equal(StackLimbs && w[2] == 1, stack);
+                Assert.Equal(OrientBig(v[0], v[1], v[2], 0, 1), Orient(v[0], v[1], v[2], 0, 1));
+            }
+            // InCircle, points of 17 limbs with the first one (24, e, 17): 4608 limbs in all for e = 10, 4609 for 11
+            foreach (int e in new[] { 10, 11 }) {
+                ExactPoint3 p = Wide(24, e, 17, 0), q = Wide(17, 17, 17, 1), r = Wide(17, 17, 17, 2), d = Wide(17, 17, 17, 3);
+                bool stack = ExactLimbSigns.InCircle(p, q, r, d, 0, 1, out sign, out used);
