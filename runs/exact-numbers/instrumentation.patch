+// LOCAL INSTRUMENTATION of the exact-number study (runs/exact-numbers); not library code.
+using System;
+using System.Diagnostics;
+using System.Threading;
+
+namespace g3
+{
+    /// <summary> per exact path: calls and Stopwatch ticks (all threads), and an optional record of the arguments </summary>
+    internal static class PathStats
+    {
+        internal enum P
+        {
+            O2Adaptive, O2BigInt, O3Int, O3Adaptive, O3BigInt, IcAdaptive, IcBigInt, InSphereCall, InSphereBigInt,
+            ArrOrientFixed, ArrOrientBig, ArrInCircleFixed, ArrInCircleBig, ArrAlongFixed, ArrAlongBig, ArrCompareFixed, ArrCompareBig,
+            ArrExactPoint, ArrPlanes, ArrLocalGet, BoolSideBig, BoolOrient3dBig, BoolCentroid, BoolPairAroundEdge, ArrSamePlane, ArrEdgePlanes, Slot23, PtFixed, PtBox,
+            ArrPtInput, ArrPtEdge, ArrPtSegments, ArrPtPlanes, ArrPtReduce, ArrPtPublish, ArrToExactOutside, ArrToExactInside,
+            Count
+        }
+        internal static readonly string[] Names = new string[(int)P.Count] {
+            "o2.adaptive", "o2.bigint", "o3.int", "o3.adaptive", "o3.bigint", "ic.adaptive", "ic.bigint", "insphere.call", "insphere.bigint",
+            "arr.orient.fixed", "arr.orient.big", "arr.incircle.fixed", "arr.incircle.big", "arr.along.fixed", "arr.along.big", "arr.compare.fixed", "arr.compare.big",
+            "arr.exact_point.big", "arr.planes", "arr.local_get.big", "bool.side.big", "bool.orient3d.big", "bool.centroid.big", "bool.pair_around_edge.big", "arr.same_plane.big", "arr.edge_planes.big", "calib", "pt.fixed", "pt.box",
+            "arr.pt.input", "arr.pt.edge", "arr.pt.segments", "arr.pt.planes", "arr.pt.reduce", "arr.pt.publish", "arr.to_exact.outside", "arr.to_exact.inside" };
+        static readonly long[] c = new long[16 * (int)P.Count];
+        internal static bool On = Environment.GetEnvironmentVariable("EXACT_TIMERS") != "0";
+
+        [ThreadStatic] static int depth;
+        [ThreadStatic] static long bytes0;
+        // exclusive regions: only the outermost region of a thread is timed (a nested one returns 0 and records nothing)
+        internal static long T() { if (On == false) return 0; if (depth++ > 0) return 0; bytes0 = GC.GetAllocatedBytesForCurrentThread(); return Stopwatch.GetTimestamp(); }
+        internal static void AddValue(P p, long v) { Interlocked.Increment(ref c[16 * (int)p]); Interlocked.Add(ref c[16 * (int)p + 2], v); }
+        internal static long Bytes(int p) { return Interlocked.Read(ref c[16 * p + 2]); }
+        internal static int TS(long t0, System.Numerics.BigInteger v) { Add(P.BoolSideBig, t0); return v.Sign; }
+        // ---- how close the exact stages are (an upper bound for intermediate-precision filters): per class a histogram of
+        // gap = (bits of the natural scale of the expression) - (bits of its exact value); bucket 0: exactly zero,
+        // bucket 1 + gap / 8 otherwise (the last bucket: 616 bits and more) ----
+        internal static bool HistOn;
+        internal const int HistClasses = 6, HistBuckets = 80;
+        internal static readonly string[] HistNames = { "bool.side.big", "bool.orient3d.big", "arr.orient.big", "arr.incircle.big", "arr.orient.fixed", "arr.incircle.fixed" };
+        internal static readonly long[] hist = new long[HistClasses * HistBuckets];
+        internal static void Hist(int cls, long valueBits, long scaleBits)
+        {
+            int b = 0;
+            if (valueBits > 0) b = 1 + (int)Math.Min(HistBuckets - 2, Math.Max(0, scaleBits - valueBits) / 8);
+            Interlocked.Increment(ref hist[cls * HistBuckets + b]);
+        }
+        internal static long B(System.Numerics.BigInteger v) { return (long)v.GetBitLength(); }
+        internal static long Mx(long a, long b, long c) { return Math.Max(a, Math.Max(b, c)); }
+        internal static long Mx(long a, long b, long c, long d) { return Math.Max(Math.Max(a, b), Math.Max(c, d)); }
+        internal static int TS(long t0, System.Numerics.BigInteger v, long scaleBits)
+        {
+            Add(P.BoolSideBig, t0);
+            if (HistOn) Hist(0, B(v), scaleBits);
+            return v.Sign;
+        }
+        internal static int TSI(long t0, int sign) { Add(P.BoolSideBig, t0); return sign; }
+        internal static void Add(P p, long t0)
+        {
+            if (On == false) return;
+            --depth;
+            if (t0 == 0) return;
+            long dt = Stopwatch.GetTimestamp() - t0;
+            Interlocked.Increment(ref c[16 * (int)p]);
+            Interlocked.Add(ref c[16 * (int)p + 1], dt);
+            Interlocked.Add(ref c[16 * (int)p + 2], GC.GetAllocatedBytesForCurrentThread() - bytes0);
+        }
+        // a sub-region of an outermost region (not exclusive): ticks and bytes since the marks
+        internal static long Mark(out long bytes) { bytes = GC.GetAllocatedBytesForCurrentThread(); return Stopwatch.GetTimestamp(); }
+        internal static void AddSub(P p, long t0, long b0)
+        {
+            Interlocked.Increment(ref c[16 * (int)p]);
+            Interlocked.Add(ref c[16 * (int)p + 1], Stopwatch.GetTimestamp() - t0);
+            Interlocked.Add(ref c[16 * (int)p + 2], GC.GetAllocatedBytesForCurrentThread() - b0);
+        }
+        internal static bool InRegion { get { return depth > 0; } }
+        internal static void Count1(P p) { Interlocked.Increment(ref c[16 * (int)p]); }
+        internal static long Calls(int p) { return Interlocked.Read(ref c[16 * p]); }
+        internal static double Ms(int p) { return Interlocked.Read(ref c[16 * p + 1]) * 1000.0 / Stopwatch.Frequency; }
