+            for (int i = 0; i < n; ++i) { long t0 = T(); Add(P.Slot23, t0); }
+            depth = 0;
+            double ns = (Stopwatch.GetTimestamp() - t) * 1e9 / Stopwatch.Frequency / n;
+            Array.Copy(save, c, c.Length);
+            return ns;
+        }
+
+        // ---- argument record: kind, then the coordinates (doubles), for the micro benchmarks ----
+        internal static double[] Rec;       // [RecStride * i]: kind, 15 values
+        internal const int RecStride = 16;
+        static int recN;
+        internal static int RecCount { get { return Math.Min(recN, Rec == null ? 0 : Rec.Length / RecStride); } }
+        internal static int Every = 1;
+        static int seen;
+        internal static void StartRecord(int n, int every) { Every = every; seen = 0; recN = 0; Rec = new double[RecStride * n]; }
+        internal static void Record(int kind, ReadOnlySpan<double> v)
+        {
+            double[] r = Rec;
+            if (r == null) return;
