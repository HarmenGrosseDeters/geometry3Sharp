+// LOCAL PROTOTYPE (exact-number study, candidate B probe; not library code): the classification's BigInteger sign stages
+// (plane side, normal dot, orient3d of four homogeneous points) on stack limbs with FixedArith, the operands loaded from
+// their BigInteger storage per call. The same integers, so the same signs. EXACT_PROTO contains "limbs".
+using System;
+using System.Numerics;
+using System.Runtime.CompilerServices;
+
+namespace g3
+{
+    internal static unsafe class LimbProto
+    {
+        internal static readonly bool On = (Environment.GetEnvironmentVariable("EXACT_PROTO") ?? "").Contains("limbs");
+        internal static readonly bool Check = (Environment.GetEnvironmentVariable("EXACT_PROTO") ?? "").Contains("check");
+        internal static long Mismatch;
+#if NET
+        const int MaxCap = 96;
+
+        static int cap(BigInteger v) { return (v.GetByteCount(false) + 7) >> 3; }
+
+        // the magnitude of v in dst (c limbs, c >= cap(v)) and its sign
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        static FixedInt load(BigInteger v, ulong* dst, int c)
+        {
+            int sign = v.Sign;
+            if (sign == 0) return new FixedInt(null, 0, false);
+            var s = new Span<byte>(dst, 8 * c);
+            s.Fill(sign < 0 ? (byte)0xFF : (byte)0);
+            int n;
+            v.TryWriteBytes(s, out n, false, false);
+            if (sign < 0) {
+                ulong carry = 1;
+                for (int k = 0; k < c; ++k) {
+                    ulong t = ~dst[k] + carry;
+                    carry = (carry != 0 && t == 0) ? 1UL : 0UL;
+                    dst[k] = t;
+                }
+            }
+            int len = c;
+            while (len > 0 && dst[len - 1] == 0) len--;
+            return new FixedInt(dst, len, sign < 0);
+        }
+
+        /// <summary> sign of a x + b y + c z - d w </summary>
+        [SkipLocalsInit]
+        internal static int Side(BigInteger a, BigInteger b, BigInteger c, BigInteger d, BigInteger x, BigInteger y, BigInteger z, BigInteger w)
+        {
+            int ca = cap(a), cb = cap(b), cc = cap(c), cd = cap(d), cx = cap(x), cy = cap(y), cz = cap(z), cw = cap(w);
+            int total = ca + cb + cc + cd + cx + cy + cz + cw;
+            if (total > 8 * MaxCap) return (a * x + b * y + c * z - d * w).Sign;
+            ulong* buf = stackalloc ulong[total + 1];
+            int scratch = 4 * total + 32;
+            ulong* sc = stackalloc ulong[scratch];
+            var ar = new FixedArena(sc, scratch);
+            ulong* p = buf;
+            FixedInt fa = load(a, p, ca); p += ca;
+            FixedInt fb = load(b, p, cb); p += cb;
+            FixedInt fc = load(c, p, cc); p += cc;
+            FixedInt fd = load(d, p, cd); p += cd;
+            FixedInt fx = load(x, p, cx); p += cx;
+            FixedInt fy = load(y, p, cy); p += cy;
+            FixedInt fz = load(z, p, cz); p += cz;
+            FixedInt fw = load(w, p, cw);
+            FixedInt r = FixedArith.Sub(FixedArith.Add(FixedArith.Add(FixedArith.Mul(fa, fx, ref ar), FixedArith.Mul(fb, fy, ref ar), ref ar),
+                FixedArith.Mul(fc, fz, ref ar), ref ar), FixedArith.Mul(fd, fw, ref ar), ref ar);
+            int sign = r.Sign;
+            if (Check && sign != (a * x + b * y + c * z - d * w).Sign) System.Threading.Interlocked.Increment(ref Mismatch);
+            return sign;
+        }
+
+        /// <summary> sign of a x + b y + c z </summary>
+        [SkipLocalsInit]
+        internal static int Dot(BigInteger a, BigInteger b, BigInteger c, BigInteger x, BigInteger y, BigInteger z)
+        {
+            int ca = cap(a), cb = cap(b), cc = cap(c), cx = cap(x), cy = cap(y), cz = cap(z);
+            int total = ca + cb + cc + cx + cy + cz;
+            if (total > 6 * MaxCap) return (a * x + b * y + c * z).Sign;
+            ulong* buf = stackalloc ulong[total + 1];
+            int scratch = 4 * total + 32;
+            ulong* sc = stackalloc ulong[scratch];
+            var ar = new FixedArena(sc, scratch);
+            ulong* p = buf;
+            FixedInt fa = load(a, p, ca); p += ca;
+            FixedInt fb = load(b, p, cb); p += cb;
+            FixedInt fc = load(c, p, cc); p += cc;
+            FixedInt fx = load(x, p, cx); p += cx;
+            FixedInt fy = load(y, p, cy); p += cy;
+            FixedInt fz = load(z, p, cz);
+            FixedInt r = FixedArith.Add(FixedArith.Add(FixedArith.Mul(fa, fx, ref ar), FixedArith.Mul(fb, fy, ref ar), ref ar), FixedArith.Mul(fc, fz, ref ar), ref ar);
+            int sign = r.Sign;
+            if (Check && sign != (a * x + b * y + c * z).Sign) System.Threading.Interlocked.Increment(ref Mismatch);
+            return sign;
+        }
+
+        static FixedInt det3(FixedInt a, FixedInt b, FixedInt c, FixedInt d, FixedInt e, FixedInt f, FixedInt g, FixedInt h, FixedInt i, ref FixedArena ar)
+        {
+            FixedInt t1 = FixedArith.Mul(a, FixedArith.Sub(FixedArith.Mul(e, i, ref ar), FixedArith.Mul(f, h, ref ar), ref ar), ref ar);
+            FixedInt t2 = FixedArith.Mul(b, FixedArith.Sub(FixedArith.Mul(d, i, ref ar), FixedArith.Mul(f, g, ref ar), ref ar), ref ar);
+            FixedInt t3 = FixedArith.Mul(c, FixedArith.Sub(FixedArith.Mul(d, h, ref ar), FixedArith.Mul(e, g, ref ar), ref ar), ref ar);
+            return FixedArith.Add(FixedArith.Sub(t1, t2, ref ar), t3, ref ar);
+        }
+
+        internal static readonly bool Centroids = (Environment.GetEnvironmentVariable("EXACT_PROTO") ?? "").Contains("centroid");
+        internal static long CentroidMismatch;
+
+        static BigInteger big(FixedInt v)
+        {
+            if (v.Len == 0) return BigInteger.Zero;
+            var r = new BigInteger(new ReadOnlySpan<byte>(v.P, 8 * v.Len), true, false);
+            return v.Neg ? -r : r;
+        }
+
+        /// <summary>
+        /// PROBE of candidate C: the unreduced centroid of three homogeneous points (ExactMeshBoolean.centroid_point with
+        /// canonical = false) with its arithmetic on stack limbs; only the four results become BigInteger. false: too wide
+        /// </summary>
+        [SkipLocalsInit]
+        internal static bool Centroid(ExactPoint3 a, ExactPoint3 b, ExactPoint3 c, out ExactPoint3 result)
+        {
+            result = default(ExactPoint3);
+            int* cp = stackalloc int[12];
+            cp[0] = cap(a.X); cp[1] = cap(a.Y); cp[2] = cap(a.Z); cp[3] = cap(a.W);
+            cp[4] = cap(b.X); cp[5] = cap(b.Y); cp[6] = cap(b.Z); cp[7] = cap(b.W);
+            cp[8] = cap(c.X); cp[9] = cap(c.Y); cp[10] = cap(c.Z); cp[11] = cap(c.W);
+            int total = 0, widest = 0;
+            for (int k = 0; k < 12; ++k) { total += cp[k]; if (cp[k] > widest) widest = cp[k]; }
+            if (widest > MaxCap) return false;
+            ulong* buf = stackalloc ulong[total + 1];
+            // three products of two W (2 w each), nine products of 3 w, six sums of at most 3 w + 2, and 3 a.W wbc (3 w + 1 twice)
+            int scratch = 60 * widest + 64;
+            ulong* sc = stackalloc ulong[scratch];
+            var ar = new FixedArena(sc, scratch);
+            FixedInt* m = stackalloc FixedInt[12];
+            ulong* p = buf;
+            m[0] = load(a.X, p, cp[0]); p += cp[0]; m[1] = load(a.Y, p, cp[1]); p += cp[1]; m[2] = load(a.Z, p, cp[2]); p += cp[2]; m[3] = load(a.W, p, cp[3]); p += cp[3];
+            m[4] = load(b.X, p, cp[4]); p += cp[4]; m[5] = load(b.Y, p, cp[5]); p += cp[5]; m[6] = load(b.Z, p, cp[6]); p += cp[6]; m[7] = load(b.W, p, cp[7]); p += cp[7];
+            m[8] = load(c.X, p, cp[8]); p += cp[8]; m[9] = load(c.Y, p, cp[9]); p += cp[9]; m[10] = load(c.Z, p, cp[10]); p += cp[10]; m[11] = load(c.W, p, cp[11]);
+            FixedInt wbc = FixedArith.Mul(m[7], m[11], ref ar), wac = FixedArith.Mul(m[3], m[11], ref ar), wab = FixedArith.Mul(m[3], m[7], ref ar);
+            ulong three = 3;
+            FixedInt f3 = new FixedInt(&three, 1, false);
+            FixedInt x = FixedArith.Add(FixedArith.Add(FixedArith.Mul(m[0], wbc, ref ar), FixedArith.Mul(m[4], wac, ref ar), ref ar), FixedArith.Mul(m[8], wab, ref ar), ref ar);
+            FixedInt y = FixedArith.Add(FixedArith.Add(FixedArith.Mul(m[1], wbc, ref ar), FixedArith.Mul(m[5], wac, ref ar), ref ar), FixedArith.Mul(m[9], wab, ref ar), ref ar);
+            FixedInt z = FixedArith.Add(FixedArith.Add(FixedArith.Mul(m[2], wbc, ref ar), FixedArith.Mul(m[6], wac, ref ar), ref ar), FixedArith.Mul(m[10], wab, ref ar), ref ar);
+            FixedInt w = FixedArith.Mul(FixedArith.Mul(f3, m[3], ref ar), wbc, ref ar);
+            result = ExactPoint3.CreateUnreduced(big(x), big(y), big(z), big(w));
+            return true;
+        }
+
+        /// <summary> sign of the 4x4 determinant of the rows (X, Y, Z, W) of a, b, c, d, as ExactMeshArrangement.Det4; 2: too wide </summary>
+        [SkipLocalsInit]
+        internal static int Det4(ExactPoint3 a, ExactPoint3 b, ExactPoint3 c, ExactPoint3 d)
+        {
+            int* cp = stackalloc int[16];
+            int total = 0, widest = 0;
+            cp[0] = cap(a.X); cp[1] = cap(a.Y); cp[2] = cap(a.Z); cp[3] = cap(a.W);
+            cp[4] = cap(b.X); cp[5] = cap(b.Y); cp[6] = cap(b.Z); cp[7] = cap(b.W);
+            cp[8] = cap(c.X); cp[9] = cap(c.Y); cp[10] = cap(c.Z); cp[11] = cap(c.W);
+            cp[12] = cap(d.X); cp[13] = cap(d.Y); cp[14] = cap(d.Z); cp[15] = cap(d.W);
+            for (int k = 0; k < 16; ++k) { total += cp[k]; if (cp[k] > widest) widest = cp[k]; }
+            if (widest > MaxCap) return 2;
+            ulong* buf = stackalloc ulong[total + 1];
+            int scratch = 160 * widest + 128;
+            ulong* sc = stackalloc ulong[scratch];
+            var ar = new FixedArena(sc, scratch);
+            FixedInt* m = stackalloc FixedInt[16];
+            ulong* p = buf;
+            m[0] = load(a.X, p, cp[0]); p += cp[0]; m[1] = load(a.Y, p, cp[1]); p += cp[1]; m[2] = load(a.Z, p, cp[2]); p += cp[2]; m[3] = load(a.W, p, cp[3]); p += cp[3];
+            m[4] = load(b.X, p, cp[4]); p += cp[4]; m[5] = load(b.Y, p, cp[5]); p += cp[5]; m[6] = load(b.Z, p, cp[6]); p += cp[6]; m[7] = load(b.W, p, cp[7]); p += cp[7];
+            m[8] = load(c.X, p, cp[8]); p += cp[8]; m[9] = load(c.Y, p, cp[9]); p += cp[9]; m[10] = load(c.Z, p, cp[10]); p += cp[10]; m[11] = load(c.W, p, cp[11]); p += cp[11];
+            m[12] = load(d.X, p, cp[12]); p += cp[12]; m[13] = load(d.Y, p, cp[13]); p += cp[13]; m[14] = load(d.Z, p, cp[14]); p += cp[14]; m[15] = load(d.W, p, cp[15]);
+            FixedInt det = new FixedInt(null, 0, false);
+            for (int col = 0; col < 4; ++col) {
+                int c0 = (col == 0) ? 1 : 0, c1 = (col <= 1) ? 2 : 1, c2 = (col <= 2) ? 3 : 2;
+                FixedInt minor = det3(m[4 + c0], m[4 + c1], m[4 + c2], m[8 + c0], m[8 + c1], m[8 + c2], m[12 + c0], m[12 + c1], m[12 + c2], ref ar);
+                FixedInt term = FixedArith.Mul(m[col], minor, ref ar);
+                det = (col % 2 == 0) ? FixedArith.Add(det, term, ref ar) : FixedArith.Sub(det, term, ref ar);
+            }
+            return det.Sign;
+        }
+#else
+        internal static int Side(BigInteger a, BigInteger b, BigInteger c, BigInteger d, BigInteger x, BigInteger y, BigInteger z, BigInteger w) { return (a * x + b * y + c * z - d * w).Sign; }
+        internal static int Dot(BigInteger a, BigInteger b, BigInteger c, BigInteger x, BigInteger y, BigInteger z) { return (a * x + b * y + c * z).Sign; }
+        internal static int Det4(ExactPoint3 a, ExactPoint3 b, ExactPoint3 c, ExactPoint3 d) { return 2; }
+#endif
+    }
+}
