<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BooleanComparison</AssemblyName>
    <RootNamespace>FwnProbe</RootNamespace>
    <Nullable>disable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-*/**;bin-*/**</DefaultItemExcludes>
    <BaseIntermediateOutputPath>obj-$(Tag)\</BaseIntermediateOutputPath>
    <OutputPath>bin-$(Tag)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(G3Root)\geometry3Sharp_netstandard.csproj" />
  </ItemGroup>
</Project>
