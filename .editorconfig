# Analyzer scoping only; no formatting rules here.

# The checks of the exact-arithmetic code (CLAUDE.md, docs/QA.md 4a item 3):
#   RS0030   banned APIs (BannedSymbols.txt)
#   G3E0001  float (tools/analyzers/G3ExactCodeAnalyzers)
#   G3E0002  parallel loops outside the allow-list core/ExactCodeAllowList.cs
#   G3E0003  fused multiply-add
#   G3E0004  platform libm (Math.Sin, Cos, Atan2, Exp, Log, ...) in code that promises cross-platform bit identity
#   G3D0001-9 the closed world of a determinism proof scope (DeterministicApis.txt, docs/design/DETERMINISM_PROOF.md)
# off in general ...
[*.cs]
dotnet_diagnostic.RS0030.severity = none
dotnet_diagnostic.G3E0001.severity = none
dotnet_diagnostic.G3E0002.severity = none
dotnet_diagnostic.G3E0003.severity = none
dotnet_diagnostic.G3E0004.severity = none
dotnet_diagnostic.G3D0001.severity = none
dotnet_diagnostic.G3D0002.severity = none
dotnet_diagnostic.G3D0005.severity = none
dotnet_diagnostic.G3D0006.severity = none
dotnet_diagnostic.G3D0007.severity = none
dotnet_diagnostic.G3D0008.severity = none
dotnet_diagnostic.G3D0009.severity = none

# ... and errors in the exact-arithmetic code: the predicates (also the generated ones), the exact points (also in fixed width), the exact
# mesh pipeline and the exact parts it calls (ExactTriangulation2, ExactPlanarSimplify, ExactTriangleIntersection,
# TriangleTriangleFilter), the polyhedral envelope, the terrain slope design (TerrainSlope*: the oracle and the
# envelope, docs/design/TERRAIN_1A_PLAN.md), and the snap rounding grid (SnapRounding2: SnapGrid's exact tests and their double
# filters), and the exact tests of the contouring's topology certificate (ContouringTopologyCertificate)
[{comp_geom/SnapRounding2.cs,math/Exact*.cs,math/AdaptivePredicates.cs,math/FixedPoint3.cs,math/Generated/*.cs,mesh_ops/ExactMesh*.cs,mesh_ops/ExactTriangulation2.cs,mesh_ops/ExactPlanarSimplify.cs,mesh_ops/PolyhedralEnvelope.cs,intersection/ExactTriangleIntersection.cs,intersection/TriangleTriangleFilter.cs,intersection/ContinuousCollision.cs,mesh_ops/TerrainSlope*.cs,mesh_ops/ContouringTopologyCertificate.cs}]
dotnet_diagnostic.RS0030.severity = error
dotnet_diagnostic.G3E0001.severity = error
dotnet_diagnostic.G3E0002.severity = error
dotnet_diagnostic.G3E0003.severity = error

# The libm rule (docs/design/DETERMINISM.md): code that promises cross-platform bit identity calls the correctly rounded
# g3.CoreMathPort.CoreMath, not the platform's Math.Sin, Cos, Atan2, Exp, Log, ... (G3E0004). First the geodesic family;
# extended only where the determinism harness shows a difference that the result depends on: the terrain slope design
# (issue 802: the fan directions differed between the Windows CRT of .NET and the others).
[{mesh_ops/TerrainSlope*.cs,mesh_ops/IntrinsicTriangulation.cs,mesh_ops/IntrinsicTriangulationRefinement.cs,mesh_ops/IntrinsicCommonSubdivision.cs,mesh_ops/VectorHeatMethod.cs,mesh_ops/MeshGeodesicDistance.cs,mesh_ops/MeshGeodesicPath.cs,mesh_ops/MeshGeodesicBezier.cs,solvers/SparseCholesky.cs,math/CoreMath/*.cs}]
dotnet_diagnostic.G3E0004.severity = error

# The determinism proof, stage 0 (docs/design/DETERMINISM_PROOF.md section 6.1): the exact kernel is a closed world. Every
# member of another assembly that it uses is on the allow list DeterministicApis.txt with the reason why its result is
# specified on every runtime, and the environment-dependent constructs (#if, double -> integer casts, [SkipLocalsInit],
# restricted members) are registered there (G3D0001-9, tools/analyzers/G3ExactCodeAnalyzers/DeterminismAnalyzers.cs)
[{math/ExactIntervals.cs,math/ExactPoint3.cs,math/ExactPredicates.cs,math/ExactRayTriangle.cs,math/ExactSlopeKernel.cs,math/ExactSlopePredicates.cs,math/AdaptivePredicates.cs,math/FixedPoint3.cs,math/Generated/IndirectPredicates.cs,intersection/ExactTriangleIntersection.cs,intersection/TriangleTriangleFilter.cs}]
dotnet_diagnostic.G3D0001.severity = error
dotnet_diagnostic.G3D0002.severity = error
dotnet_diagnostic.G3D0005.severity = error
dotnet_diagnostic.G3D0006.severity = error
dotnet_diagnostic.G3D0007.severity = error
dotnet_diagnostic.G3D0008.severity = error
dotnet_diagnostic.G3D0009.severity = error
