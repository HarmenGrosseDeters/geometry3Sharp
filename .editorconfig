# Analyzer scoping only; no formatting rules here.

# The checks of the exact-arithmetic code (CLAUDE.md, docs/QA.md 4a item 3):
#   RS0030   banned APIs (BannedSymbols.txt)
#   G3E0001  float (tools/analyzers/G3ExactCodeAnalyzers)
#   G3E0002  parallel loops outside the allow-list core/ExactCodeAllowList.cs
#   G3E0003  fused multiply-add
# off in general ...
[*.cs]
dotnet_diagnostic.RS0030.severity = none
dotnet_diagnostic.G3E0001.severity = none
dotnet_diagnostic.G3E0002.severity = none
dotnet_diagnostic.G3E0003.severity = none

# ... and errors in the exact-arithmetic code: the predicates, the exact points (also in fixed width), the exact
# mesh pipeline and the exact parts it calls (ExactTriangulation2, ExactPlanarSimplify, ExactTriangleIntersection)
[{math/Exact*.cs,math/AdaptivePredicates.cs,math/FixedPoint3.cs,mesh_ops/ExactMesh*.cs,mesh_ops/ExactTriangulation2.cs,mesh_ops/ExactPlanarSimplify.cs,intersection/ExactTriangleIntersection.cs}]
dotnet_diagnostic.RS0030.severity = error
dotnet_diagnostic.G3E0001.severity = error
dotnet_diagnostic.G3E0002.severity = error
dotnet_diagnostic.G3E0003.severity = error
