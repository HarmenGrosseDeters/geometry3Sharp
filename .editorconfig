# Analyzer scoping only; no formatting rules here.

# The checks of the exact-arithmetic code (CLAUDE.md, docs/QA.md 4a item 3):
#   RS0030   banned APIs (BannedSymbols.txt)
#   G3E0001  float (tools/analyzers/G3ExactCodeAnalyzers)
#   G3E0002  parallel loops outside the allow-list core/ExactCodeAllowList.cs
#   G3E0003  fused multiply-add
#   G3E0004  platform libm (Math.Sin, Cos, Atan2, Exp, Log, ...) in code that promises cross-platform bit identity
#   G3D0001-9 the closed world of a determinism proof scope (DeterministicApis.txt, docs/design/DETERMINISM_PROOF.md)
# off in general ...
[*.cs]
dotnet_diagnostic.RS0030.severity = none
dotnet_diagnostic.G3E0001.severity = none
dotnet_diagnostic.G3E0002.severity = none
dotnet_diagnostic.G3E0003.severity = none
dotnet_diagnostic.G3E0004.severity = none
dotnet_diagnostic.G3D0001.severity = none
dotnet_diagnostic.G3D0002.severity = none
dotnet_diagnostic.G3D0005.severity = none
dotnet_diagnostic.G3D0006.severity = none
dotnet_diagnostic.G3D0007.severity = none
dotnet_diagnostic.G3D0008.severity = none
dotnet_diagnostic.G3D0009.severity = none
# Missing XML comments stay off by default (trivial POD/math types need no boilerplate) and are enabled below for
# documented non-trivial fork modules.
dotnet_diagnostic.CS1591.severity = none

# ... and errors in the exact-arithmetic code: the predicates (also the generated ones), the exact points (also in fixed width), the exact
# mesh pipeline and the exact parts it calls (ExactTriangulation2, ExactPlanarSimplify, ExactTriangleIntersection,
# TriangleTriangleFilter), the certified determinant and point-mesh distance bounds (queries/CertifiedDet3.cs, queries/CertifiedPointMeshDistance.cs), the polyhedral envelope, the terrain slope design (TerrainSlope*: the oracle and the
# envelope, docs/design/TERRAIN_1A_PLAN.md), and the snap rounding grid (SnapRounding2: SnapGrid's exact tests and their double
# filters), and the exact tests of the contouring's topology certificate (ContouringTopologyCertificate)
[{comp_geom/SnapRounding2.cs,queries/CertifiedDet3.cs,queries/CertifiedPointMeshDistance.cs,intersection/IntrExactBox3.cs,math/Exact*.cs,math/AdaptivePredicates.cs,math/FixedPoint3.cs,math/Generated/*.cs,mesh_ops/ExactMesh*.cs,mesh_ops/ExactTriangulation2.cs,mesh_ops/ExactPlanarSimplify.cs,mesh_ops/PolyhedralEnvelope.cs,intersection/ExactTriangleIntersection.cs,intersection/TriangleTriangleFilter.cs,intersection/ContinuousCollision.cs,mesh_ops/TerrainSlope*.cs,mesh_ops/ContouringTopologyCertificate.cs}]
dotnet_diagnostic.RS0030.severity = error
dotnet_diagnostic.G3E0001.severity = error
dotnet_diagnostic.G3E0002.severity = error
dotnet_diagnostic.G3E0003.severity = error

# The libm rule (docs/design/DETERMINISM.md): code that promises cross-platform bit identity calls the correctly rounded
# g3.CoreMathPort.CoreMath, not the platform's Math.Sin, Cos, Atan2, Exp, Log, ... (G3E0004). First the geodesic family;
# extended only where the determinism harness shows a difference that the result depends on: the terrain slope design
# (issue 802: the fan directions differed between the Windows CRT of .NET and the others), and the winding-number terms
# (issue 1577: the platform Math.Atan2 gave other repair meshes in WebAssembly; MathUtil.TriSolidAngle itself is not listed, it is a
# file of many other uses, its one atan2 is pinned by SolidAnglePlatformIndependenceTests), the TPMS field (#1682: its pinned hashes), and the quad remesher pipeline (#1713: a test whose extraction a 1-ulp change decides,
# QuadRemesherCrossingTests gear/18, failed on Windows).
[{mesh_ops/TerrainSlope*.cs,mesh_ops/IntrinsicTriangulation.cs,mesh_ops/IntrinsicTriangulationRefinement.cs,mesh_ops/IntrinsicCommonSubdivision.cs,mesh_ops/VectorHeatMethod.cs,mesh_ops/MeshGeodesicDistance.cs,mesh_ops/MeshGeodesicPath.cs,mesh_ops/MeshGeodesicBezier.cs,mesh_ops/ExactMeshGeodesicDistance.cs,mesh_ops/PolyhedralGeodesicDistance.cs,mesh_ops/PolyhedralGeodesicPath.cs,solvers/SparseCholesky.cs,solvers/CholeskyNestedDissection.cs,spatial/FastWindingLeafKernel.cs,spatial/ExactWindingCache.cs,mesh_generators/TpmsLatticeField.cs,mesh_ops/CrossField.cs,mesh_ops/PositionField.cs,mesh_ops/QuadRemesher.cs,mesh_ops/IntegrableFrames.cs,mesh_ops/MeshPrincipalCurvature.cs,math/CoreMath/*.cs}]
dotnet_diagnostic.G3E0004.severity = error

# The determinism proof, stages 0 and 1 (docs/design/DETERMINISM_PROOF.md section 6.1): the exact kernel and the exact building blocks
# (ExactTriangulation2, ExactPlanarSimplify, SnapRounding2, and TriangleBoxTree: ExactMeshArrangement.cs is named here, and the 'type' line of
# DeterministicApis.txt restricts it to that class), and the TPMS lattice field (mesh_generators/TpmsLatticeField.cs, section 5.6, #1682) are a closed world. Every
# member of another assembly that it uses is on the allow list DeterministicApis.txt with the reason why its result is
# specified on every runtime, and the environment-dependent constructs (#if, double -> integer casts, [SkipLocalsInit],
# restricted members) are registered there (G3D0001-9, tools/analyzers/G3ExactCodeAnalyzers/DeterminismAnalyzers.cs)
[{math/ExactIntervals.cs,math/ExactPoint3.cs,math/ExactPredicates.cs,math/ExactRayTriangle.cs,math/ExactSlopeKernel.cs,math/ExactSlopePredicates.cs,math/AdaptivePredicates.cs,math/FixedPoint3.cs,math/ExactLimbSigns.cs,math/ExactLimbPrepared.cs,math/Generated/IndirectPredicates.cs,math/Generated/DoublePredicates.cs,intersection/ExactTriangleIntersection.cs,intersection/TriangleTriangleFilter.cs,mesh_ops/ExactTriangulation2.cs,mesh_ops/ExactPlanarSimplify.cs,comp_geom/SnapRounding2.cs,mesh_ops/ExactMeshArrangement.cs,mesh_ops/ExactMeshArrangementRegions.cs,mesh_ops/ExactMeshBoolean.cs,mesh_generators/TpmsLatticeField.cs}]
dotnet_diagnostic.G3D0001.severity = error
dotnet_diagnostic.G3D0002.severity = error
dotnet_diagnostic.G3D0005.severity = error
dotnet_diagnostic.G3D0006.severity = error
dotnet_diagnostic.G3D0007.severity = error
dotnet_diagnostic.G3D0008.severity = error
dotnet_diagnostic.G3D0009.severity = error

# XML documentation ratchet (CS1591): keep documented non-trivial fork modules at 100% public-member XML coverage
# without forcing boilerplate comments onto trivial POD/math or legacy upstream types.
[{addons/geometry3Sharp.Clipper2/*.cs,comp_geom/ConstrainedDelaunayMesh2.cs,comp_geom/DelaunayKernel2*.cs,comp_geom/DelaunayMesh2.cs,comp_geom/PairKeys.cs,comp_geom/QualityMesh2.cs,comp_geom/SnapRounding2.cs,comp_geom/Triangulation2Result.cs,comp_geom/TriangulationMesh2.cs,io/ExactDecimal.cs,io/GLTFReader.cs,io/GLTFWriter.cs,io/HeightGridWriter.cs,io/MeshIOUtil.cs,io/MiniJson.cs,io/OFFReader.cs,io/PLYReader.cs,io/ShortestDecimal.cs,io/StandardMeshWriter.cs,io/ThreeMFReader.cs,io/ThreeMFWriter.cs,mesh_ops/AlphaSizeField.cs,mesh_ops/AlphaWrapEstimate.cs,mesh_ops/AlphaWrapFeaturePass.cs,mesh_ops/AlphaWrapOracle.cs,mesh_ops/AlphaWrapQualityPass.cs,mesh_ops/AutoHoleFill.cs,mesh_ops/ContouringTopologyCertificate.cs,mesh_ops/ExactMeshEdgeGroups.cs,mesh_ops/ExactMeshGeodesicDistance.cs,mesh_ops/ExactMeshResultBuilder.cs,mesh_ops/ExactPlanarSimplify.cs,mesh_ops/ExactTriangulation2.cs,mesh_ops/LazyExactMesh.cs,mesh_ops/MeshBoolean.cs,mesh_ops/MeshCurvature.cs,mesh_ops/MeshGeodesicDistance.cs,mesh_ops/MeshHausdorffDistance.cs,mesh_ops/MeshPostRepairCleanup.cs,mesh_ops/MeshPrincipalCurvature.cs,mesh_ops/MeshRobustRepairLostParts.cs,mesh_ops/MeshRobustRepairPassThrough.cs,mesh_ops/MeshScaleTolerance.cs,mesh_ops/MinimalHoleFill.cs,mesh_ops/PartitionedReducer.cs,mesh_ops/PartitionedReduction.cs,mesh_ops/PolyhedralEnvelope.cs,mesh_ops/QuadFlowRepair.cs,mesh_ops/RemeshSizing.cs,mesh_ops/TerrainInputRange.cs,mesh_ops/TerrainSlopeCatchLineBound.cs,mesh_ops/TerrainSlopeComposite.cs,mesh_ops/TerrainSlopeMap.cs,mesh_ops/TerrainSlopeRamps.cs,mesh_ops/TetFeatureSurface.cs,mesh_ops/TetMeshImprover.cs,mesh_ops/VolumeSampleCells.cs,mesh_ops/WindingContouring.cs}]
dotnet_diagnostic.CS1591.severity = warning

