+        // MinTriangleQuality, issue #621. At the rim of a flat cap (the rim a feature curve) a flip or collapse can create a
+        // side triangle with its corners on the rim (or two on it and one on the cap): it lies in the cap's plane, folded
+        // onto the cap, and overlaps the cap's triangles there without flipping a normal (the side faces sideways, the
+        // fold upwards, the cap downwards), so the normal checks pass it. Such a fold has two or more feature vertices
+        // (constrained to a curve or fixed), and the triangles it overlaps lie around its feature corners, facing against
+        // it. So the new triangles with two or more feature vertices are tested exactly (pair_intersects) against the
+        // triangles around their feature corners that face more than 120 degrees away, after the operation. The operation
+        // is rejected if it gives more such intersections than its old triangles had (an operation at an existing
+        // intersection, which the passes may still repair, is not blocked for it). The filters keep the exact tests to
+        // operations at feature curves.
+
+        bool is_feature_vertex(int vid) => vertex_is_constrained(vid);
+
+        // the flip of edge [a,b] (triangles t0, t1, opposite vertices c, d) creates a feature fold
+        bool flip_creates_feature_fold(int a, int b, int c, int d, int t0, int t1, double maxEdgeLen)
+        {
+            if (mesh.GetVertex(c).DistanceSquared(mesh.GetVertex(d)) > 16 * maxEdgeLen * maxEdgeLen)
+                return false;
+            int nFeature = (is_feature_vertex(c) ? 1 : 0) + (is_feature_vertex(d) ? 1 : 0);
+            if (nFeature == 0)
+                return false;       // both new triangles have fewer than two feature vertices
+            Index3i tri = mesh.GetTriangle(t0);
+            int oa = a, ob = b;
+            IndexUtil.orient_tri_edge(ref oa, ref ob, ref tri);
+            var n0 = new Index3i(c, d, ob);
+            var n1 = new Index3i(d, c, oa);
+            int after = 0;
+            if (nFeature + (is_feature_vertex(ob) ? 1 : 0) >= 2)
+                after += fold_count(n0, n1, t0, t1, -1, -1, -1, Vector3d.Zero, false);
+            if (nFeature + (is_feature_vertex(oa) ? 1 : 0) >= 2)
+                after += fold_count(n1, n0, t0, t1, -1, -1, -1, Vector3d.Zero, false);
+            if (after == 0)
+                return false;
+            Index3i o0 = mesh.GetTriangle(t0), o1 = mesh.GetTriangle(t1);
+            int before = fold_count(o0, o1, t0, t1, -1, -1, -1, Vector3d.Zero, true) + fold_count(o1, o0, t0, t1, -1, -1, -1, Vector3d.Zero, true);
+            return after > before;
+        }
+
+        // collapsing edge [a,b] (triangles t0, t1) to vKeep at newPos creates a feature fold. Only a collapse of a vertex
+        // that is not on a feature onto one that is (or onto a point of its curve): its triangles gain a feature vertex,
+        // the way a side triangle next to the rim gets all its corners on the rim. (A collapse along a curve or away from
+        // the curves leaves the number of feature vertices of each triangle as it was.)
+        bool collapse_creates_feature_fold(int a, int b, int vKeep, Vector3d newPos, int t0, int t1)
+        {
+            bool fa = is_feature_vertex(a), fb = is_feature_vertex(b);
+            if (fa == fb)
+                return false;
+            int v = fa ? b : a;         // the vertex that joins the feature
+            foldRing.Clear();
+            mesh.GetVtxTriangles(v, foldRing, true);
+            int after = 0;
+            foreach (int tid in foldRing) {
+                if (tid == t0 || tid == t1)
+                    continue;
+                Index3i t = mesh.GetTriangle(tid);
+                int nFeature = 1;       // vKeep
+                for (int i = 0; i < 3; ++i)
+                    if (t[i] != v && is_feature_vertex(t[i])) nFeature++;
+                if (nFeature >= 2) {
+                    Index3i mt = map_collapsed(t, a, b, vKeep);
+                    after += fold_count(mt, mt, t0, t1, a, b, vKeep, newPos, false);
+                }
+            }
+            if (after == 0)
+                return false;
+            int before = 0;
+            foreach (int tid in foldRing) {
+                Index3i t = mesh.GetTriangle(tid);
+                before += fold_count(t, t, -1, -1, -1, -1, -1, Vector3d.Zero, true);
+            }
+            return after > before;
+        }
+
+        // (scratch lists of the fold checks, which run in ProcessEdge, serially)
+        readonly List<int> foldRing = new List<int>(), foldNbrs = new List<int>(), foldSeen = new List<int>();
+
+        static Index3i map_collapsed(Index3i t, int a, int b, int vKeep)
+        {
+            if (a < 0)
+                return t;
+            if (t.a == a || t.a == b) t.a = vKeep;
+            if (t.b == a || t.b == b) t.b = vKeep;
+            if (t.c == a || t.c == b) t.c = vKeep;
+            return t;
+        }
+
+        Vector3d mapped_vertex(int v, int vKeep, Vector3d newPos) => (v == vKeep) ? newPos : mesh.GetVertex(v);
+
+        // the number of triangles that triangle nt (vertex ids after the operation) intersects and that face more than
+        // 120 degrees away from it: the other new triangle other (a flip; nt itself otherwise), and the current triangles
+        // around the feature corners of nt (all its corners if allCorners) other than nt, r0 and r1, with a and b
+        // collapsed to vKeep at newPos (a < 0: no collapse)
+        int fold_count(Index3i nt, Index3i other, int r0, int r1, int a, int b, int vKeep, Vector3d newPos, bool allCorners)
+        {
+            var T = new Triangle3d(mapped_vertex(nt.a, vKeep, newPos), mapped_vertex(nt.b, vKeep, newPos), mapped_vertex(nt.c, vKeep, newPos));
+            if (ExactTriangleIntersection.IsDegenerate(ref T))
+                return 0;       // (no orientation, and the metric skips it; collapse_creates_flat rejects new ones)
+            Vector3d nT = (T.V1 - T.V0).Cross(T.V2 - T.V0);
+            int count = 0;
+            if (other != nt) {
+                var O = new Triangle3d(mapped_vertex(other.a, vKeep, newPos), mapped_vertex(other.b, vKeep, newPos), mapped_vertex(other.c, vKeep, newPos));
+                if (faces_against(ref nT, ref O) && ExactTriangleIntersection.IsDegenerate(ref O) == false && pair_intersects(nt, ref T, other, ref O))
+                    count++;
+            }
+            foldSeen.Clear();
+            for (int i = 0; i < 3; ++i) {
+                int w = nt[i];
+                if (allCorners == false && w != vKeep && is_feature_vertex(w) == false)
+                    continue;       // (the triangles a fold overlaps lie at its feature corners)
+                for (int k = 0; k < 2; ++k) {
+                    int src = (w == vKeep) ? (k == 0 ? a : b) : (k == 0 ? w : -1);
+                    if (src < 0)
+                        continue;
+                    foldNbrs.Clear();
+                    mesh.GetVtxTriangles(src, foldNbrs, true);
+                    foreach (int tid in foldNbrs) {
+                        if (tid == r0 || tid == r1 || foldSeen.Contains(tid))
+                            continue;
+                        foldSeen.Add(tid);
+                        Index3i u = map_collapsed(mesh.GetTriangle(tid), a, b, vKeep);
+                        if (u == nt)
+                            continue;
+                        var U = new Triangle3d(mapped_vertex(u.a, vKeep, newPos), mapped_vertex(u.b, vKeep, newPos), mapped_vertex(u.c, vKeep, newPos));
+                        if (faces_against(ref nT, ref U) == false || ExactTriangleIntersection.IsDegenerate(ref U))
+                            continue;
+                        if (pair_intersects(nt, ref T, u, ref U))
+                            count++;
+                    }
+                }
+            }
+            return count;
+        }
+
+        // the triangle U faces more than 120 degrees away from the (unnormalized) normal nT. A fold lies on the cap facing
+        // against it (180 degrees); the side and the cap at a rim face 90..125 degrees apart for these cones and tapers.
+        // Cosine from unnormalized cross products: no absolute thresholds
+        static bool faces_against(ref Vector3d nT, ref Triangle3d U)
+        {
+            Vector3d nU = (U.V1 - U.V0).Cross(U.V2 - U.V0);
+            double dot = nT.Dot(nU);
+            return dot < 0 && dot * dot > 0.25 * nT.LengthSquared * nU.LengthSquared;
+        }
+
         // edge [a,b] with opposite vertices c and d (d may be invalid): a neighbouring triangle is flat
         bool has_flat_neighbour(ref Vector3d vA, ref Vector3d vB, int c, int d)
         {
