# Sharp-feature study probe patch (2026-11-12). Base commit: master 30099f659c8436a2f29e9ef001a9ec994b34097e.
# Apply with: git apply sharp-features/probe/kobbelt.patch   (probe only: never merge, not library code for a PR)
#
# CAVEAT (AABB vs exact): the accept test of K (Snap.Check, and Kobbelt.FlipOk) tests the new triangles against the INPUT with
# DMeshAABBTree3.TestIntersection, which is not exact, and lets a triangle pass that already hit the input before the move.
# The self-intersection tests are exact (ExactTriangleIntersection). The exact audit after the run (Hybrid.Crossings) found 0
# crossings of the input on 20 T1 + 6 procedural inputs for KA / KR, but a build must use the exact test (Reducer.KeepClearOf style).
# Also: the hook ProbeLocalAlphaF in mesh_ops/MeshAlphaWrap.cs (variants L / KL) is a probe of the gate test only; the wrap's
# termination and Steiner arguments are not re-derived for a varying alpha. Corners (Kobbelt.Run step 5) are refused in every case.
# Contents: Kobbelt.cs (K), EdgeClass.cs (class metric, miter lines), Hybrid.cs (WDC, stage statistics, exact crossing audit),
# Program.cs / Snap.cs (variants WDC, BS, KA, KR, KU, L, KL; A with the input kept clear), MeshAlphaWrap.cs (local alpha hook).
diff --git a/benchmarks/SharpFeatureProbe/EdgeClass.cs b/benchmarks/SharpFeatureProbe/EdgeClass.cs
new file mode 100644
index 0000000..84d0722
--- /dev/null
+++ b/benchmarks/SharpFeatureProbe/EdgeClass.cs
@@ -0,0 +1,166 @@
+// LOCAL PROBE (sharp-feature study 2026-11-12, never pushed): sharp-edge distances by crease class.
+// The input's sharp edges (dihedral > 30 degrees, as MeshFidelityMetrics) are split into convex and concave ones, and each is taken
+// twice: where it is ("in") and moved onto the miter line of the offset surface ("mi": edge + delta (n1 + n2) / (1 + n1.n2), the
+// intersection of the two face planes shifted outward by delta). For samples on them: the distance to the nearest sharp edge of the
+// result (clamped at 2 alpha), as a mean in offsets and as recall within 1 and 3 offsets (3 offsets = 0.1 % of the diagonal at 300 / 3000).
+// The other way (precision): samples on the result's sharp edges to the nearest input sharp edge (in / mi).
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using g3;
+
+static class EdgeClass
+{
+    public struct Seg { public Vector3d A, B; }
+
+    public class SegGrid
+    {
+        readonly Dictionary<long, List<int>> cells = new Dictionary<long, List<int>>();
+        readonly List<Seg> segs;
+        readonly double h; readonly Vector3d o;
+        public SegGrid(List<Seg> s, double cell, Vector3d origin)
+        {
+            segs = s; h = cell; o = origin;
+            for (int i = 0; i < s.Count; ++i) {
+                // rasterize along the segment in steps of half a cell
+                double len = s[i].A.Distance(s[i].B);
+                int n = Math.Max(1, (int)Math.Ceiling(len / (0.5 * h)));
+                long last = long.MinValue;
+                for (int k = 0; k <= n; ++k) {
+                    long key = Key(Vector3d.Lerp(s[i].A, s[i].B, (double)k / n));
+                    if (key == last) continue;
+                    last = key;
+                    if (!cells.TryGetValue(key, out var l)) cells[key] = l = new List<int>();
+                    if (l.Count == 0 || l[l.Count - 1] != i) l.Add(i);
+                }
+            }
+        }
+        long Key(Vector3d p) { return Key((int)Math.Floor((p.x - o.x) / h), (int)Math.Floor((p.y - o.y) / h), (int)Math.Floor((p.z - o.z) / h)); }
+        static long Key(int x, int y, int z) { return ((long)(x & 0x1FFFFF) << 42) | ((long)(y & 0x1FFFFF) << 21) | (long)(z & 0x1FFFFF); }
+        public double Nearest(Vector3d p, double maxDist)
+        {
+            int cx = (int)Math.Floor((p.x - o.x) / h), cy = (int)Math.Floor((p.y - o.y) / h), cz = (int)Math.Floor((p.z - o.z) / h);
+            double best = maxDist;
+            int maxRing = (int)Math.Ceiling(maxDist / h) + 1;
+            for (int ring = 0; ring <= maxRing; ++ring) {
+                if ((ring - 1) * h > best) break;
+                for (int x = -ring; x <= ring; ++x) for (int y = -ring; y <= ring; ++y) for (int z = -ring; z <= ring; ++z) {
+                    if (Math.Max(Math.Abs(x), Math.Max(Math.Abs(y), Math.Abs(z))) != ring) continue;
+                    if (!cells.TryGetValue(Key(cx + x, cy + y, cz + z), out var l)) continue;
+                    foreach (int i in l) {
+                        var sg = new Segment3d(segs[i].A, segs[i].B);
+                        double d = Math.Sqrt(sg.DistanceSquared(p));
+                        if (d < best) best = d;
+                    }
+                }
+            }
+            return best;
+        }
+    }
+
+    public static List<(Seg seg, Seg miter, bool convex)> InputCreases(DMesh3 m, double delta, double minHeight)
+    {
+        var list = new List<(Seg, Seg, bool)>();
+        foreach (int eid in m.EdgeIndices()) {
+            Index2i et = m.GetEdgeT(eid);
+            if (et.b == DMesh3.InvalidID) continue;
+            Vector3d n1 = m.GetTriNormal(et.a), n2 = m.GetTriNormal(et.b);
+            if (n1.LengthSquared < 0.5 || n2.LengthSquared < 0.5) continue;
+            double c = n1.Dot(n2);
+            if (c >= Math.Cos(30 * Math.PI / 180)) continue;
+            if (Height(m, et.a) < minHeight || Height(m, et.b) < minHeight) continue;
+            Index2i ev = m.GetEdgeV(eid);
+            Vector3d a = m.GetVertex(ev.a), b = m.GetVertex(ev.b);
+            // convex: the opposite vertex of the second triangle lies below the plane of the first
+            Index3i t2 = m.GetTriangle(et.b);
+            int opp = (t2.a != ev.a && t2.a != ev.b) ? t2.a : ((t2.b != ev.a && t2.b != ev.b) ? t2.b : t2.c);
+            bool convex = n1.Dot(m.GetVertex(opp) - a) < 0;
+            // miter shift; clamped at 4 offsets for nearly folded creases
+            Vector3d s = (n1 + n2) / Math.Max(1 + c, 0.25) * delta;
+            if (s.Length > 4 * delta) s *= 4 * delta / s.Length;
+            list.Add((new Seg { A = a, B = b }, new Seg { A = a + s, B = b + s }, convex));
+        }
+        return list;
+    }
+
+    static List<Seg> SharpEdges(DMesh3 m, double minHeight)
+    {
+        var list = new List<Seg>();
+        foreach (int eid in m.EdgeIndices()) {
+            Index2i et = m.GetEdgeT(eid);
+            if (et.b == DMesh3.InvalidID) continue;
+            Vector3d n1 = m.GetTriNormal(et.a), n2 = m.GetTriNormal(et.b);
+            if (n1.LengthSquared < 0.5 || n2.LengthSquared < 0.5) continue;
+            if (n1.Dot(n2) >= Math.Cos(30 * Math.PI / 180)) continue;
+            if (Height(m, et.a) < minHeight || Height(m, et.b) < minHeight) continue;
+            Index2i ev = m.GetEdgeV(eid);
+            list.Add(new Seg { A = m.GetVertex(ev.a), B = m.GetVertex(ev.b) });
+        }
+        return list;
+    }
+
+    static double Height(DMesh3 m, int tid)
+    {
+        Index3i t = m.GetTriangle(tid);
+        Vector3d a = m.GetVertex(t.a), b = m.GetVertex(t.b), c = m.GetVertex(t.c);
+        double area2 = (b - a).Cross(c - a).Length;
+        double maxEdge = Math.Max((b - a).Length, Math.Max((c - b).Length, (a - c).Length));
+        return maxEdge > 0 ? area2 / maxEdge : 0;
+    }
+
+    // points on the segments, stratified by length: n samples in total (deterministic)
+    static List<Vector3d> Sample(List<Seg> segs, int n)
+    {
+        var pts = new List<Vector3d>();
+        double total = 0;
+        foreach (Seg s in segs) total += s.A.Distance(s.B);
+        if (!(total > 0)) return pts;
+        double step = total / n, next = 0.5 * step, acc = 0;
+        foreach (Seg s in segs) {
+            double len = s.A.Distance(s.B);
+            while (next < acc + len) { pts.Add(Vector3d.Lerp(s.A, s.B, (next - acc) / len)); next += step; }
+            acc += len;
+        }
+        return pts;
+    }
+
+    static void Stats(List<Vector3d> pts, SegGrid grid, double delta, double clamp, string tag, Dictionary<string, object> r)
+    {
+        if (pts.Count == 0 || grid == null) { r[tag + "_n"] = pts.Count; return; }
+        double sum = 0; int w1 = 0, w3 = 0;
+        var ds = new double[pts.Count];
+        gParallel.ForEach(Interval1i.Range(pts.Count), (i) => { ds[i] = grid.Nearest(pts[i], clamp); });
+        foreach (double d in ds) { sum += d; if (d <= delta) w1++; if (d <= 3 * delta) w3++; }
+        r[tag + "_n"] = pts.Count;
+        r[tag + "_mean"] = sum / pts.Count / delta;
+        r[tag + "_w1"] = (double)w1 / pts.Count;
+        r[tag + "_w3"] = (double)w3 / pts.Count;
+    }
+
+    public static void Add(DMesh3 orientedInput, DMesh3 result, double alpha, double delta, Dictionary<string, object> r, int samples = 20000)
+    {
+        double size = orientedInput.CachedBounds.DiagonalLength;
+        double minH = 1e-5 * size, clamp = 2 * alpha;
+        var creases = InputCreases(orientedInput, delta, minH);
+        var res = SharpEdges(result, minH);
+        Vector3d origin = orientedInput.CachedBounds.Min - 4 * alpha * Vector3d.One;
+        double cell = Math.Max(alpha, 1e-12);
+        SegGrid resGrid = res.Count > 0 ? new SegGrid(res, cell, origin) : null;
+        double lenCvx = 0, lenCcv = 0;
+        foreach (var c in creases) { double l = c.seg.A.Distance(c.seg.B); if (c.convex) lenCvx += l; else lenCcv += l; }
+        r["ec_len_cvx"] = lenCvx / size; r["ec_len_ccv"] = lenCcv / size;
+        double lenRes = 0; foreach (Seg s in res) lenRes += s.A.Distance(s.B);
+        r["ec_len_res"] = lenRes / size;
+        foreach (bool convex in new[] { true, false }) {
+            string cls = convex ? "cvx" : "ccv";
+            Stats(Sample(creases.Where(c => c.convex == convex).Select(c => c.seg).ToList(), samples), resGrid, delta, clamp, "ec_" + cls + "_in", r);
+            Stats(Sample(creases.Where(c => c.convex == convex).Select(c => c.miter).ToList(), samples), resGrid, delta, clamp, "ec_" + cls + "_mi", r);
+        }
+        // precision: the result's sharp edges against the input's (all classes)
+        var resPts = Sample(res, samples);
+        if (creases.Count > 0) {
+            Stats(resPts, new SegGrid(creases.Select(c => c.seg).ToList(), cell, origin), delta, clamp, "ec_prec_in", r);
+            Stats(resPts, new SegGrid(creases.Select(c => c.miter).ToList(), cell, origin), delta, clamp, "ec_prec_mi", r);
+        }
+    }
+}
diff --git a/benchmarks/SharpFeatureProbe/Hybrid.cs b/benchmarks/SharpFeatureProbe/Hybrid.cs
new file mode 100644
index 0000000..e8a60ab
--- /dev/null
+++ b/benchmarks/SharpFeatureProbe/Hybrid.cs
@@ -0,0 +1,163 @@
+// LOCAL PROBE (sharp-feature study 2026-11-12, never pushed): hybrids of the wrap and dual contouring.
+//   WDC  dual contouring of the raw wrap's solid (signs and topology from the wrap), Hermite planes = the input's triangle planes
+//        shifted by one offset (the miter of the offset surface); then the pipeline's simplification
+//   BS   B by stage: the raw contour, after the cleanup, after the reduction; and the raw contour through the pipeline's simplification
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Linq;
+using g3;
+using gs;
+
+static class Hybrid
+{
+    class FI : ImplicitFunction3d
+    {
+        public WindingContouring Owner;
+        public double Value(ref Vector3d pt) { return Owner.Field(pt); }
+    }
+
+    public class WdcStats { public long OctreeMs, ContourMs; public int Cells, InputPlanes, WrapPlanes, NonManifold, FillIntersections; public bool SiFree; public int SiFound, SiLeft; }
+
+    static double EdgeLength(Vector3d a, Vector3d b) { return (b - a).Length; }
+
+    /// <summary>
+    /// signMesh: a closed mesh whose solid gives the node signs (the raw wrap, or the input for a plain offset contour);
+    /// shift: the Hermite planes are the input planes moved outward by this; maxPlaneDist: input triangles farther from the
+    /// crossing than this give no plane (the crossing keeps the sign mesh's own plane)
+    /// </summary>
+    public static DMesh3 Contour(DMesh3 signMesh, DMesh3 input, DMeshAABBTree3 inputTree, double h, double shift, double maxPlaneDist, WdcStats st,
+        bool useInputPlanes = true, double eigenTol = 0.1)
+    {
+        var sw = Stopwatch.StartNew();
+        var wc = new WindingContouring(new[] { signMesh }, null, 1.5);
+        var octree = new WindingNumberOctree(wc.Meshes, wc.Spatials, null) {
+            TargetLeafCellSize = h, WindingIso = 0.5, GridOffset = new Vector3d(0.1371, 0.2713, 0.3891)
+        };
+        octree.Build();
+        st.OctreeMs = sw.ElapsedMilliseconds; sw.Restart();
+        st.Cells = octree.SurfaceCells.Count;
+        var dc = new DualContouring() {
+            Implicit = new FI { Owner = wc }, IsoValue = 0.5, CellSize = octree.LeafCellSize,
+            Bounds = new AxisAlignedBox3d(octree.Origin, octree.Origin + octree.LeafCount * octree.LeafCellSize * Vector3d.One),
+            CandidateCells = octree.SurfaceCells, NodeValueF = octree.NodeValue, QEFEigenTolerance = eigenTol
+        };
+        int nIn = 0, nWrap = 0;
+        dc.HermiteF = (Vector3d a, Vector3d b, Vector3d p, out Vector3d point, out Vector3d normal) => {
+            Vector3d wp, wn;
+            bool ok = wc.Hermite(EdgeLength(a, b), a, b, p, out wp, out wn);
+            if (!ok) { wp = p; wn = Vector3d.Zero; }
+            if (useInputPlanes) {
+                double d2;
+                int tid = inputTree.FindNearestTriangle(wp, out d2, maxPlaneDist);
+                if (tid != DMesh3.InvalidID) {
+                    DistPoint3Triangle3 dist = MeshQueries.TriangleDistance(input, tid, wp);
+                    Vector3d q = dist.TriangleClosest;
+                    Vector3d n = BestFacingNormal(input, tid, q, wp, dist);
+                    if (n.LengthSquared > 0.5) {
+                        double s = (wp - q).Dot(n);
+                        if (s > 0) {
+                            point = wp - (s - shift) * n; normal = n;
+                            System.Threading.Interlocked.Increment(ref nIn);
+                            return true;
+                        }
+                    }
+                }
+            }
+            System.Threading.Interlocked.Increment(ref nWrap);
+            point = wp; normal = wn;
+            return ok;
+        };
+        dc.Generate();
+        st.InputPlanes = nIn; st.WrapPlanes = nWrap;
+        if (dc.Mesh == null) return null;
+        st.NonManifold = dc.NonManifoldTriangles;
+        st.SiFound = dc.SelfIntersectionsFound; st.SiLeft = dc.SelfIntersectionsLeft;
+        st.SiFree = WindingContouring.FinishHoles(dc.Mesh, dc.NonManifoldTriangles, dc.SelfIntersectionFree, out st.FillIntersections);
+        st.ContourMs = sw.ElapsedMilliseconds;
+        return dc.Mesh;
+    }
+
+    // the normal of the input triangle at the closest point q; where q lies on an edge or a vertex of the triangle (a crease), the
+    // triangle around q whose normal points most toward wp (so the two faces of a convex crease both give planes, by the side the
+    // crossing is on)
+    public static Vector3d BestFacingNormal(DMesh3 input, int tid, Vector3d q, Vector3d wp, DistPoint3Triangle3 dist)
+    {
+        Vector3d n = input.GetTriNormal(tid);
+        Vector3d bc = dist.TriangleBaryCoords;
+        const double eps = 1e-9;
+        bool onBorder = bc.x < eps || bc.y < eps || bc.z < eps;
+        if (!onBorder) return n;
+        Vector3d dir = wp - q; double len = dir.Length;
+        if (!(len > 0)) return n;
+        dir /= len;
+        double best = n.Dot(dir); Vector3d bestN = n;
+        Index3i tv = input.GetTriangle(tid);
+        for (int k = 0; k < 3; ++k) {
+            if (bc[k] > 1 - eps || bc[(k + 1) % 3] > 1 - eps || bc[(k + 2) % 3] > 1 - eps) {
+                // at a vertex: all triangles around it
+                int v = bc.x > 1 - eps ? tv.a : (bc.y > 1 - eps ? tv.b : tv.c);
+                foreach (int t2 in input.VtxTrianglesItr(v)) {
+                    Vector3d n2 = input.GetTriNormal(t2);
+                    double s = n2.Dot(dir);
+                    if (n2.LengthSquared > 0.5 && s > best) { best = s; bestN = n2; }
+                }
+                return bestN;
+            }
+        }
+        for (int k = 0; k < 3; ++k) {
+            if (bc[k] < eps) {
+                int va = tv[(k + 1) % 3], vb = tv[(k + 2) % 3];
+                int eid = input.FindEdge(va, vb);
+                if (eid == DMesh3.InvalidID) continue;
+                Index2i et = input.GetEdgeT(eid);
+                int other = et.a == tid ? et.b : et.a;
+                if (other == DMesh3.InvalidID) continue;
+                Vector3d n2 = input.GetTriNormal(other);
+                double s = n2.Dot(dir);
+                if (n2.LengthSquared > 0.5 && s > best) { best = s; bestN = n2; }
+            }
+        }
+        return bestN;
+    }
+
+    public static void Angles(DMesh3 m, string tag, Dictionary<string, object> r)
+    {
+        var minA = new List<double>(); int lt05 = 0, gt170 = 0, lt5 = 0;
+        foreach (int tid in m.TriangleIndices()) {
+            Triangle3d t = Snap.Tri(m, tid);
+            double mn = Snap.MinAngle(t.V0, t.V1, t.V2), mx = Snap.MaxAngle(t.V0, t.V1, t.V2);
+            minA.Add(mn); if (mn < 0.5) lt05++; if (mn < 5) lt5++; if (mx > 170) gt170++;
+        }
+        minA.Sort();
+        r[tag + "_tris"] = m.TriangleCount;
+        r[tag + "_angle_min"] = minA.Count > 0 ? minA[0] : double.NaN;
+        r[tag + "_angle_p01"] = minA.Count > 0 ? minA[(int)(0.01 * (minA.Count - 1))] : double.NaN;
+        r[tag + "_lt05"] = lt05; r[tag + "_lt5"] = lt5; r[tag + "_gt170"] = gt170;
+    }
+
+    public static void Validity(DMesh3 m, string tag, Dictionary<string, object> r)
+    {
+        string nc = MeshRobustRepair.NotCleanReasons(m, true);
+        r[tag + "_not_clean"] = nc;
+        r[tag + "_si_pairs"] = MeshRepairMetrics.SelfIntersections(m);
+    }
+
+    /// <summary> exact count of the result's triangles that cross an input triangle </summary>
+    public static int Crossings(DMesh3 m, DMesh3 input, TriangleHashGrid grid)
+    {
+        int tCross = 0;
+        foreach (int tid in m.TriangleIndices()) {
+            Triangle3d t = Snap.Tri(m, tid);
+            bool cross = false;
+            grid.Query(Snap.Box(t), (it) => {
+                if (cross) return;
+                Triangle3d u = Snap.Tri(input, it);
+                if (ExactTriangleIntersection.IsDegenerate(ref u)) return;
+                if (ExactTriangleIntersection.Intersects(ref t, ref u)) cross = true;
+            });
+            if (cross) tCross++;
+        }
+        return tCross;
+    }
+}
diff --git a/benchmarks/SharpFeatureProbe/Kobbelt.cs b/benchmarks/SharpFeatureProbe/Kobbelt.cs
new file mode 100644
index 0000000..0aba963
--- /dev/null
+++ b/benchmarks/SharpFeatureProbe/Kobbelt.cs
@@ -0,0 +1,299 @@
+// LOCAL PROBE (sharp-feature study 2026-11-12, never pushed): feature recovery on the wrap in the manner of Kobbelt et al. 2001
+// (feature-sensitive surface extraction: a feature sample where the surface normals disagree, and edges along the feature), moved
+// from grid cells to the wrap's triangles:
+//   1. every vertex gets the plane of its nearest input triangle, shifted outward by one offset (the offset surface's face), and is
+//      moved onto it;
+//   2. an edge whose end planes differ by more than the crease angle crosses a crease: the crease point of the edge is the point of the
+//      two planes' intersection line closest to the edge's midpoint, accepted only near the miter line of an input sharp edge;
+//   3. a vertex with a crease point in the near third of one of its edges is moved onto that crease line (no sliver from a split there);
+//   4. the remaining crossing edges are split and the new vertex is moved to the crease point: two crossing edges of a triangle then
+//      give an edge along the crease, with no flip;
+//   5. a triangle whose three vertices lie on three different creases gets the corner (three planes) as a new vertex.
+// Every move passes the exact checks of variant C (Snap.Check: no self-intersection, no hit with the input, normal turn, angle floors,
+// distance to the input). Serial, fixed order, deterministic.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using g3;
+using gs;
+
+static class Kobbelt
+{
+    public class Options
+    {
+        public double CreaseAngle = 30;         // degrees between the end planes of a crossing edge
+        public double SnapFraction = 0.3;       // a crease point this near an end of its edge (share of the length) moves the end vertex
+        public double MaxMiterDistance = 1.0;   // the crease point lies within this many offsets of a miter line of the input
+        public double PlaneRadius = 1.5;        // alpha: input triangles farther than this give no plane
+        public bool Checks = true;              // false: the upper bound without the exact checks
+        public double MinAngleFloor = 10, MaxAngleCeiling = 150, MaxNormalTurn = 100, MinDistance = 0.9;
+        public bool Flips = true;
+    }
+
+    public class Stats { public int[] SplitBy = new int[6], SnapBy = new int[6], CornerBy = new int[6]; public int LastReason; public int PlaneMoves, PlaneRej, CreaseSnaps, CreaseSnapRej, Splits, SplitRej, CrossEdges, CrossInvalid, Corners, CornerRej, Flips; }
+
+    struct Label
+    {
+        public Vector3d N; public double D;     // plane N.x = D (shifted)
+        public int Kind;                        // 0: none, 1: face, 2: on a crease (N, D and N2, D2), 3: corner
+        public Vector3d N2; public double D2;
+    }
+
+    public static DMesh3 Run(DMesh3 wrap, DMesh3 input, DMeshAABBTree3 inputTree, double alpha, double delta, Options o, Stats st)
+    {
+        DMesh3 mesh = new DMesh3(wrap, true);
+        TriangleHashGrid grid = Snap.BuildGrid(mesh);
+        var so = new SnapOptions { MinDistance = o.MinDistance, MinAngleFloor = o.MinAngleFloor, MaxAngleCeiling = o.MaxAngleCeiling, MaxNormalTurn = o.MaxNormalTurn };
+        double cosTurn = Math.Cos(o.MaxNormalTurn * Math.PI / 180);
+        double cosCrease = Math.Cos(o.CreaseAngle * Math.PI / 180);
+        var sst = new SnapStats();
+        var ring = new List<int>(); var oldTris = new List<Triangle3d>(); var newTris = new List<Triangle3d>(); var ids = new List<Index3i>(); var removed = new HashSet<int>();
+
+        // the miter lines of the input's sharp edges
+        double size = input.CachedBounds.DiagonalLength;
+        var creases = EdgeClass.InputCreases(input, delta, 1e-5 * size);
+        var miterGrid = creases.Count > 0 ? new EdgeClass.SegGrid(creases.Select(c => c.miter).ToList(), Math.Max(alpha, 1e-12), input.CachedBounds.Min - 4 * alpha * Vector3d.One) : null;
+        if (miterGrid == null) return mesh;
+
+        var labels = new Dictionary<int, Label>();
+        Func<int, Label> label = (vid) => {
+            Label l;
+            if (labels.TryGetValue(vid, out l)) return l;
+            l = MakeLabel(mesh.GetVertex(vid), input, inputTree, delta, o.PlaneRadius * alpha);
+            labels[vid] = l;
+            return l;
+        };
+
+        Func<int, Vector3d, bool> tryMove = (vid, x) => {
+            ring.Clear(); mesh.GetVtxTriangles(vid, ring, true);
