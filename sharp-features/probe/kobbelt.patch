+            Triangle3d T = pair.Item1; Index3i I = pair.Item2;
+            grid.Query(Snap.Box(T), (tc) => {
+                if (hit || tc == et.a || tc == et.b || !mesh.IsTriangle(tc)) return;
+                Index3i ic = mesh.GetTriangle(tc);
+                Triangle3d Cc = Snap.Tri(mesh, tc);
+                if (ExactTriangleIntersection.IsDegenerate(ref Cc)) return;
+                if (ExactTriangleIntersection.IntersectsBeyondShared(I, ref T, ic, ref Cc)) hit = true;
+            });
+            if (hit) return false;
+        }
+        return true;
+    }
+
+    static void AddPlane(List<(Vector3d n, double d)> planes, Vector3d n, double d)
+    {
+        foreach (var p in planes) if (p.n.Dot(n) > 0.985 && Math.Abs(p.d - d) < 1e-6 * (1 + Math.Abs(d))) return;
+        planes.Add((n, d));
+    }
+
+    static Label MakeLabel(Vector3d v, DMesh3 input, DMeshAABBTree3 tree, double delta, double maxDist)
+    {
+        double d2;
+        int tid = tree.FindNearestTriangle(v, out d2, maxDist);
+        if (tid == DMesh3.InvalidID) return new Label { Kind = 0 };
+        DistPoint3Triangle3 dist = MeshQueries.TriangleDistance(input, tid, v);
+        Vector3d q = dist.TriangleClosest;
+        Vector3d n = Hybrid.BestFacingNormal(input, tid, q, v, dist);
+        if (n.LengthSquared < 0.5 || n.Dot(v - q) <= 0) return new Label { Kind = 0 };
+        return new Label { Kind = 1, N = n, D = n.Dot(q) + delta };
+    }
+
+    // the point of the intersection line of the two planes closest to p
+    static bool CreasePoint(Label a, Label b, Vector3d p, out Vector3d x)
+    {
+        double c = a.N.Dot(b.N);
+        double det = 1 - c * c;
+        x = p;
+        if (!(det > 1e-6)) return false;
+        double r1 = a.D - a.N.Dot(p), r2 = b.D - b.N.Dot(p);
+        double c1 = (r1 - c * r2) / det, c2 = (r2 - c * r1) / det;
+        x = p + c1 * a.N + c2 * b.N;
+        return true;
+    }
+
+    static bool Corner(List<(Vector3d n, double d)> pl, out Vector3d x)
+    {
+        Vector3d n0 = pl[0].n, n1 = pl[1].n, n2 = pl[2].n;
+        double det = n0.Dot(n1.Cross(n2));
+        x = Vector3d.Zero;
+        if (Math.Abs(det) < 1e-3) return false;
+        x = (pl[0].d * n1.Cross(n2) + pl[1].d * n2.Cross(n0) + pl[2].d * n0.Cross(n1)) / det;
+        return true;
+    }
+}
