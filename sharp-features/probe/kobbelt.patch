+            if (Snap.MaxAngle(t.V0, t.V1, t.V2) > Math.Max(maxOld, o.MaxAngleCeiling) + 1e-9) return false;
+            // the new normals stay within the turn limit of both old ones
+            Vector3d u = nn.Normalized;
+            double c = Math.Cos(o.MaxNormalTurn * Math.PI / 180);
+            if (u.Dot(o1.Normal) < c || u.Dot(o2.Normal) < c) return false;
+            if (inputTree.TestIntersection(t)) return false;
+        }
