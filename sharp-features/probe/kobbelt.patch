+            if (la.Kind != 1) continue;
+            Vector3d a = mesh.GetVertex(vid);
+            double bestD = double.MaxValue; Vector3d bestX = a; Label bestOther = default(Label);
+            foreach (int nb in mesh.VtxVerticesItr(vid)) {
