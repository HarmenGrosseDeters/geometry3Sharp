+
+    static bool FlipOk(DMesh3 mesh, TriangleHashGrid grid, Index2i et, Index2i ev, Index2i ov, Vector3d A, Vector3d B, Vector3d C, Vector3d D,
+        DMesh3 input, DMeshAABBTree3 inputTree, Options o)
+    {
+        // orientation of triangle et.a
+        Index3i ta = mesh.GetTriangle(et.a);
+        int ia = IndexUtil.find_tri_index(ev.a, ta);
+        bool abOrder = ta[(ia + 1) % 3] == ev.b;       // (a, b, c) is et.a's order
+        Triangle3d n1 = abOrder ? new Triangle3d(C, D, B) : new Triangle3d(D, C, B);
+        Triangle3d n2 = abOrder ? new Triangle3d(D, C, A) : new Triangle3d(C, D, A);
+        Index3i i1 = abOrder ? new Index3i(ov.a, ov.b, ev.b) : new Index3i(ov.b, ov.a, ev.b);
+        Index3i i2 = abOrder ? new Index3i(ov.b, ov.a, ev.a) : new Index3i(ov.a, ov.b, ev.a);
+        Triangle3d o1 = Snap.Tri(mesh, et.a), o2 = Snap.Tri(mesh, et.b);
+        double minOld = Math.Min(Snap.MinAngle(o1.V0, o1.V1, o1.V2), Snap.MinAngle(o2.V0, o2.V1, o2.V2));
+        double maxOld = Math.Max(Snap.MaxAngle(o1.V0, o1.V1, o1.V2), Snap.MaxAngle(o2.V0, o2.V1, o2.V2));
+        foreach (Triangle3d t in new[] { n1, n2 }) {
+            Vector3d nn = (t.V1 - t.V0).Cross(t.V2 - t.V0);
+            if (!(nn.Length > 1e-12 * (t.V1 - t.V0).LengthSquared)) return false;
