+        foreach (int eid in cross) {
+            if (!mesh.IsEdge(eid)) continue;
+            Index2i ev = mesh.GetEdgeV(eid);
+            Label la = label(ev.a), lb = label(ev.b);
+            if (!(la.Kind == 1 && lb.Kind == 1 && la.N.Dot(lb.N) < cosCrease)) continue;
+            Vector3d a = mesh.GetVertex(ev.a), b = mesh.GetVertex(ev.b);
+            Vector3d m;
+            if (!CreasePoint(la, lb, 0.5 * (a + b), out m) || miterGrid.Nearest(m, 2 * alpha) > o.MaxMiterDistance * delta) { st.CrossInvalid++; continue; }
+            Index2i et = mesh.GetEdgeT(eid);
+            if (o.Checks && et.b != DMesh3.InvalidID) {
+                // the angle floors against the two triangles before the split (the midpoint triangles are no reference)
+                Index2i ovv = mesh.GetEdgeOpposingV(eid);
+                Vector3d c = mesh.GetVertex(ovv.a), d = mesh.GetVertex(ovv.b);
