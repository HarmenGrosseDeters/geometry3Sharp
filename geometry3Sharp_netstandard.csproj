<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.1.0</Version>
    <!-- fixed, so that CI versions (-p:Version=1.0.0-ci.N) also stay above the upstream assembly version 1.0.324.0:
         .NET (Core) refuses to load an assembly with a lower version than the one a consumer was compiled against -->
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Title>geometry3Sharp</Title>
    <Authors>Ryan Schmidt</Authors>
    <Company>gradientspace</Company>
    <Description>C# library for 2D/3D geometric computing and triangle mesh processing</Description>
    <Copyright>Copyright © Ryan Schmidt 2016</Copyright>
    <PackageLicenseExpression>BSL-1.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/HarmenGrosseDeters/geometry3Sharp</PackageProjectUrl>
    <PackageTags>geometry3;graphics;math;approximation;solvers;color;convexhull;meshes;spatial;curves;solids;3d;unity;ply;3mf;gltf</PackageTags>
    <RepositoryUrl>https://github.com/HarmenGrosseDeters/geometry3Sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- XML docs ship with the package so that IDEs (and coding agents) see the API comments -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573;CS1574;CS1584;CS1570;CS1587;CS1658;CS1734;CS0419;CS1711</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <!-- pack checks the public API against the upstream package 1.0.324 (the fork stays API compatible with it;
         this downloads the baseline package from nuget.org).
         Known, accepted breaks are listed in CompatibilitySuppressions.xml: the dropped net45 target (netstandard2.0
         covers net461+), Util.ParseInt returning int instead of float, and the protected fields Remesher.vModifiedV
         and DMeshAABBTree3.box_centers/box_extents whose types changed -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.324</PackageValidationBaselineVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <RootNamespace>g3</RootNamespace>
    <AssemblyName>geometry3Sharp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Product>geometry3Sharp</Product>
    <!-- -p:G3PredicateStats=true: count the filter failures of the exact predicates (PredicateStats; profiling only) -->
    <DefineConstants Condition="'$(G3PredicateStats)' == 'true'">$(DefineConstants);G3_PREDICATE_STATS</DefineConstants>
    <PackageId>geometry3Sharp</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="tests\**" />
    <Compile Remove="benchmarks\**" />
    <Compile Remove="docs\**" />
    <Compile Remove="tools\**" />
    <!-- optional packages with their own dependencies (addons/*/*.csproj) -->
    <Compile Remove="addons\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="geometry3Sharp.Tests" />
    <!-- profiling of the exact booleans (benchmarks/BooleanComparison profile) -->
    <InternalsVisibleTo Include="BooleanComparison" />
    <InternalsVisibleTo Include="MeshRepairBenchmark" />
    <InternalsVisibleTo Include="ReducerBenchmark" />
    <!-- predicate counts of the self-intersection checks (benchmarks/SelfIntersectionBenchmark) -->
    <InternalsVisibleTo Include="SelfIntersectionBenchmark" />
    <!-- the floor switch of refinement on the grid (benchmarks/Meshing2Benchmark gridcounts) -->
    <InternalsVisibleTo Include="Meshing2Benchmark" />
    <!-- the statistics and the A/B switch of the volume check (benchmarks/MeshRepairBenchmark, BENCH_IOU_CELLS) -->
    <InternalsVisibleTo Include="MeshRepairBenchmark" />
    <!-- the prototypes of the snap-rounding experiment (benchmarks/SnapRoundingExperiment, docs/design/SAFE_ROUNDING.md) -->
    <InternalsVisibleTo Include="SnapRoundingExperiment" />
    <!-- SimplifyWithin of the wrap pipeline (benchmarks/SharpFeatureProbe) -->
    <InternalsVisibleTo Include="SharpFeatureProbe" />
    <!-- the DualContouring diagnostics hook (benchmarks/DualContouringIntersections) -->
    <InternalsVisibleTo Include="DualContouringIntersections" />
    <!-- the exact ray crossings and the partitioned reduction as oracles (tools/MeshFuzzPilot) -->
    <InternalsVisibleTo Include="MeshFuzzPilot" />
  </ItemGroup>

  <!-- banned APIs and analyzers in the exact-arithmetic code (BannedSymbols.txt, G3E0001-3; scoped by .editorconfig;
       build-time only, not a package dependency) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
    <!-- G3E0001-3: float, parallel loops (with the allow-list core/ExactCodeAllowList.cs) and FMA in the exact code -->
    <ProjectReference Include="tools\analyzers\G3ExactCodeAnalyzers\G3ExactCodeAnalyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
