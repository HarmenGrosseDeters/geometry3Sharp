+        /// <summary>
+        /// (probe) the cells Insert(p, hint) would remove, without changing the triangulation (empty if it would fail early)
+        /// </summary>
+        internal void ConflictCells(Vector3d p, int hint, List<int> outCells)
+        {
+            outCells.Clear();
+            uint rngSaved = rng;        // (the walk's random choices stay those of the serial run)
+            int c0 = Locate(p, hint);
+            rng = rngSaved;
+            if (c0 < 0 || InCircumsphere(c0, p) <= 0) return;
+            if (++markValue == int.MaxValue) { Array.Clear(mark, 0, mark.Length); markValue = 1; }
+            outCells.Add(c0); mark[c0] = markValue;
+            for (int k = 0; k < outCells.Count; ++k) {
+                int c = outCells[k];
+                for (int i = 0; i < 4; ++i) {
+                    int n = cn[4 * c + i];
+                    if (n >= 0 && mark[n] != markValue && InCircumsphere(n, p) > 0) { mark[n] = markValue; outCells.Add(n); }
+                }
+            }
+            // (the cavity's boundary neighbours change their adjacency too)
+            int m = outCells.Count;
+            for (int k = 0; k < m; ++k)
+                for (int i = 0; i < 4; ++i) {
+                    int n = cn[4 * outCells[k] + i];
+                    if (n >= 0 && mark[n] != markValue) { mark[n] = markValue; outCells.Add(n); }
+                }
+        }
