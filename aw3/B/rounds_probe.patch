+        // ---- probe (B): serial rounds of gates with pairwise disjoint touched cells ----
+        internal static int RoundWindow = int.Parse(Environment.GetEnvironmentVariable("AW3_ROUNDW") ?? "0");
+        readonly List<(double key, int c, int i, int st)> roundBatch = new List<(double, int, int, int)>(), roundDeferred = new List<(double, int, int, int)>();
+        readonly List<int> roundCavity = new List<int>();
+        readonly List<int> roundSizes = new List<int>();
+        int roundPos = 0, roundMarkValue = 0, roundApplied = 0;
+        int[] roundMark = new int[0];
+        bool round_marked(int c) { return c >= 0 && c < roundMark.Length && roundMark[c] == roundMarkValue; }
+        void round_mark(int c) { if (c < 0) return; if (c >= roundMark.Length) Array.Resize(ref roundMark, Math.Max(c + 1, 2 * roundMark.Length)); roundMark[c] = roundMarkValue; }
+        void defer(double key, int c, int i, int st) { roundDeferred.Add((key, c, i, st)); }
+        bool next_gate(out double key, out int c, out int i, out int st)
+        {
+            if (RoundWindow <= 0) {
+                key = 0; c = i = st = 0;
+                if (gates.Count == 0) return false;
+                gates.Pop(out key, out c, out i, out st);
+                return true;
+            }
+            if (roundPos >= roundBatch.Count) {
+                if (roundBatch.Count > 0) roundSizes.Add(roundApplied);
+                foreach (var g in roundDeferred) gates.Push(g.key, g.c, g.i, g.st);
+                roundDeferred.Clear(); roundBatch.Clear(); roundPos = 0; roundApplied = 0;
+                roundMarkValue++;
+                while (roundBatch.Count < RoundWindow && gates.Count > 0) {
+                    gates.Pop(out double k, out int cc, out int ii, out int ss);
+                    roundBatch.Add((k, cc, ii, ss));
+                }
+                if (roundBatch.Count == 0) { key = 0; c = i = st = 0; return false; }
+            }
+            var x = roundBatch[roundPos++];
+            key = x.key; c = x.c; i = x.i; st = x.st;
+            return true;
+        }
+        void round_report()
+        {
+            if (roundBatch.Count > 0 && roundApplied > 0) roundSizes.Add(roundApplied);
+            var sz = new List<int>(roundSizes); sz.Sort();
+            long total = 0; foreach (int z in roundSizes) total += z;
+            Counts["rounds"] = roundSizes.Count; Counts["round_applied"] = total;
+            if (sz.Count > 0) { Counts["round_p10"] = sz[sz.Count / 10]; Counts["round_p50"] = sz[sz.Count / 2]; Counts["round_max"] = sz[sz.Count - 1]; }
+            foreach (int P in new[] { 4, 16 }) {
+                long steps = 0; foreach (int z in roundSizes) steps += (z + P - 1) / P;
+                Counts["round_ceiling_x100_p" + P] = steps > 0 ? 100 * total / steps : 0;
+            }
+            // the last 10 % of the applied gates: their rounds
+            long acc = 0, lateRounds = 0, lateGates = 0;
+            for (int k = roundSizes.Count - 1; k >= 0 && acc < total / 10; --k) { acc += roundSizes[k]; lateRounds++; lateGates += roundSizes[k]; }
+            Counts["round_late_rounds"] = lateRounds; Counts["round_late_gates"] = lateGates;
+            roundSizes.Clear();
+        }
