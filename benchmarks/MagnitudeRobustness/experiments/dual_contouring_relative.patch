+        // v times the power of two that brings its largest component into [1, 2) (exact): a vector of any magnitude can then be
+        // normalized or compared by sign without underflow or overflow of the squares
+        internal static Vector3d pow2_scaled(Vector3d v)
+        {
+            double m = Math.Max(Math.Abs(v.x), Math.Max(Math.Abs(v.y), Math.Abs(v.z)));
+            if (!(m > 0) || double.IsInfinity(m)) return v;
+            long bits = BitConverter.DoubleToInt64Bits(m);
+            int k = (int)((bits >> 52) & 0x7FF) - 1023;
+            if (k == -1023) { bits = BitConverter.DoubleToInt64Bits(m * 18446744073709551616.0); k = (int)((bits >> 52) & 0x7FF) - 1023 - 64; }
+            return new Vector3d(ExactPoint3.ScaleB(v.x, -k), ExactPoint3.ScaleB(v.y, -k), ExactPoint3.ScaleB(v.z, -k));
+        }
+
+        // the unit vector of a gradient of any magnitude: Vector3d.Normalized where its absolute threshold and the squares allow
+        // (the same bits as before), otherwise the gradient scaled by a power of two first
+        static Vector3d unit_normal(Vector3d g)
+        {
+            double len = g.Length;
+            if (len > MathUtil.Epsilon && !double.IsInfinity(len)) return g.Normalized;
+            Vector3d w = pow2_scaled(g);
+            double wl = w.Length;
+            if (!(wl > 0) || double.IsNaN(wl) || double.IsInfinity(wl)) return Vector3d.Zero;
+            double inv = 1.0 / wl;
+            return new Vector3d(w.x * inv, w.y * inv, w.z * inv);
+        }
