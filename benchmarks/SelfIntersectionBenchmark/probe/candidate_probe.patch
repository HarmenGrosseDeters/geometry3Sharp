+// Distributed under the Boost Software License, Version 1.0. http://www.boost.org/LICENSE_1_0.txt
+// PROBE ONLY (benchmarks/SelfIntersectionBenchmark/probe/candidate_probe.patch): times TriangleTriangleFilter by call
+// site and shared-corner count, and samples its inputs. Never merged into the library.
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+
+namespace g3
+{
+    internal static class TriTriProbe
+    {
+        internal const int Sites = 6;   // 0 other, 1 reducer fan, 2 reducer grid, 3 remesher fan, 4 remesher grid, 5 remesher fold
+        internal static readonly string[] SiteNames = { "other", "reducer new among themselves", "reducer new vs grid", "remesher new among themselves", "remesher vs grid", "remesher fold_count" };
+        [ThreadStatic] internal static int Site;
+        // [site, nShared 0..3, result -1..1 -> 0..2]
+        internal static readonly long[] Calls = new long[Sites * 4 * 3], Ticks = new long[Sites * 4 * 3];
+        internal static long CheckTicks, CheckCalls;    // the whole check (Reducer.collapse_creates_intersection)
+        internal static int Stride = 0;                 // 0: no capture
+        internal static long seen;
+        internal struct Pair { public Index3i ia, ib; public Triangle3d A, B; public int site, shared, result; }
+        internal static readonly List<Pair> Sample = new List<Pair>();
+
+        internal static int Shared(Index3i ia, Index3i ib)
+        {
+            int n = 0;
+            for (int i = 0; i < 3; ++i) for (int j = 0; j < 3; ++j) if (ia[i] == ib[j]) n++;
+            return Math.Min(n, 3);
+        }
+        internal static void Record(Index3i ia, ref Triangle3d A, Index3i ib, ref Triangle3d B, int result, long ticks)
+        {
+            int sh = Shared(ia, ib), k = (Site * 4 + sh) * 3 + result + 1;
+            Calls[k]++; Ticks[k] += ticks;
+            if (Stride > 0 && (seen++ % Stride) == 0)
+                Sample.Add(new Pair { ia = ia, ib = ib, A = A, B = B, site = Site, shared = sh, result = result });
+        }
+        internal static void Reset()
+        {
+            Array.Clear(Calls, 0, Calls.Length); Array.Clear(Ticks, 0, Ticks.Length);
+            CheckTicks = CheckCalls = 0; seen = 0; Sample.Clear();
+        }
+    }
+}
