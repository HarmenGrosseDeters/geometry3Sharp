diff --git a/intersection/TriTriProbe.cs b/intersection/TriTriProbe.cs
new file mode 100644
index 0000000..e4a7356
--- /dev/null
+++ b/intersection/TriTriProbe.cs
@@ -0,0 +1,51 @@
+// Distributed under the Boost Software License, Version 1.0. http://www.boost.org/LICENSE_1_0.txt
+// PROBE ONLY (benchmarks/SelfIntersectionBenchmark/probe/tritri_probe.patch): times the triangle-triangle tests and
+// captures their inputs. Never merged into the library.
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Threading;
+
+namespace g3
+{
+    internal static class TriTriProbe
+    {
+        internal enum Site { BeyondShared, IntersectsTop, IntersectsNested, Filter, ArrSeparated, ArrTouchOnly, Count }
+        internal static readonly string[] Names = { "IntersectsBeyondShared", "Intersects (direct)", "Intersects (in BeyondShared)", "TriangleTriangleFilter.BeyondShared", "arr.separated", "arr.touch_only" };
+        static readonly long[] ticks = new long[16 * (int)Site.Count], calls = new long[16 * (int)Site.Count];
+        [ThreadStatic] static int[] depth;
+        internal static int Cap = 400000;
+        internal static readonly List<Triangle3d> IntersectsPairs = new List<Triangle3d>(), SeparatedPairs = new List<Triangle3d>(), TouchPairs = new List<Triangle3d>();
+        internal static readonly List<Index3i> TouchCorners = new List<Index3i>();
+        internal static bool Capture;
+
+        internal static long Enter(Site s)
+        {
+            if (depth == null) depth = new int[(int)Site.Count];
+            return depth[(int)s]++ == 0 ? Stopwatch.GetTimestamp() : 0;
+        }
+        internal static void Leave(Site s, long t0)
+        {
+            if (--depth[(int)s] == 0) {
+                Interlocked.Add(ref ticks[16 * (int)s], Stopwatch.GetTimestamp() - t0);
+                Interlocked.Increment(ref calls[16 * (int)s]);
+            }
+        }
+        internal static bool InBeyondShared { get { return depth != null && depth[(int)Site.BeyondShared] > 0; } }
+        internal static void Record(List<Triangle3d> list, ref Triangle3d a, ref Triangle3d b)
+        {
+            if (Capture && list.Count < 2 * Cap) lock (list) { list.Add(a); list.Add(b); }
+        }
+        internal static void RecordTouch(ref Triangle3d a, Index3i ca, ref Triangle3d b, Index3i cb)
+        {
+            if (Capture && TouchPairs.Count < 2 * Cap) lock (TouchPairs) { TouchPairs.Add(a); TouchPairs.Add(b); TouchCorners.Add(ca); TouchCorners.Add(cb); }
+        }
+        internal static double Ms(Site s) { return 1000.0 * ticks[16 * (int)s] / Stopwatch.Frequency; }
+        internal static long Calls(Site s) { return calls[16 * (int)s]; }
+        internal static void Reset()
+        {
+            Array.Clear(ticks, 0, ticks.Length); Array.Clear(calls, 0, calls.Length);
+            IntersectsPairs.Clear(); SeparatedPairs.Clear(); TouchPairs.Clear(); TouchCorners.Clear();
+        }
+    }
+}
