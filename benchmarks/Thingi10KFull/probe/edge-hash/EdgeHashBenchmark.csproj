<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>BooleanComparison</AssemblyName>
    <StartupObject>EdgeHashBenchmark</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <HashComparerSource Condition="'$(HashComparerSource)' == ''">..\EdgeKeyComparer.cs</HashComparerSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\sources\benchmarks\BooleanComparison\*.cs" />
    <Compile Include="$(HashComparerSource)" />
    <Compile Include="Program.cs" />
    <Reference Include="geometry3Sharp"><HintPath>$(FrozenLibrary)</HintPath></Reference>
  </ItemGroup>
  <Target Name="ValidateInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(FrozenLibrary)' == '' Or !Exists('$(FrozenLibrary)')" Text="Set FrozenLibrary to the measured geometry3Sharp.dll." />
  </Target>
</Project>
