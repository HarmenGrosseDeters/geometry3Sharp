+        /// <summary>
+        /// PROTOTYPE: Orient with r given as a local exact point (not in the arrangement) and its double approximation
+        /// ra with error re; the same sign as Orient(t, p, q, id) for a point id of the same value
+        /// </summary>
+        [MethodImpl(JitHints.Optimize)]
+        public int Orient(InputTriangle t, int p, int q, ExactPoint3 r, Vector3d ra, double re)
+        {
+            if (p == q)
+                return 0;
+            PredicateStats.Call(PredicateStats.Kind.ArrOrient);
+            int i = (t.Axis + 1) % 3, j = (t.Axis + 2) % 3;
+            if (DisableFilters == false) {
+                double e = Math.Max(approxErr[p], Math.Max(approxErr[q], re));
+                double err;
+                double fdet = orient2d_approx(approx[p], approx[q], ra, i, j, e, out err);
+                if (fdet > err) return t.Sign;
+                if (-fdet > err) return -t.Sign;
+            }
+            PredicateStats.ExactStage(PredicateStats.Kind.ArrOrient);
+            ExactPoint3 a = Exact(p), b = Exact(q);
+            BigInteger det = ExactPoint3.Det3(a[i], a[j], a.W, b[i], b[j], b.W, r[i], r[j], r.W);
+            return det.Sign * t.Sign;
+        }
+
+        /// <summary> PROTOTYPE: the double approximation of a local exact point and its error bound, as AddPoint stores them </summary>
+        public static Vector3d LocalApprox(ExactPoint3 p, out double err)
+        {
+            Vector3d a = p.ApproxVector3d();
+            err = (p.W.IsOne ? 1 : 4) * U * max_abs(a) + Tiny;
+            return a;
+        }
+
         /// <summary> InCircle decided from the approximations only (also with DisableFilters): 0 if they do not decide it </summary>
         [MethodImpl(JitHints.Optimize)]
         internal int InCircleFiltered(InputTriangle t, int p, int q, int r, int s)
