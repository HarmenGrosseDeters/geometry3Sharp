+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.Linq;
+using g3;
+using gs;
+
+// scratch probe (not committed): per model and operation, the rounding under the rule chosen by G3_D1, and a sampled
+// Hausdorff distance between the rounded result without the repair and the repaired one
+static class D1Probe
+{
+    static double Sampled(DMesh3 from, DMesh3 to)
+    {
+        var tree = new DMeshAABBTree3(to, true);
+        double worst = 0;
+        object gate = new object();
+        gParallel.ForEach(from.TriangleIndices(), t => {
+            Index3i tv = from.GetTriangle(t);
+            Vector3d a = from.GetVertex(tv.a), b = from.GetVertex(tv.b), c = from.GetVertex(tv.c);
+            double m = 0;
+            foreach (Vector3d p in new[] { a, b, c, (a + b) / 2, (b + c) / 2, (c + a) / 2, (a + b + c) / 3 }) {
+                int near = tree.FindNearestTriangle(p);
+                var d = new DistPoint3Triangle3(p, new Triangle3d(to.GetVertex(to.GetTriangle(near).a), to.GetVertex(to.GetTriangle(near).b), to.GetVertex(to.GetTriangle(near).c)));
+                d.GetSquared();
+                m = Math.Max(m, p.Distance(d.TriangleClosest));
+            }
+            lock (gate) worst = Math.Max(worst, m);
+        });
+        return worst;
+    }
+
+    public static int Run(string[] files)
+    {
+        var ops = new[] { ("union", ExactMeshBoolean.Operations.Union), ("intersection", ExactMeshBoolean.Operations.Intersection), ("difference", ExactMeshBoolean.Operations.Difference) };
+        foreach (string f in files) {
+            DMesh3 a = Program.Load(f);
+            if (a == null) { Console.WriteLine($"{f} load failed"); continue; }
+            DMesh3 b = new DMesh3(a);
+            AxisAlignedBox3d bounds = a.CachedBounds;
+            MeshTransforms.Rotate(b, bounds.Center, Quaterniond.AxisAngleD(new Vector3d(1, 1, 0).Normalized, 20));
+            MeshTransforms.Translate(b, 0.25 * new Vector3d(bounds.Width, bounds.Height, bounds.Depth));
+            foreach (var (name, o) in ops) {
+                var sw = Stopwatch.StartNew();
+                var op = new ExactMeshBoolean(a, b, o);
+                bool ok = op.Compute();
+                sw.Stop();
+                MeshRoundingRepair r = op.Rounding;
+                string id = System.IO.Path.GetFileNameWithoutExtension(f);
+                if (ok == false || r == null) { Console.WriteLine($"model={id} op={name} ok={ok} error={op.Error}"); continue; }
+                string hd = "";
+                if (Environment.GetEnvironmentVariable("G3_D1_HAUSDORFF") == "1") {
+                    var raw = new ExactMeshBoolean(a, b, o) { SafeRounding = false };
+                    raw.Compute();
+                    double h1 = Sampled(op.Result, raw.Result), h2 = Sampled(raw.Result, op.Result);
+                    hd = FormattableString.Invariant($" sampledH_S_to_S0={h1 / r.MaxLength:F4} sampledH_S0_to_S={h2 / r.MaxLength:F4}");
+                }
+                Console.WriteLine(FormattableString.Invariant($"model={id} op={name} rule={(MeshRoundingRepair.RefRule ? "ref" : "apex")} tris={op.Result.TriangleCount} initDeg={r.InitialDegenerate} remDeg={r.RemainingDegenerate} remInt={r.RemainingIntersections} roundingClean={op.RoundingClean} notClean='{MeshRobustRepair.NotCleanReason(op.Result)}' maxDrift={r.MaxDrift / r.MaxLength:F4} smallestRejected={r.SmallestRejectedDrift / r.MaxLength:F4} collapses={r.Collapses} flips={r.Flips} moves={r.Moves} zips={r.Zips} strips={r.StripZips} removals={r.VertexRemovals} removedComponents={r.RemovedComponents} limit={r.EvaluationLimitReached} refDisp={r.RefDisplacementEdits} refGen={r.RefGenericEdits} ghosts={r.RefGhosts} lost={r.RefLostGhosts} ms={sw.ElapsedMilliseconds}{hd}"));
+            }
+        }
+        return 0;
+    }
+}
