+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using g3;
+using gs;
+using Xunit;
+using Ops = g3.ExactMeshBoolean.Operations;
+
+namespace geometry3Sharp.Tests
+{
+    public class D1ProbeTmp
+    {
+        const double Diagonal = 3.4641016151377544;
+        static DMesh3 DensePatchSphere(double radius, double edge)
+        {
+            var g = new Sphere3Generator_NormalizedCube() { EdgeVertices = 16, Radius = 1 };
+            g.Generate();
+            DMesh3 m = g.MakeDMesh();
+            Vector3d p = new Vector3d(-1, -1, -1).Normalized;
+            for (int pass = 0; pass < 200; ++pass) {
+                var split = new List<(int e, double len)>();
+                foreach (int e in m.EdgeIndices()) {
+                    Index2i ev = m.GetEdgeV(e);
+                    Vector3d a = m.GetVertex(ev.a), b = m.GetVertex(ev.b);
+                    double len = a.Distance(b);
+                    if (len > edge && ((a + b) * 0.5).Distance(p) < radius + len)
+                        split.Add((e, len));
+                }
+                if (split.Count == 0)
+                    break;
+                foreach (var (e, _) in split.OrderByDescending(x => x.len).ThenBy(x => x.e)) {
+                    if (!m.IsEdge(e))
+                        continue;
+                    Index2i ev = m.GetEdgeV(e);
+                    if (m.GetVertex(ev.a).Distance(m.GetVertex(ev.b)) <= edge)
+                        continue;
+                    if (m.SplitEdge(e, out DMesh3.EdgeSplitInfo s) == MeshResult.Ok)
+                        m.SetVertex(s.vNew, m.GetVertex(s.vNew).Normalized);
+                }
+            }
+            return m;
+        }
+
+        [Fact]
+        public void Probe()
+        {
+            string outPath = Environment.GetEnvironmentVariable("G3_D1_OUT");
+            var lines = new List<string>();
+            foreach (double rad in new[] { 1e-5, 3e-5, 1e-4, 2e-4 })
+                foreach (double edge in new[] { 3.3e-6, 1.5e-6 }) {
+                    DMesh3 a = DensePatchSphere(rad * Diagonal, edge * Diagonal);
+                    DMesh3 b = new DMesh3(a);
+                    AxisAlignedBox3d box = a.CachedBounds;
+                    MeshTransforms.Rotate(b, box.Center, Quaterniond.AxisAngleD(new Vector3d(1, 1, 0).Normalized, 20));
+                    MeshTransforms.Translate(b, 0.25 * new Vector3d(box.Width, box.Height, box.Depth));
+                    var sw = Stopwatch.StartNew();
+                    var op = new ExactMeshBoolean(a, b, Ops.Union);
+                    bool ok = op.Compute();
+                    sw.Stop();
+                    MeshRoundingRepair r = op.Rounding;
+                    lines.Add(FormattableString.Invariant($"rule={(MeshRoundingRepair.RefRule ? "ref" : "apex")} rad={rad} edge={edge} tris={a.TriangleCount} ok={ok} initDeg={r.InitialDegenerate} remDeg={r.RemainingDegenerate} remInt={r.RemainingIntersections} clean={op.RoundingClean} maxDrift={r.MaxDrift / r.MaxLength:F4} smallestRejected={r.SmallestRejectedDrift / r.MaxLength:F4} collapses={r.Collapses} flips={r.Flips} moves={r.Moves} zips={r.Zips} strips={r.StripZips} removals={r.VertexRemovals} limit={r.EvaluationLimitReached} refDisp={r.RefDisplacementEdits} refGen={r.RefGenericEdits} ghosts={r.RefGhosts} lost={r.RefLostGhosts} notClean='{MeshRobustRepair.NotCleanReason(op.Result)}' ms={sw.ElapsedMilliseconds}"));
+                }
+            File.AppendAllLines(outPath, lines);
+        }
+
+        static double Sampled(DMesh3 from, DMesh3 to)
+        {
+            var tree = new DMeshAABBTree3(to, true);
+            double worst = 0;
+            foreach (int t in from.TriangleIndices()) {
+                Index3i tv = from.GetTriangle(t);
+                Vector3d a = from.GetVertex(tv.a), b = from.GetVertex(tv.b), c = from.GetVertex(tv.c);
+                foreach (Vector3d p in new[] { a, b, c, (a + b) / 2, (b + c) / 2, (c + a) / 2, (a + b + c) / 3 }) {
+                    int near = tree.FindNearestTriangle(p);
+                    Index3i nv = to.GetTriangle(near);
+                    var d = new DistPoint3Triangle3(p, new Triangle3d(to.GetVertex(nv.a), to.GetVertex(nv.b), to.GetVertex(nv.c)));
+                    d.GetSquared();
+                    worst = Math.Max(worst, p.Distance(d.TriangleClosest));
+                }
+            }
+            return worst;
+        }
+
+        [Fact]
+        public void Probe2()
+        {
+            string outPath = Environment.GetEnvironmentVariable("G3_D1_OUT");
+            var lines = new List<string>();
+            foreach (double rad in new[] { 5e-6, 1e-5, 2e-5 })
+                foreach (double edge in new[] { 2.5e-6, 2e-6, 1.5e-6 })
+                    foreach (double md in new[] { 1e-5, 4e-5 }) {
+                    DMesh3 start = DensePatchSphere(rad * Diagonal, edge * Diagonal), m = new DMesh3(start);
+                    var sw = Stopwatch.StartNew();
+                    var r = new MeshRoundingRepair(m) { MaxDisplacement = md };
+                    r.Apply();
+                    sw.Stop();
+                    double h1 = Sampled(m, start), h2 = Sampled(start, m);
+                    double L = 1e-5 * Diagonal;
+                    lines.Add(FormattableString.Invariant($"direct rule={(MeshRoundingRepair.RefRule ? "ref" : "apex")} rad={rad} edge={edge} md={md} tris={start.TriangleCount} initDeg={r.InitialDegenerate} remDeg={r.RemainingDegenerate} clean={r.IsClean} maxDrift/L={r.MaxDrift / L:F4} rej/L={r.SmallestRejectedDrift / L:F4} H/L={h1 / L:F4},{h2 / L:F4} collapses={r.Collapses} flips={r.Flips} moves={r.Moves} zips={r.Zips} limit={r.EvaluationLimitReached} ms={sw.ElapsedMilliseconds}"));
+                }
+            File.AppendAllLines(outPath, lines);
+        }
+    }
+}
