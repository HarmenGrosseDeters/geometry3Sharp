diff --git a/core/PairProbe.cs b/core/PairProbe.cs
new file mode 100644
index 00000000..be7ace7d
--- /dev/null
+++ b/core/PairProbe.cs
@@ -0,0 +1,122 @@
+// PROBE (perf/pair_probe.patch, never part of the library): counts and times the candidate pairs of the boolean's pair stage
+// (intersections.pairs: the self-join of each operand with touch_only, the pairs of the two operands with separated) and the
+// outcome of intersect() on the pairs that stay. G3_PAIR_PROBE=1: counters and the time of the sub-steps of the self-join
+// tasks (a few timestamps per task); =2: also a timestamp per pair (about 20 ns each; the overhead is stated in the report).
+// Results go into PhaseMilliseconds as "pairs.<class>_n" (count) and "pairs.<class>_us" (CPU microseconds summed over threads).
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+
+namespace g3
+{
+    internal static class PairProbe
+    {
+        public static readonly int Mode = int.TryParse(Environment.GetEnvironmentVariable("G3_PAIR_PROBE"), out int m) ? m : 0;
+        /// <summary> G3_PROBE_SERIAL=1: every parallel loop of the boolean runs serially on the calling thread (gParallel.SerialOnThisThread), so that the per-thread wall intervals of a 1-thread run are CPU time (on one core a second pool thread would be counted into every interval) </summary>
+        public static readonly bool SerialMain = Environment.GetEnvironmentVariable("G3_PROBE_SERIAL") == "1";
+        public static readonly bool On = Mode > 0, PerPair = Mode > 1, Filter = Mode > 2;
+
+        // decision points of touch_only (set by the code there), and the outcome classes
+        public const int DecDegenerate = 0, DecQuick1 = 1, DecQuick2 = 2, DecCoplanarRej = 3, DecCoplanarKept = 4, DecGeneralRej = 5, DecGeneralKept = 6, DecFilterReject = 7, DecFilterKept = 8, NDec = 9;
+        public static readonly string[] DecNames = { "degenerate", "quick1_reject", "quick2_reject", "coplanar_reject", "coplanar_kept", "general_reject", "general_kept", "filter_reject", "filter_kept" };
+        // intersect() outcomes
+        public const int OutSideT = 0, OutSideU = 1, OutCoplanar = 2, OutPrefilter = 3, OutApart = 4, OutMeet = 5, NOut = 6;
+        public static readonly string[] OutNames = { "side_t", "side_u", "coplanar", "prefilter_apart", "construct_apart", "meeting", };
+
+        [ThreadStatic] public static int Decision, Shared, Outcome;
+
+        public sealed class Acc
+        {
+            public long[] selfN = new long[4 * NDec], selfTicks = new long[4 * NDec];     // [shared][decision]
+            public long[] mpN = new long[3], mpTicks = new long[3];                       // separated: skipped (degenerate / culled), rejected, kept
+            public long[] outN = new long[NOut], outTicks = new long[NOut];
+            public long selfTaskTicks, selfTraverseTicks, selfTestTicks, selfBoxPairs, selfTasks;
+            public long mpQueryTicks, mpQueries, mpHits, mpTicksAll;
+            public long intersectTicks;
+            // mode 3: TriangleTriangleFilter.BeyondShared tried on the pairs that touch_only rejected by IntersectsBeyondShared(Coplanar):
+            // [shared][result: 0 Separate, 1 Intersecting (a contradiction), 2 Undecided]; time of the filter and of the exact test it would save
+            public long[] fN = new long[12], fTicks = new long[12], fOrigTicks = new long[12];
+            public void Clear()
+            {
+                Array.Clear(selfN, 0, selfN.Length); Array.Clear(selfTicks, 0, selfTicks.Length);
+                Array.Clear(mpN, 0, 3); Array.Clear(mpTicks, 0, 3);
+                Array.Clear(outN, 0, NOut); Array.Clear(outTicks, 0, NOut);
+                selfTaskTicks = selfTraverseTicks = selfTestTicks = selfBoxPairs = selfTasks = 0;
+                mpQueryTicks = mpQueries = mpHits = mpTicksAll = 0;
+                intersectTicks = 0;
+                Array.Clear(fN, 0, 12); Array.Clear(fTicks, 0, 12); Array.Clear(fOrigTicks, 0, 12);
+            }
+        }
+        static readonly List<Acc> all = new List<Acc>();
+        [ThreadStatic] static Acc tl;
+        public static Acc A
+        {
+            get {
+                Acc a = tl;
+                if (a == null) {
+                    a = new Acc();
+                    lock (all) all.Add(a);
+                    tl = a;
+                }
+                return a;
+            }
+        }
+        public static void EnterSerialIfAsked() { if (SerialMain) gParallel.SerialOnThisThread = true; }
+        public static long T() { return Stopwatch.GetTimestamp(); }
+        static long Us(long ticks) { return ticks * 1000000 / Stopwatch.Frequency; }
+
+        public static void Reset()
+        {
+            lock (all) foreach (Acc a in all) a.Clear();
+        }
+
+        public static void Snapshot(Dictionary<string, long> into)
+        {
+            if (On == false) return;
+            var s = new Acc();
+            lock (all)
+                foreach (Acc a in all) {
+                    for (int i = 0; i < s.selfN.Length; ++i) { s.selfN[i] += a.selfN[i]; s.selfTicks[i] += a.selfTicks[i]; }
+                    for (int i = 0; i < 3; ++i) { s.mpN[i] += a.mpN[i]; s.mpTicks[i] += a.mpTicks[i]; }
+                    for (int i = 0; i < NOut; ++i) { s.outN[i] += a.outN[i]; s.outTicks[i] += a.outTicks[i]; }
+                    s.selfTaskTicks += a.selfTaskTicks; s.selfTraverseTicks += a.selfTraverseTicks; s.selfTestTicks += a.selfTestTicks;
+                    s.selfBoxPairs += a.selfBoxPairs; s.selfTasks += a.selfTasks;
+                    s.mpQueryTicks += a.mpQueryTicks; s.mpQueries += a.mpQueries; s.mpHits += a.mpHits; s.mpTicksAll += a.mpTicksAll;
+                    s.intersectTicks += a.intersectTicks;
+                    for (int i = 0; i < 12; ++i) { s.fN[i] += a.fN[i]; s.fTicks[i] += a.fTicks[i]; s.fOrigTicks[i] += a.fOrigTicks[i]; }
+                }
+            for (int sh = 0; sh < 4; ++sh)
+                for (int d = 0; d < NDec; ++d) {
+                    into["pairs.self.s" + sh + "." + DecNames[d] + "_n"] = s.selfN[sh * NDec + d];
+                    if (PerPair) into["pairs.self.s" + sh + "." + DecNames[d] + "_us"] = Us(s.selfTicks[sh * NDec + d]);
+                }
+            into["pairs.self.tasks_n"] = s.selfTasks;
+            into["pairs.self.box_pairs_n"] = s.selfBoxPairs;
+            into["pairs.self.task_us"] = Us(s.selfTaskTicks);
+            into["pairs.self.traverse_us"] = Us(s.selfTraverseTicks);
+            into["pairs.self.test_loop_us"] = Us(s.selfTestTicks);
+            string[] mp = { "skipped", "separated", "kept" };
+            for (int i = 0; i < 3; ++i) {
+                into["pairs.mesh." + mp[i] + "_n"] = s.mpN[i];
+                if (PerPair) into["pairs.mesh." + mp[i] + "_us"] = Us(s.mpTicks[i]);
+            }
+            into["pairs.mesh.queries_n"] = s.mpQueries;
+            into["pairs.mesh.query_us"] = Us(s.mpQueryTicks);
+            into["pairs.mesh.all_us"] = Us(s.mpTicksAll);
+            for (int i = 0; i < NOut; ++i) {
+                into["pairs.intersect." + OutNames[i] + "_n"] = s.outN[i];
+                if (PerPair) into["pairs.intersect." + OutNames[i] + "_us"] = Us(s.outTicks[i]);
+            }
+            into["pairs.intersect.all_us"] = Us(s.intersectTicks);
+            if (Filter) {
+                string[] fr = { "separate", "intersecting", "undecided" };
+                for (int sh = 0; sh < 4; ++sh)
+                    for (int r = 0; r < 3; ++r) {
+                        into["pairs.filter.s" + sh + "." + fr[r] + "_n"] = s.fN[sh * 3 + r];
+                        into["pairs.filter.s" + sh + "." + fr[r] + "_us"] = Us(s.fTicks[sh * 3 + r]);
+                        into["pairs.filter.s" + sh + "." + fr[r] + "_exact_us"] = Us(s.fOrigTicks[sh * 3 + r]);
+                    }
+            }
+        }
+    }
+}
