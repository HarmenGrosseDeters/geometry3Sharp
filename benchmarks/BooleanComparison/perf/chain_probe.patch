index 00000000..8496e680
--- /dev/null
+++ b/core/ChainProbe.cs
@@ -0,0 +1,128 @@
+// PROBE (benchmarks/BooleanComparison/perf/chain_probe.patch, never part of the library): counters and times of the
+// boolean's pair stage and triangulation for chained booleans (task of 2026-11-19: step 3 of the ABC chains, and the
+// self-join of the operands, EMBER lever 2). Environment, read at the start of every ExactMeshArrangement.Compute:
+//   G3_CP_MODE=1      counters, and the wall time of each operand's self-join (a few timestamps per boolean)
+//   G3_CP_MODE=2      also a timestamp pair per intersect() call, per prepare_touched and per triangulate_touched call
+//   G3_CP_SKIPSELF=m  bit mask of the arrangement's mesh indices whose self-join is skipped (the experiment of lever 2: only
+//                     valid where the operand has no self-intersections, then the result is the same)
+//   G3_CP_SKIPTRIVIAL=1  experiment: a coplanar pair whose clipped segments and points are all corners of the triangle they
+//                     are added to (identical or edge-sharing coplanar triangles) adds nothing (the pair is still recorded
+//                     as coplanar partners)
+//   G3_PROBE_SERIAL=1 every parallel loop runs serially on the calling thread (per-thread intervals are CPU time)
+// Values go into PhaseMilliseconds as "probe.<name>" (counts) and "probe.<name>_us" (microseconds, summed over threads).
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+
+namespace g3
+{
+    internal static class ChainProbe
+    {
+        public static int Mode;
+        public static long SkipSelf;
+        public static bool SkipTrivial, FastTrivial, FastCheck;
+        public static bool Serial;
+        public static bool On { get { return Mode > 0; } }
+        public static bool Timed { get { return Mode > 1; } }
+
+        public static void Refresh()
+        {
+            Mode = int.TryParse(Environment.GetEnvironmentVariable("G3_CP_MODE"), out int m) ? m : 0;
+            SkipSelf = long.TryParse(Environment.GetEnvironmentVariable("G3_CP_SKIPSELF"), out long s) ? s : 0;
+            SkipTrivial = Environment.GetEnvironmentVariable("G3_CP_SKIPTRIVIAL") == "1";
+            FastTrivial = Environment.GetEnvironmentVariable("G3_CP_FASTTRIVIAL") == "1";
+            FastCheck = Environment.GetEnvironmentVariable("G3_CP_FASTCHECK") == "1";
+            Serial = Environment.GetEnvironmentVariable("G3_PROBE_SERIAL") == "1";
+            if (Serial) {
+                gParallel.SerialOnThisThread = true;
+                setSerial = true;
+            } else if (setSerial) {
+                gParallel.SerialOnThisThread = false;
+                setSerial = false;
+            }
+        }
+        static bool setSerial;
+
+        // classes of intersect(): where each candidate pair ends
+        public const int SepT = 0, SepU = 1, Coplanar = 2, PrefilterApart = 3, ConstructApart = 4, MeetPoint = 5, MeetSegment = 6, NCls = 7;
+        public static readonly string[] ClsNames = { "sep_t", "sep_u", "coplanar", "prefilter_apart", "construct_apart", "meet_point", "meet_segment" };
+        // coplanar pairs by the corners they share (by point id; input points are welded by position) and by what they add
+        public const int ShareNone = 0, ShareVertex = 1, ShareEdge = 2, ShareAll = 3;
+        public static readonly string[] ShareNames = { "share0", "share1", "share2", "share3" };
+        // tri[0] = no clip result, tri[1] = all clip results trivial (corners / edges between two corners), tri[2] = other
+        public static readonly string[] TriNames = { "empty", "trivial", "adds" };
+
+        [ThreadStatic] public static int Cls, CoShare, CoTri;
+        [ThreadStatic] public static bool ClipNontrivial;
+
+        public sealed class Acc
+        {
+            public long[] n = new long[NCls], ticks = new long[NCls];
+            public long[,] co_n = new long[4, 3], co_ticks = new long[4, 3];       // [shared corners][tri]
+            public long prepN, prepTrivialN, prepTicks, prepTrivialTicks;
+            public long triN, triTrivialN, triTicks, triTrivialTicks;
+            public long skippedTrivial, fastDecided, fastAgree, fastMismatch, fastMissed;
+            public void Clear()
+            {
+                Array.Clear(n, 0, n.Length); Array.Clear(ticks, 0, ticks.Length);
+                Array.Clear(co_n, 0, co_n.Length); Array.Clear(co_ticks, 0, co_ticks.Length);
+                prepN = prepTrivialN = prepTicks = prepTrivialTicks = 0;
+                triN = triTrivialN = triTicks = triTrivialTicks = 0;
+                skippedTrivial = 0; fastDecided = fastAgree = fastMismatch = fastMissed = 0;
+            }
+        }
+        static readonly List<Acc> all = new List<Acc>();
+        [ThreadStatic] static Acc tl;
+        public static Acc A
+        {
+            get {
+                Acc a = tl;
+                if (a == null) {
+                    a = new Acc();
+                    lock (all) all.Add(a);
+                    tl = a;
+                }
+                return a;
+            }
+        }
+        public static long T() { return Stopwatch.GetTimestamp(); }
+        static long Us(long ticks) { return ticks * 1000000 / Stopwatch.Frequency; }
+
+        public static void Reset()
+        {
+            lock (all) foreach (Acc a in all) a.Clear();
+        }
+
+        public static void Snapshot(Dictionary<string, long> into)
+        {
+            var n = new long[NCls]; var t = new long[NCls];
+            var cn = new long[4, 3]; var ct = new long[4, 3];
+            long prepN = 0, prepTN = 0, prepT = 0, prepTT = 0, triN = 0, triTN = 0, triT = 0, triTT = 0, skipped = 0, fd = 0, fa = 0, fm = 0, fx = 0;
+            lock (all)
+                foreach (Acc a in all) {
+                    for (int k = 0; k < NCls; ++k) { n[k] += a.n[k]; t[k] += a.ticks[k]; }
+                    for (int i = 0; i < 4; ++i) for (int j = 0; j < 3; ++j) { cn[i, j] += a.co_n[i, j]; ct[i, j] += a.co_ticks[i, j]; }
+                    prepN += a.prepN; prepTN += a.prepTrivialN; prepT += a.prepTicks; prepTT += a.prepTrivialTicks;
+                    triN += a.triN; triTN += a.triTrivialN; triT += a.triTicks; triTT += a.triTrivialTicks;
+                    skipped += a.skippedTrivial; fd += a.fastDecided; fa += a.fastAgree; fm += a.fastMismatch; fx += a.fastMissed;
+                }
+            for (int k = 0; k < NCls; ++k) {
+                into["probe.i_" + ClsNames[k]] = n[k];
+                if (Timed) into["probe.i_" + ClsNames[k] + "_us"] = Us(t[k]);
+            }
+            for (int i = 0; i < 4; ++i)
+                for (int j = 0; j < 3; ++j) {
+                    into["probe.co_" + ShareNames[i] + "_" + TriNames[j]] = cn[i, j];
+                    if (Timed) into["probe.co_" + ShareNames[i] + "_" + TriNames[j] + "_us"] = Us(ct[i, j]);
+                }
+            into["probe.prep"] = prepN; into["probe.prep_trivial"] = prepTN;
+            into["probe.tri"] = triN; into["probe.tri_trivial"] = triTN;
+            into["probe.skipped_trivial"] = skipped;
+            into["probe.fast_decided"] = fd; into["probe.fast_agree"] = fa; into["probe.fast_mismatch"] = fm; into["probe.fast_missed"] = fx;
+            if (Timed) {
+                into["probe.prep_us"] = Us(prepT); into["probe.prep_trivial_us"] = Us(prepTT);
+                into["probe.tri_us"] = Us(triT); into["probe.tri_trivial_us"] = Us(triTT);
+            }
+        }
+    }
+}
