diff --git a/g3probe/core/SerialProbe.cs b/core/SerialProbe.cs
new file mode 100644
index 0000000..bc6a288
--- /dev/null
+++ b/core/SerialProbe.cs
@@ -0,0 +1,116 @@
+// PROBE (unmerged branch, never part of the library): inclusive wall-clock scopes of the serial sub-steps of the boolean and
+// of SafeRounding, switched on by the environment variable G3_SERIAL_PROBE=1, read by BooleanComparison profile (field
+// "probe"). Changes no result: only Stopwatch reads and counters. A scope is inclusive of the scopes nested in it; "par"
+// scopes record the wall time of a parallel loop and the sum of the CPU time of its bodies.
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Threading;
+
+namespace g3
+{
+    internal static class SerialProbe
+    {
+        public static readonly bool On = Environment.GetEnvironmentVariable("G3_SERIAL_PROBE") == "1";
+        static readonly Dictionary<string, int> index = new Dictionary<string, int>();
+        static readonly List<string> names = new List<string>();
+        const int Max = 256;
+        static readonly long[] ticks = new long[Max];
+        static readonly long[] calls = new long[Max];
+        static readonly long[] cpu = new long[Max];
+
+        // registered once per name (static fields of the callers)
+        public static int Id(string name)
+        {
+            lock (index) {
+                int id;
+                if (index.TryGetValue(name, out id))
+                    return id;
+                id = names.Count;
+                index[name] = id;
+                names.Add(name);
+                return id;
+            }
+        }
+
+
+        // a parallel region by call site, labelled by the first phase lap that follows it
+        public static int RegionId(string file, int line)
+        {
+            string f = file == null ? "?" : file.Substring(file.LastIndexOfAny(new[] { '/', '\\' }) + 1);
+            int id = Id("par:" + f + ":" + line);
+            lock (index) {
+                if (openRegions.Contains(id) == false)
+                    openRegions.Add(id);
+            }
+            return id;
+        }
+        static readonly List<int> openRegions = new List<int>();
+        static readonly Dictionary<string, string> phaseOf = new Dictionary<string, string>();
+
+        // PhaseClock.Lap: the regions run since the last lap belong to this phase
+        public static void Lap(string phase)
+        {
+            if (On == false) return;
+            lock (index) {
+                foreach (int id in openRegions)
+                    phaseOf[names[id]] = phase;
+                openRegions.Clear();
+            }
+        }
+
+        public static string PhaseOf(string name) { lock (index) { string p; return phaseOf.TryGetValue(name, out p) ? p : null; } }
+
+        // sequential stages: Mark(name) adds the time since the previous Mark (or MarkStart) of this process to name
+        static long lastMark;
+        public static void MarkStart() { if (On) lastMark = Stopwatch.GetTimestamp(); }
+        public static void Mark(string name)
+        {
+            if (On == false) return;
+            long now = Stopwatch.GetTimestamp();
+            int id = Id(name);
+            Interlocked.Add(ref ticks[id], now - lastMark);
+            Interlocked.Increment(ref calls[id]);
+            lastMark = now;
+        }
+
+        public static long T() { return On ? Stopwatch.GetTimestamp() : 0; }
+
+        public static void E(int id, long t0)
+        {
+            if (On == false) return;
+            Interlocked.Add(ref ticks[id], Stopwatch.GetTimestamp() - t0);
+            Interlocked.Increment(ref calls[id]);
+        }
+
+        // CPU time of one body of a parallel loop
+        public static void Body(int id, long t0)
+        {
+            if (On == false) return;
+            Interlocked.Add(ref cpu[id], Stopwatch.GetTimestamp() - t0);
+        }
+
+        public static void Count(int id, long n = 1)
+        {
+            if (On == false) return;
+            Interlocked.Add(ref calls[id], n);
+        }
+
+        public static void Reset()
+        {
+            Array.Clear(ticks, 0, Max); Array.Clear(calls, 0, Max); Array.Clear(cpu, 0, Max);
+        }
+
+        // name -> [wall ms, calls, cpu ms]
+        public static Dictionary<string, double[]> Snapshot()
+        {
+            var d = new Dictionary<string, double[]>();
+            double ms = 1000.0 / Stopwatch.Frequency;
+            lock (index)
+                for (int i = 0; i < names.Count; ++i)
+                    if (calls[i] != 0 || ticks[i] != 0)
+                        d[names[i]] = new double[] { ticks[i] * ms, calls[i], cpu[i] * ms };
+            return d;
+        }
+    }
+}
