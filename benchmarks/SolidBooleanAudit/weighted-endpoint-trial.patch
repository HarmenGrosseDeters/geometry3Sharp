+        long weighted_budget_trial()
+        {
+            var clock = new PhaseClock(PhaseMilliseconds, PhaseAllocatedBytes);
+            long remaining = MaxPieces;
+            for (int ti = 0; ti < Triangles.Count && remaining >= 0; ++ti) {
+                if ((ti & 127) == 0 && cancelled())
+                    return 0;
+                InputTriangle t = Triangles[ti];
+                if (!Culled[ti] && !t.Degenerate && triangulated(t))
+                    remaining -= 1L + 2L * (t.Points.Count + 2L * t.Segments.Count);
+            }
+            clock.Lap("weighted.raw");
+            if (remaining >= 0 || cancelled())
+                return 0;
+
+            long lower = 0;
+            var points = new List<int>();
+            var spans = new List<(int Source, int End)>();
+            for (int ti = 0; ti < Triangles.Count; ++ti) {
+                if ((ti & 127) == 0 && cancelled())
+                    return 0;
+                InputTriangle t = Triangles[ti];
+                if (Culled[ti] || t.Degenerate || !triangulated(t))
+                    continue;
+                lower++;
+                if (t.Points.Count != 0 || t.Segments.Count != 0) {
+                    HashSet<int> known = canonical_touched_points(t, true);
+                    if (known == null)
+                        return 0;
+                    int scanned = 0;
+                    foreach (Segment s in t.Segments) {
+                        if ((++scanned & 1023) == 0 && cancelled())
+                            return 0;
+                        known.Add(Canonical(s.P));
+                        known.Add(Canonical(s.Q));
+                    }
+                    for (int k = 0; k < 3; ++k)
+                        known.Remove(Canonical(t.Corners[k]));
+                    lower += known.Count;
+                    if (lower <= MaxPieces && known.Count != 0) {
+                        points.AddRange(known);
+                        spans.Add((ti, points.Count));
+                    }
+                }
+                if (lower > MaxPieces)
+                    break;
+            }
+            clock.Lap("weighted.count");
+            if (lower > MaxPieces)
+                return lower;
+            if (cancelled() || lower + points.Count <= MaxPieces)
+                return 0;
+
+            int start = 0;
+            foreach (var span in spans) {
+                InputTriangle t = Triangles[span.Source];
+                for (int i = start; i < span.End; ++i) {
+                    if ((i & 1023) == 0 && cancelled())
+                        return 0;
+                    bool boundary = false;
+                    for (int k = 0; k < 3 && !boundary; ++k)
+                        boundary = Orient(t, t.Corners[k], t.Corners[(k + 1) % 3], points[i]) == 0;
+                    if (!boundary)
+                        lower++;
+                }
+                start = span.End;
+                if (lower > MaxPieces || lower + (points.Count - start) <= MaxPieces)
+                    break;
+            }
+            clock.Lap("weighted.classify");
+            return lower > MaxPieces ? lower : 0;
