<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- -p:G3Before=true builds only the default-path mode, against a library without BooleanVolumeGradient (the "before" tree) -->
    <DefineConstants Condition="'$(G3Before)' == 'true'">$(DefineConstants);G3_BEFORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../geometry3Sharp_netstandard.csproj" /></ItemGroup>
</Project>
