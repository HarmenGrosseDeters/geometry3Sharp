<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <RootNamespace>Meshing2Acceptance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Oracle\**" />
    <EmbeddedResource Remove="Oracle\**" />
    <None Remove="Oracle\**" />
    <ProjectReference Include="Oracle\Meshing2Oracle.csproj" />
    <ProjectReference Include="..\..\geometry3Sharp_netstandard.csproj" />
    <!-- BSD-3-Clause, the reference of the M1 differential; this benchmark only, never a dependency of the library -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
