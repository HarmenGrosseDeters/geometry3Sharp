<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\geometry3Sharp_netstandard.csproj" />
  </ItemGroup>

  <!-- optional: compare with Triangle.NET's RobustPredicates, eg
       dotnet run -c Release -p:TriangleNetProject=/path/to/triangle.net/src/Triangle/Triangle.csproj -->
  <ItemGroup Condition="'$(TriangleNetProject)' != ''">
    <ProjectReference Include="$(TriangleNetProject)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TriangleNetProject)' != ''">
    <DefineConstants>$(DefineConstants);TRIANGLENET</DefineConstants>
  </PropertyGroup>

</Project>
