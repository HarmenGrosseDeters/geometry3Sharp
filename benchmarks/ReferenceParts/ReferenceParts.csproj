<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RootNamespace>ReferenceParts</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\geometry3Sharp_netstandard.csproj" />
  </ItemGroup>
  <!-- the parts, checks and chains are shared with the tests (tests/geometry3Sharp.Tests/ReferenceParts): one definition -->
  <ItemGroup>
    <Compile Include="..\..\tests\geometry3Sharp.Tests\ReferenceParts\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
