<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(BenchNet48)' != 'true'">net10.0</TargetFramework>
    <!-- -p:BenchNet48=true adds net48 (the netstandard2.0 build of the library), see benchmarks/net48-compare/README.md -->
    <TargetFrameworks Condition="'$(BenchNet48)' == 'true'">net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\geometry3Sharp_netstandard.csproj" />
  </ItemGroup>
  <Import Project="..\net48-compare\Net48.props" />
</Project>
