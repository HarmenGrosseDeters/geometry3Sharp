<Project Sdk="Microsoft.NET.Sdk">

  <!-- Roslyn analyzers for the exact-arithmetic code of geometry3Sharp (build-time only, not shipped). The rules are
       enabled per file by the .editorconfig at the repository root. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <Nullable>disable</Nullable>
    <!-- RS2008: release tracking is for shipped analyzers; this one is internal -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.8 (VS 2022 17.8, .NET 8 SDK) or newer can load the analyzer -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
