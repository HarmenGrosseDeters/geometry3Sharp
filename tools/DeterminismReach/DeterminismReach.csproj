<Project Sdk="Microsoft.NET.Sdk">
  <!-- Static reachability of the sources of cross-runtime differences from the public operations
       (docs/research/DETERMINISM_CROSS_RUNTIME_2026-11.md). Reads the compiled library; a tool, not part of the package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SelfTest.cs" />
    <!-- Mono.Cecil: MIT -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
